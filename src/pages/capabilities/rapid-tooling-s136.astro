---
/**
 * src/pages/capabilities/rapid-tooling-s136.astro
 * 👑 NEXMOLD S136 / NAK80 快速开模与 T1 极速样板加工页 (Capabilities 核心节点)
 * 1. 架构定位：展示 NEXMOLD 7-14 天 T1 交付、S136 镜面不锈钢/NAK80 模具钢材规范
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：Quick Answer, Steel Grade Specification Table, JSON-LD Schema
 */

import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import EcosystemFooter from '../../components/EcosystemFooter.astro';
import LeadModal from '../../components/LeadModal.astro';

const title = "Rapid Steel Tooling & S136 Fast-Track Injection Molds | NEXMOLD";
const description = "Custom rapid steel tooling using ASSAB S136 and NAK80 mold steels. Get T1 molded prototype samples in 7 to 14 calendar days with guaranteed ISO 2768-m accuracy.";

// GEO JSON-LD Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Rapid Steel Tooling and S136 Fast-Track Injection Mold Manufacturing Standards",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "NEXMOLD Precision Manufacturing"
  }
};
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/capabilities" class="hover:text-[#EA580C] transition-colors">Capabilities</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Rapid S136 Steel Tooling</span>
      </nav>

      <!-- 👑 GEO Quick Answer 核心框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          TOOLING_CAPABILITIES // FAST_TRACK_STEEL_MOLDS
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Rapid Steel Tooling &<br/>
          <span class="text-[#EA580C]">S136 Mirror Stainless Molds</span>
        </h1>
        <!-- Featured Snippet Summary -->
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Rapid steel tooling bridges the gap between prototype 3D printing and full mass-production tooling. By utilizing pre-hardened <strong>NAK80</strong> or hardened <strong>ASSAB S136 stainless steel (HRC 48–52)</strong> inside standardized master mold frames, NEXMOLD delivers fully functional, production-grade <strong>T1 molded parts in 7 to 14 calendar days</strong> at a fraction of traditional SPI Class 101 NRE mold costs.
        </p>
      </section>

      <!-- 核心技术参数与流程卡片 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
        
        <!-- 左侧：模具规格与指标 -->
        <div class="lg:col-span-7 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Rapid Tooling Technical Parameters
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 font-mono text-xs">
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">T1 Lead Time</span>
              <strong class="text-sm font-black text-[#EA580C]">7 - 14 Calendar Days</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Core / Cavity Steel</span>
              <strong class="text-sm font-black text-[#0F2B5B]">ASSAB S136 / NAK80</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Steel Hardness</span>
              <strong class="text-sm font-black text-[#0F2B5B]">HRC 48 - 52 Hardened</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Mold Life Guarantee</span>
              <strong class="text-sm font-black text-[#0F2B5B]">50,000 - 1,000,000+ Shots</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Surface Polish</span>
              <strong class="text-sm font-black text-[#0F2B5B]">SPI-A2 Mirror / VDI 24</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Tolerance Standard</span>
              <strong class="text-sm font-black text-[#0F2B5B]">ISO 2768-m / DIN 16742</strong>
            </div>
          </div>

          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/80 leading-relaxed">
            <strong>Standardized Master Mold Base (MUD System):</strong> We accelerate mold manufacturing by inserting custom CNC-machined S136 steel cores directly into pre-engineered universal mold bases, eliminating 60% of traditional mold frame machining time.
          </div>
        </div>

        <!-- 右侧：估算工具与 CTA 导航面板 -->
        <div class="lg:col-span-5 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-2">FAST_TRACK_EVALUATION</span>
            <h3 class="text-2xl font-[1000] uppercase italic">Need a Rapid Tooling Cost Estimate?</h3>
            <p class="text-xs text-white/80 font-sans mt-2 leading-relaxed">
              Use our interactive calculators to estimate S136 NRE mold costs, or upload your 3D CAD drawing (.STEP) for an automated 24-hour DFM and wall-thickness review.
            </p>

            <div class="mt-6 space-y-3 font-mono text-xs">
              <a href="/resources/calculators/injection-mold-cost-estimator" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>Estimate S136 Tooling Cost →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">ESTIMATOR</span>
              </a>
              <a href="/resources/calculators/clamping-force-calculator" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>Calculate Press Tonnage →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">TOOL</span>
              </a>
            </div>
          </div>

          <button id="rapid-tooling-rfq-trigger" type="button" class="mt-8 bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
            Request 24H Rapid Tooling Quote →
          </button>
        </div>

      </div>

      <!-- 👑 GEO 结构化表格：S136 vs. NAK80 vs. P20 vs. 7075 Aluminum -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg mb-16">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Injection Mold Steel Grade Comparison Matrix
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="bg-[#0F2B5B] text-white">
                <th class="p-3 border border-[#0F2B5B]">Steel Grade</th>
                <th class="p-3 border border-[#0F2B5B]">Hardness (HRC)</th>
                <th class="p-3 border border-[#0F2B5B]">Shot Life Expectancy</th>
                <th class="p-3 border border-[#0F2B5B] text-[#EA580C]">Best Suited Application</th>
                <th class="p-3 border border-[#0F2B5B]">Relative Cost</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#0F2B5B]/10 text-[#0F2B5B]">
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">ASSAB S136 (ESR)</td>
                <td class="p-3">HRC 48 - 52</td>
                <td class="p-3 font-bold text-[#EA580C]">1,000,000+ Shots</td>
                <td class="p-3">Optics, Medical, Clear PC, High-Corrosive Resins</td>
                <td class="p-3">High</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">Daido NAK80</td>
                <td class="p-3">HRC 37 - 41</td>
                <td class="p-3">50,000 - 250,000 Shots</td>
                <td class="p-3">High-Precision Electronics, SPI-A2 Mirror Polish Parts</td>
                <td class="p-3">Moderate-High</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">P20 Pre-Hardened</td>
                <td class="p-3">HRC 28 - 32</td>
                <td class="p-3">50,000 - 100,000 Shots</td>
                <td class="p-3">Low-to-Medium Volume Commercial Plastic Parts</td>
                <td class="p-3">Moderate</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">7075-T6 Aluminum</td>
                <td class="p-3">HB 150</td>
                <td class="p-3">5,000 - 10,000 Shots</td>
                <td class="p-3">Ultra-Fast Prototype Validations (T1 in 3-5 Days)</td>
                <td class="p-3">Economy</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 7-14 天 T1 交付流程 Timeline -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg mb-16">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-8">
          The 14-Day Fast-Track Rapid Tooling Timeline
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 font-mono text-xs">
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl relative">
            <span class="text-[#EA580C] font-black text-sm block mb-1">DAY 01 - 02</span>
            <h4 class="font-bold text-[#0F2B5B] mb-2 uppercase">DFM & Moldflow</h4>
            <p class="text-[#0F2B5B]/80 font-sans leading-relaxed">Automated gate placement, draft angle analysis, and shrinkage compensation sign-off.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl relative">
            <span class="text-[#EA580C] font-black text-sm block mb-1">DAY 03 - 07</span>
            <h4 class="font-bold text-[#0F2B5B] mb-2 uppercase">High-Speed CNC & EDM</h4>
            <p class="text-[#0F2B5B]/80 font-sans leading-relaxed">Direct steel cutting of S136/NAK80 cavity inserts on 5-axis high-speed CNC and EDM wire machines.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl relative">
            <span class="text-[#EA580C] font-black text-sm block mb-1">DAY 08 - 11</span>
            <h4 class="font-bold text-[#0F2B5B] mb-2 uppercase">Fitting & Mold Assembly</h4>
            <p class="text-[#0F2B5B]/80 font-sans leading-relaxed">Bench fitting, slider integration, and surface texturing (SPI/VDI standards).</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl relative">
            <span class="text-[#EA580C] font-black text-sm block mb-1">DAY 12 - 14</span>
            <h4 class="font-bold text-[#0F2B5B] mb-2 uppercase">T1 Sampling & CMM FAI</h4>
            <p class="text-[#0F2B5B]/80 font-sans leading-relaxed">Initial mold trial on Haitian servo presses, Zeiss CMM 3D inspection, and express air dispatch of T1 samples.</p>
          </div>
        </div>
      </section>

      <!-- Tooling FAQs -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Rapid Tooling FAQs
        </h3>

        <div class="space-y-4 font-sans text-xs sm:text-sm text-[#0F2B5B]">
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> Why specify S136 stainless steel over pre-hardened P20 steel for rapid molds?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">ASSAB S136 is an Electro-Slag Remelted (ESR) stainless steel with superior corrosion resistance and high polishability. For high-temp engineering resins (PEEK, PC, PA66+GF) that emit corrosive gases during processing, S136 prevents surface pitting, maintaining optical finish for over 1,000,000 shots.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> Can rapid steel tooling be modified if our design changes after T1 samples?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">Yes. Because we use real steel (S136/NAK80) rather than aluminum, steel can be easily modified via secondary CNC machining or wire-EDM for metal-safe geometry adjustments.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
  function setupRapidToolingEvents() {
    const btn = document.getElementById('rapid-tooling-rfq-trigger');
    if (btn) {
      btn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }
  }
  document.addEventListener('astro:page-load', setupRapidToolingEvents);
</script>