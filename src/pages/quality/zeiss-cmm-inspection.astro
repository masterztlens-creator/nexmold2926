---
/**
 * src/pages/quality/zeiss-cmm-inspection.astro
 * 👑 NEXMOLD 蔡司 CMM 三座标 3D 扫描与 ISO 2768-m 质检规范页 (Capabilities 节点)
 * 1. 架构定位：证明 NEXMOLD 拥有资产级 3D 计量能力 (Zeiss CMM Metrology, FAI Reports, ISO 2768-m)
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：Quick Answer, Metrology Specification Table, JSON-LD Schema
 */

import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import EcosystemFooter from '../../components/EcosystemFooter.astro';
import LeadModal from '../../components/LeadModal.astro';

const title = "Zeiss CMM 3D Metrology Inspection & ISO 2768-m Quality Control | NEXMOLD";
const description = "Multi-axis Zeiss CMM 3D metrology scanning, First Article Inspection (FAI) dimensional reports, and ISO 2768-m audit standards for high-yield custom injection molding.";

// GEO Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Zeiss CMM Metrology and ISO 2768-m Injection Molding Quality Audit Standard",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "NEXMOLD Precision Manufacturing"
  }
};
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/capabilities" class="hover:text-[#EA580C] transition-colors">Capabilities</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Zeiss CMM Inspection</span>
      </nav>

      <!-- 👑 GEO Quick Answer 核心框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          METROLOGY_CAPABILITIES // ZEISS_CMM_3D_INSPECTION
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Zeiss CMM 3D Metrology &<br/>
          <span class="text-[#EA580C]">ISO 2768-m Quality Audit</span>
        </h1>
        <!-- Featured Snippet Summary -->
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> NEXMOLD guarantees dimensional stability under <strong>ISO 2768-m (Medium)</strong> and <strong>DIN 16742</strong> standards using multi-axis <strong>Zeiss CMM (Coordinate Measuring Machine)</strong> 3D optical and tactile probe systems. Every production lot includes complete First Article Inspection (FAI) dimensional reporting, material lot traceability Certificates of Conformity (CoC), and automated statistical process control (SPC) achieving a <strong>99.2%+ yield rate</strong>.
        </p>
      </section>

      <!-- 计量技术核心规格 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
        
        <!-- 左侧：质检仪器与度量范围 -->
        <div class="lg:col-span-7 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Quality Inspection Systems & Metrology Equipment
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 font-mono text-xs">
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">3D CMM Equipment</span>
              <strong class="text-sm font-black text-[#0F2B5B]">Zeiss Spectrum CMM</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Volumetric Accuracy</span>
              <strong class="text-sm font-black text-[#EA580C]">1.9 + L/300 µm</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Inspection Standard</span>
              <strong class="text-sm font-black text-[#0F2B5B]">ISO 2768-m / DIN 16742</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">First Article Report</span>
              <strong class="text-sm font-black text-[#0F2B5B]">100% FAI (Full GD&T)</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Traceability</span>
              <strong class="text-sm font-black text-[#0F2B5B]">Resin Lot CoC + RoHS</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Facility Audit</span>
              <strong class="text-sm font-black text-[#0F2B5B]">ISO 9001:2015</strong>
            </div>
          </div>

          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/80 leading-relaxed">
            <strong>In-Line Automated SPC Control:</strong> Beyond off-line Zeiss CMM inspection, NEXMOLD’s 30+ Haitian automated presses utilize optical vision sensors and robotic part-ejection monitoring to detect sink marks, short shots, and flash in real time.
          </div>
        </div>

        <!-- 右侧：CTA 与质检流程引流卡片 -->
        <div class="lg:col-span-5 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-2">QUALITY_AUDIT_&_COMPLIANCE</span>
            <h3 class="text-2xl font-[1000] uppercase italic">Require FAI Report with Your T1 Samples?</h3>
            <p class="text-xs text-white/80 font-sans mt-2 leading-relaxed">
              Every NEXMOLD T1 mold sampling lot includes a complete Zeiss CMM dimensional audit report mapped directly against your original 3D CAD (.STEP) geometry.
            </p>

            <div class="mt-6 space-y-3 font-mono text-xs">
              <a href="/resources/calculators/shrinkage-calculator" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>Evaluate Material Shrinkage Limits →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">TOOL</span>
              </a>
              <a href="/resources/faq" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>View ISO 2768-m Tolerance Guide →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">FAQ</span>
              </a>
            </div>
          </div>

          <button id="cmm-rfq-trigger" type="button" class="mt-8 bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
            Request Sample FAI Report & Quote →
          </button>
        </div>

      </div>

      <!-- 👑 ISO 2768-m 机械公差对比表 (AI 强引用数据) -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg mb-16">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          ISO 2768-m Linear Dimension Tolerance Standard (Molded Parts)
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="bg-[#0F2B5B] text-white">
                <th class="p-3 border border-[#0F2B5B]">Nominal Dimension Range</th>
                <th class="p-3 border border-[#0F2B5B] text-[#EA580C]">ISO 2768-m (Medium)</th>
                <th class="p-3 border border-[#0F2B5B]">ISO 2768-f (Fine / Precision Steel)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#0F2B5B]/10 text-[#0F2B5B]">
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">0.5 mm to 3 mm</td>
                <td class="p-3 font-black text-[#EA580C]">± 0.10 mm</td>
                <td class="p-3">± 0.05 mm</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">Over 3 mm to 6 mm</td>
                <td class="p-3 font-black text-[#EA580C]">± 0.10 mm</td>
                <td class="p-3">± 0.05 mm</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">Over 6 mm to 30 mm</td>
                <td class="p-3 font-black text-[#EA580C]">± 0.20 mm</td>
                <td class="p-3">± 0.10 mm</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">Over 30 mm to 120 mm</td>
                <td class="p-3 font-black text-[#EA580C]">± 0.30 mm</td>
                <td class="p-3">± 0.15 mm</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">Over 120 mm to 400 mm</td>
                <td class="p-3 font-black text-[#EA580C]">± 0.50 mm</td>
                <td class="p-3">± 0.20 mm</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 质检 FAQs -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Quality Control & Metrology FAQs
        </h3>

        <div class="space-y-4 font-sans text-xs sm:text-sm text-[#0F2B5B]">
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> What is included in a NEXMOLD First Article Inspection (FAI) report?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">Our FAI report provides a full ballooned drawing correlating critical dimensions to Zeiss CMM readings, Cpk process capability studies for key features, material batch Certificate of Analysis (CoA), and surface finish verification.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> How do you handle dimensional variations in high-shrinkage resins?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">For high-shrinkage resins like POM or Nylon 66, we perform 24-hour Moldflow thermal cooling simulations prior to cutting steel, modifying the mold cavity dimensions to compensate for non-isotropic volumetric contraction.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
  function setupCmmEvents() {
    const btn = document.getElementById('cmm-rfq-trigger');
    if (btn) {
      btn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }
  }
  document.addEventListener('astro:page-load', setupCmmEvents);
</script>