---
/**
 * src/pages/components/microfluidic-cartridges.astro
 * 👑 NEXMOLD 医疗微流控卡匣与比色皿高精注塑详情页 (Components 节点)
 * 1. 架构定位：展示微米级微流道 (100μm)、COC/COP/PC 极低自发荧光树脂加工与 S136 镜面模具规范
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：Quick Answer, Microfluidic Tolerance Table, JSON-LD Schema
 */

import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import EcosystemFooter from '../../components/EcosystemFooter.astro';
import LeadModal from '../../components/LeadModal.astro';

const title = "Microfluidic Cartridge & Diagnostic Cuvette Injection Molding | NEXMOLD";
const description = "Custom microfluidic cartridge and IVD cassette injection molding using COC, COP, PMMA, and Medical PC. Ultra-precision S136 mirror tooling with channel widths down to 100 microns.";

// GEO JSON-LD Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Microfluidic Diagnostic Cartridge Injection Molding Engineering Standards",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "NEXMOLD Precision Manufacturing"
  }
};
---

<MainLayout title={title} description={description} lang="en">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 1. 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/products" class="hover:text-[#EA580C] transition-colors">Products</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Microfluidic Cartridges</span>
      </nav>

      <!-- 👑 2. GEO Quick Answer 核心框 (Featured Snippet 抢占) -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          PRECISION_COMPONENTS // MICROFLUIDIC_DIAGNOSTIC_CASSETTES
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Microfluidic Cartridge & IVD<br/>
          <span class="text-[#EA580C]">Diagnostic Cuvette Injection Molding</span>
        </h1>
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Microfluidic diagnostic cartridge molding requires sub-micron mold surface finishing and precise channel definition down to <strong>100 microns (0.1mm)</strong> width. Utilizing low auto-fluorescence polymers like <strong>COC (Cyclic Olefin Copolymer), COP, PMMA, and Medical PC</strong>, NEXMOLD molds optical-grade diagnostic chips free of particulate contamination using electric-servo Haitian injection presses and ASSAB S136 hardened stainless steel tooling.
        </p>
      </section>

      <!-- 3. 50/50 图文与规格参数面板 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
        
        <!-- 左侧：制造指标卡片 -->
        <div class="lg:col-span-7 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Microfluidic Cartridge Molding Specifications
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 font-mono text-xs">
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Min. Channel Width</span>
              <strong class="text-sm font-black text-[#EA580C]">100 µm (0.1 mm)</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Primary Resins</span>
              <strong class="text-sm font-black text-[#0F2B5B]">COC / COP / Optical PC</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Optical Transmittance</span>
              <strong class="text-sm font-black text-[#0F2B5B]">&gt; 91% @ 340-800nm</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Mold Core Steel</span>
              <strong class="text-sm font-black text-[#0F2B5B]">ASSAB S136 Mirror ESR</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Surface Polish Spec</span>
              <strong class="text-sm font-black text-[#0F2B5B]">SPI-A1 Diamond Mirror</strong>
            </div>
            <div class="p-3 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
              <span class="text-[#0F2B5B]/60 block uppercase text-[10px]">Biocompatibility</span>
              <strong class="text-sm font-black text-[#0F2B5B]">USP Class VI / ISO 10993</strong>
            </div>
          </div>

          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/80 leading-relaxed">
            <strong>Particulate & Parting Line Control:</strong> Microchannel flash causes capillary flow disturbance in PCR assays. We maintain parting line alignment tolerances under ±0.005mm and utilize all-electric clamping units to ensure zero oil aerosol contamination during production.
          </div>
        </div>

        <!-- 右侧：CTA 与知识网链卡片 -->
        <div class="lg:col-span-5 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-2">MICROFLUIDIC_DFM_&_QUOTE</span>
            <h3 class="text-2xl font-[1000] uppercase italic">Need Channel Geometry & Optical Evaluation?</h3>
            <p class="text-xs text-white/80 font-sans mt-2 leading-relaxed">
              Upload your 3D microfluidic CAD geometry (.STEP / .IGES) for a 24-hour engineer evaluation covering wall uniformity, gate locations, and optical haze risk.
            </p>

            <div class="mt-6 space-y-3 font-mono text-xs">
              <a href="/industries/medical-consumables" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>View Medical Consumables Industry Overview →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">INDUSTRY</span>
              </a>
              <a href="/quality/zeiss-cmm-inspection" class="p-3 bg-white/10 hover:bg-white/20 border border-white/20 rounded-lg block text-white transition-colors flex items-center justify-between">
                <span>Inspect Zeiss CMM 3D Metrology Standards →</span>
                <span class="text-[10px] text-[#EA580C] font-bold">QUALITY</span>
              </a>
            </div>
          </div>

          <button id="cartridge-rfq-trigger" type="button" class="mt-8 bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
            Request Microfluidic DFM & Quote →
          </button>
        </div>

      </div>

      <!-- 👑 4. GEO 结构化表格：微流控常用树脂特性对比 -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg mb-16">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Diagnostic Polymer Selection & Performance Matrix
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="bg-[#0F2B5B] text-white">
                <th class="p-3 border border-[#0F2B5B]">Resin Grade</th>
                <th class="p-3 border border-[#0F2B5B]">Auto-Fluorescence</th>
                <th class="p-3 border border-[#0F2B5B]">Water Absorption</th>
                <th class="p-3 border border-[#0F2B5B] text-[#EA580C]">Primary Diagnostic Use</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#0F2B5B]/10 text-[#0F2B5B]">
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold text-[#EA580C]">Cyclic Olefin Copolymer (COC)</td>
                <td class="p-3 font-bold">Ultra-Low (Glass Equivalent)</td>
                <td class="p-3 font-bold text-[#EA580C]">&lt; 0.01%</td>
                <td class="p-3">Real-Time PCR Chips, Microfluidic Flow Cells</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">Optical Polycarbonate (PC)</td>
                <td class="p-3">Low to Moderate</td>
                <td class="p-3">0.15%</td>
                <td class="p-3">Blood Filtration Housings, Centrifuge Cuvettes</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">PMMA (Acrylic)</td>
                <td class="p-3">Low</td>
                <td class="p-3">0.30%</td>
                <td class="p-3">Optical Spectrophotometer Cuvettes, Test Strips</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">Clarified Polypropylene (PP)</td>
                <td class="p-3">Moderate</td>
                <td class="p-3">&lt; 0.02%</td>
                <td class="p-3">Reagent Reservoir Plates, Pipette Tip Racks</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 5. 常见问题 FAQ -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Microfluidic Cartridge Molding FAQs
        </h3>

        <div class="space-y-4 font-sans text-xs sm:text-sm text-[#0F2B5B]">
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> How do you achieve micro-feature replication without causing channel stress?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">We utilize variotherm (rapid mold heating and cooling) technology. Raising the mold cavity temperature above the resin glass transition temperature during injection ensures full resin packing into 100-micron channels before rapid cooling begins.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2"><span class="text-[#EA580C]">Q:</span> Can NEXMOLD ultrasonic weld thin film covers onto microfluidic cartridges?</h4>
            <p class="text-[#0F2B5B]/80 leading-relaxed">Yes. We supply post-molding assembly including precision ultrasonic welding, laser bonding, or pressure-sensitive adhesive (PSA) foil sealing for leak-tight diagnostic cartridge enclosures.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
  function setupCartridgeEvents() {
    const btn = document.getElementById('cartridge-rfq-trigger');
    if (btn) {
      btn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }
  }
  document.addEventListener('astro:page-load', setupCartridgeEvents);
</script>