---
import '../../styles/global.css';

/**
 * src/pages/materials/index.astro
 * NEXMOLD 全球工程塑料知识图谱与选型聚合页 (180+ Polymer Material Hub)
 * 工业旗舰究极闭环版：暗夜钛金美学 + 智能模具钢材映射 + 3D 视差倾斜 + 完美响应式分页
 */

import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import rawResinsData from '../../data/resins.json';

export type SupportedLang = 'en' | 'de' | 'fr';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'en' } = Astro.props as Props;
const prefix = lang === 'en' ? '' : `/${lang}`;
const pageUrl = `https://nxmold.com${prefix}/materials`;

interface HeroSpecs {
  badge: string;
  h1Main: string;
  h1Accent: string;
  h1Sub: string;
  lead: string;
  searchPlaceholder: string;
  searchBtn: string;
  hotChips: string[];
  ctaPrimary: string;
  ctaSubtext: string;
  ctaSecondary: string;
  hudProbe1Title: string;
  hudProbe1Val: string;
  hudProbe2Title: string;
  hudProbe2Val: string;
  hudProbe3Title: string;
  hudProbe3Val: string;
}

const heroSpecsMap: Record<SupportedLang, HeroSpecs> = {
  en: {
    badge: 'DIRECT FACTORY TOOLROOM • 12H DFM REPORT • ISO 9001:2015 CERTIFIED',
    h1Main: 'Precision Tooling &',
    h1Accent: 'Custom Injection Molding',
    h1Sub: '180+ Qualified Polymers. Zero Spec Guesswork. Micro-Tolerances Down to ±0.010mm.',
    lead: 'Direct technical engineering from Dongguan toolroom to European & North American OEMs. From rapid bridge prototype tooling to Class 101 high-cavitation production molds—zero middleman markups with 100% virgin polymer lot traceability.',
    searchPlaceholder: 'Search 180+ resins, shrink rates, or flammability (e.g. PEEK, PA66-GF30, UL94)...',
    searchBtn: 'Filter Resins',
    hotChips: ['PEEK-CF30', 'PA66-GF30', 'HIPS (Water Tank)', 'PC/ABS FR', 'Tritan Clear'],
    ctaPrimary: 'Upload CAD for 24h DFM & Quote',
    ctaSubtext: '🔒 Strict NDA Guarantee • Avg. Response: 3.8 Hours',
    ctaSecondary: 'Order Sample Box',
    hudProbe1Title: 'Zeiss CMM Probe #04',
    hudProbe1Val: 'Draft 1.50° Verified (±0.005mm)',
    hudProbe2Title: 'Moldflow CAE',
    hudProbe2Val: 'Fill Time: 0.48s (Zero Sink)',
    hudProbe3Title: 'Optical Inspection',
    hudProbe3Val: 'SPI-A1 Mirror Polish Pass',
  },
  de: {
    badge: 'DIREKTER WERKZEUGBAU • 12H DFM-BERICHT • ISO 9001:2015',
    h1Main: 'Präzisions-Formenbau &',
    h1Accent: 'Kundenspezifischer Spritzguss',
    h1Sub: '180+ qualifizierte Polymere. Mikrotoleranzen bis zu ±0,010 mm.',
    lead: 'Direkte Kommunikation mit dem Werkzeugbau in Dongguan für europäische und nordamerikanische OEMs. Vom Prototypenwerkzeug bis zur Klasse-101-Produktionsform – ohne Zwischenhändler mit 100% Chargenrückverfolgbarkeit.',
    searchPlaceholder: '180+ Kunststoffe, Schwund oder Brandklasse suchen (z.B. PEEK, PA66)...',
    searchBtn: 'Filtern',
    hotChips: ['PEEK-CF30', 'PA66-GF30', 'HIPS (Wassertank)', 'PC/ABS FR', 'Tritan'],
    ctaPrimary: 'CAD für 24h-DFM & Angebot',
    ctaSubtext: '🔒 100% NDA-Garantie • Durchschn. Antwortzeit: 3,8 Std.',
    ctaSecondary: 'Musterbox anfordern',
    hudProbe1Title: 'Zeiss KMG-Taster #04',
    hudProbe1Val: 'Entformung 1,50° (±0,005mm)',
    hudProbe2Title: 'Moldflow CAE',
    hudProbe2Val: 'Füllzeit: 0,48s (Kein Einfall)',
    hudProbe3Title: 'Optische Prüfung',
    hudProbe3Val: 'SPI-A1 Hochglanzpolitur',
  },
  fr: {
    badge: 'INGÉNIERIE DIRECTE EN USINE • DFM EN 12H • ISO 9001:2015',
    h1Main: 'Outillage de Précision &',
    h1Accent: 'Moulage par Injection Sur Mesure',
    h1Sub: '180+ Polymères Qualifiés. Tolérances jusqu’à ±0,010 mm.',
    lead: 'Ingénierie directe depuis l’atelier de Dongguan pour les donneurs d’ordres occidentaux. Du moule prototype rapide aux outillages de production Classe 101 – zéro marge intermédiaire avec traçabilité matière 100% vierge.',
    searchPlaceholder: 'Rechercher 180+ résines, retrait ou feu (ex. PEEK, PA66-GF30)...',
    searchBtn: 'Filtrer',
    hotChips: ['PEEK-CF30', 'PA66-GF30', 'HIPS (Réservoir)', 'PC/ABS FR', 'Tritan'],
    ctaPrimary: 'Déposer CAO pour DFM 24h',
    ctaSubtext: '🔒 Accord NDA 100% Garanti • Réponse moyenne: 3.8h',
    ctaSecondary: 'Commander Échantillons',
    hudProbe1Title: 'Sonde Zeiss CMM #04',
    hudProbe1Val: 'Dépouille 1,50° (±0,005mm)',
    hudProbe2Title: 'Front CAE Moldflow',
    hudProbe2Val: 'Remplissage: 0,48s',
    hudProbe3Title: 'Contrôle Optique',
    hudProbe3Val: 'Polissage Miroir SPI-A1',
  }
};

const ht = heroSpecsMap[lang] || heroSpecsMap.en;

interface CommercialGrade {
  mfg: string;
  grade: string;
  feature: string;
}

interface ResinFamily {
  id: string;
  name: string;
  code: string;
  category: 'commodity' | 'engineering' | 'high-performance' | 'elastomers';
  categoryLabel: string;
  temp: string;
  tensile: string;
  shrinkage: string;
  shrinkageFlow?: string;
  shrinkageCross?: string;
  density?: string;
  cert: string;
  desc: string;
  industries?: string[];
  applications?: string[];
  slug: string;
  grades: CommercialGrade[];
}

const resinFamilies = (rawResinsData as ResinFamily[]) || [];

// 👑 智能模具钢材映射函数（打通材料性能与模具加工工艺的逻辑链条）
const getToolingSteel = (code: string, feature: string) => {
  if (code.includes('GF') || code.includes('CF') || feature.includes('Glass') || feature.includes('Carbon') || feature.includes('Abrasive')) {
    return 'SKD11 / 1.2379 (High Wear-Resistance)';
  }
  if (code.includes('PC') || code.includes('PMMA') || code.includes('Tritan') || feature.includes('Transparent')) {
    return 'S136 / NAK80 (SPI-A1 Mirror Polish)';
  }
  if (code.includes('PEEK') || code.includes('PPS') || code.includes('PEI') || code.includes('PPA')) {
    return 'H13 Vacuum Hardened (HRC 50-54)';
  }
  return 'P20 / 718H Pre-Hardened Steel';
};

const flattenedResins = resinFamilies.flatMap((family) =>
  family.grades.map((grade) => ({
    ...grade,
    familyId: family.id,
    familyName: family.name,
    familyCode: family.code,
    category: family.category,
    categoryLabel: family.categoryLabel,
    temp: family.temp,
    tensile: family.tensile,
    shrinkage: family.shrinkage,
    shrinkageFlow: family.shrinkageFlow || family.shrinkage.split('-')[0]?.trim() || '0.4%',
    shrinkageCross: family.shrinkageCross || family.shrinkage.split('-')[1]?.trim() || '0.7%',
    density: family.density || '1.15 g/cm³',
    cert: family.cert,
    desc: family.desc,
    toolingSteel: getToolingSteel(family.code, grade.feature),
    industries: family.industries || ['appliances', 'automotive', 'electronics', 'industrial', 'new-energy', 'medical', 'aerospace'],
    applications: family.applications || ['Precision Structural Parts', 'OEM Assemblies'],
    slug: `${grade.mfg}-${grade.grade}`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
  }))
);

const initialDisplayGrades = flattenedResins.slice(0, 8);

const metalReplacementData = [
  { plastic: 'PA66-GF30 / PPA-GF50', metal: 'Die-Cast Aluminum (A380)', weightSaving: '40% - 50%', tensileComp: '175 MPa vs. 310 MPa', costAdvantage: '35% (Zero Post-CNC Machining)', keyBenefit: 'Integrated snap-fits, zero galvanic corrosion, high mechanical damping' },
  { plastic: 'PEEK-CF30', metal: 'Titanium (Ti-6Al-4V)', weightSaving: '65%', tensileComp: '220 MPa vs. 890 MPa', costAdvantage: '50% (High Cavitation Speed)', keyBenefit: 'X-ray radiolucent, MRI compatible, self-lubricating sliding wear' },
  { plastic: 'POM (Delrin 100P)', metal: 'Brass / Bronze (C36000)', weightSaving: '80%', tensileComp: '75 MPa vs. 380 MPa', costAdvantage: '60% (Zero Lead Leaching)', keyBenefit: 'Silent gear meshing, self-lubricating, NSF potable water certified' },
  { plastic: 'PPS-GF40', metal: 'Stainless Steel (304/316)', weightSaving: '70%', tensileComp: '165 MPa vs. 505 MPa', costAdvantage: '45% (Complex Internal Flow Channels)', keyBenefit: 'Zero corrosion in hot glycol/acid fuels up to 200°C' }
];

const faqs = [
  {
    q: 'How does NEXMOLD compensate for resin shrinkage during precision injection mold building?',
    a: 'We calculate isotropic and anisotropic shrink rates using Moldflow CAE simulation prior to CNC tooling. For amorphous resins (ABS, PC), shrinkage is uniform (0.4%-0.7%). For semi-crystalline or fiber-filled polymers (POM, PP, PA66-GF30), we apply directional shrinkage factors (parallel vs. perpendicular to the gate flow) to ensure parts conform to DIN 16742 Group 1 / ISO 20457 tolerances.'
  },
  {
    q: 'What quality certifications and material lot traceability documents are provided?',
    a: 'Every production batch is accompanied by a Certificate of Conformance (CoC), material technical datasheets (TDS), and original resin manufacturer lot inspection reports (e.g. Sabic, DuPont, BASF, Covestro). We maintain a 100% Virgin Polymer Policy with zero unauthorized regrind.'
  },
  {
    q: 'Which plastic materials are recommended for metal replacement in automotive brackets?',
    a: 'PA66-GF30, PPA-GF45, and PPS-GF40 are primary choices. PA66-GF30 provides 175 MPa tensile strength and high stiffness up to 180°C, reducing weight by 45% compared to die-cast aluminum while eliminating secondary CNC deburring and drilling processes.'
  },
  {
    q: 'Can NEXMOLD mold transparent resins with optical SPI-A1 polish without haze or sink marks?',
    a: 'Yes. For optical parts molded from PC, PMMA, GPPS, and Tritan copolyester, we utilize hardened S136 / NAK80 mirror-finish mold cavity inserts (polished to Ra 0.012 µm). We implement decoupled scientific molding and conformal cooling to prevent thermal sink marks and optical distortion.'
  },
  {
    q: 'What is the minimum Shore hardness for two-shot (2K) and insert overmolding?',
    a: 'We process TPE/TPU elastomers ranging from Shore 30A (ultra-soft touch seals) to Shore 95A (wear-resistant bumpers). We select specific resin grades that generate covalent chemical bonding to rigid substrates (PP, ABS, PC, PA66) without requiring primer coatings.'
  },
  {
    q: 'How are hygroscopic resins dried prior to molding to prevent hydrolytic degradation?',
    a: 'Engineered resins such as PA66, PBT, PEEK, and PEI are processed using desiccant dehumidifying dryers to achieve a dew point below -40°C. Moisture levels are verified using Karl Fischer moisture analyzers prior to barrel charging to ensure zero splay, silver streaking, or loss of mechanical impact.'
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://nxmold.com/#organization",
      "name": "NEXMOLD Precision Manufacturing Co., Ltd.",
      "alternateName": "NxMold",
      "url": "https://nxmold.com",
      "logo": "https://nxmold.com/logo.png",
      "description": "Direct precision mold design and custom plastic injection molding factory in Dongguan, specializing in tight-tolerance engineering tooling and 180+ polymer resins.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dongguan",
        "addressRegion": "Guangdong",
        "addressCountry": "CN"
      }
    },
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "NEXMOLD Polymer Materials & Engineering Resins Hub (180+ Resins)",
      "description": "Comprehensive engineering database of 180+ qualified injection molding plastics with physical properties, shrink rates, tensile strength, and international certifications.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://nxmold.com${prefix}/` },
          { "@type": "ListItem", "position": 2, "name": "Materials Hub", "item": pageUrl }
        ]
      }
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#itemlist`,
      "name": "Qualified Commercial Thermoplastic Injection Molding Resins",
      "numberOfItems": flattenedResins.length,
      "itemListElement": flattenedResins.map((r, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": `${r.mfg} ${r.grade} (${r.familyCode})`,
        "description": `${r.feature} - Tensile: ${r.tensile}, Shrinkage: ${r.shrinkage}. Base Family: ${r.familyName}.`,
        "url": `https://nxmold.com${prefix}/materials/${r.slug}`
      }))
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    }
  ]
};
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Engineering Materials & Resin Hub (180+ Resins) | NEXMOLD</title>
  <meta name="description" content="Explore 180+ qualified injection molding polymers: Commodity, Engineering, High-Performance (PEEK, ULTEM, PPS), and Elastomers. Complete physical datasheet matrix with shrink rates, DIN 16742 tolerances, and certifications." />
  <link rel="canonical" href={pageUrl} />
  <link rel="alternate" hreflang="en" href="https://nxmold.com/materials" />
  <link rel="alternate" hreflang="de" href="https://nxmold.com/de/materials" />
  <link rel="alternate" hreflang="fr" href="https://nxmold.com/fr/materials" />
  <link rel="alternate" hreflang="x-default" href="https://nxmold.com/materials" />

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  
  <style>
    @keyframes pulseGlow {
      0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7); }
      70% { transform: scale(1.05); opacity: 1; box-shadow: 0 0 0 16px rgba(234, 88, 12, 0); }
      100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 0 0 rgba(234, 88, 12, 0); }
    }
    .industrial-pulse { animation: pulseGlow 2.5s infinite; }

    @keyframes scanline {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(1000%); }
    }
    .scanline-effect::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(to right, transparent, rgba(234, 88, 12, 0.8), transparent);
      animation: scanline 4s linear infinite;
      pointer-events: none;
    }

    /* 👑 顶级工业奢华钛金暗夜卡片：多层深度发光 + 动态光斑质感 */
    .obsidian-card {
      background: linear-gradient(165deg, rgba(14, 21, 37, 0.96) 0%, rgba(5, 8, 15, 0.99) 100%);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: 0 35px 80px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.12);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }
    .obsidian-card::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%; width: 200%; height: 200%;
      background: radial-gradient(circle, rgba(234, 88, 12, 0.08) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    .obsidian-card:hover::before { opacity: 1; }
    .obsidian-card:hover {
      border-color: rgba(234, 88, 12, 0.95);
      box-shadow: 0 40px 100px rgba(0, 0, 0, 0.9), 0 0 45px rgba(234, 88, 12, 0.4), inset 0 1px 0 rgba(234, 88, 12, 0.7);
      transform: translateY(-8px);
    }

    .glass-hud {
      background: linear-gradient(135deg, rgba(10, 16, 28, 0.95) 0%, rgba(16, 32, 64, 0.99) 100%);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(234, 88, 12, 0.5);
      box-shadow: 0 30px 70px -10px rgba(0, 0, 0, 0.9);
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .table-fix-container { width: 100%; overflow-x: auto; }
    
    .shrink-badge-flow {
      background: rgba(234, 88, 12, 0.22);
      color: #FFEDD5;
      border: 1px solid rgba(234, 88, 12, 0.5);
    }
    .shrink-badge-cross {
      background: rgba(56, 189, 248, 0.18);
      color: #E0F2FE;
      border: 1px solid rgba(56, 189, 248, 0.45);
    }
    #compare-modal {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
  </style>
</head>

<body class="bg-[#030508] text-slate-100 font-sans antialiased selection:bg-[#EA580C] selection:text-white flex flex-col min-h-screen">

  <Header lang={lang} />

  <!-- 👑 2. 极致视觉冲击力 HERO 区域（旗舰暗夜钛金舱，自带激光扫描线） -->
  <section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-24 overflow-hidden bg-[#030508] text-white scanline-effect">
    
    <!-- 精密工程底纹与重工业光影 -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <img 
        src="/images/materials/nexmold-precision-injection-molding-dfm-cad-inspection-dongguan.webp" 
        alt="NEXMOLD polymer materials inspection and precision injection molding" 
        class="w-full h-full object-cover opacity-[0.14] mix-blend-luminosity filter contrast-200 scale-105"
      />
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:56px_56px]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(234,88,12,0.28)_0%,rgba(3,5,8,0.92)_70%,#010204_100%)]"></div>
      
      <!-- 四角精密定位准星 -->
      <div class="absolute top-8 left-8 w-6 h-6 border-t-2 border-l-2 border-[#EA580C]"></div>
      <div class="absolute top-8 right-8 w-6 h-6 border-t-2 border-r-2 border-[#EA580C]"></div>
      <div class="absolute bottom-8 left-8 w-6 h-6 border-b-2 border-l-2 border-[#EA580C]"></div>
      <div class="absolute bottom-8 right-8 w-6 h-6 border-b-2 border-r-2 border-[#EA580C]"></div>
    </div>

    <!-- 左侧 HUD 测量舱指示器 -->
    <div class="absolute top-[22%] left-[6%] hidden 2xl:block z-10 glass-hud px-6 py-4 rounded-2xl text-left font-mono transform -rotate-1 hover:scale-105 transition-transform duration-500 cursor-default border-l-4 border-emerald-400">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 industrial-pulse"></span>
        <span class="text-[10px] text-emerald-400 tracking-[0.25em] font-black uppercase">{ht.hudProbe1Title}</span>
      </div>
      <div class="text-sm text-white font-black tracking-wide">{ht.hudProbe1Val}</div>
      <div class="text-[9px] text-slate-400 mt-1 font-mono">STATUS: OPTICAL CMM CALIBRATED</div>
      <div class="absolute -right-20 top-1/2 w-20 h-[2px] bg-emerald-400/40"></div>
    </div>

    <!-- 右侧 CAE 模拟舱指示器 -->
    <div class="absolute top-[26%] right-[6%] hidden 2xl:block z-10 glass-hud px-6 py-4 rounded-2xl text-left font-mono transform rotate-1 hover:scale-105 transition-transform duration-500 cursor-default border-l-4 border-[#EA580C]">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="w-2.5 h-2.5 rounded-full bg-[#EA580C] industrial-pulse"></span>
        <span class="text-[10px] text-orange-400 tracking-[0.25em] font-black uppercase">{ht.hudProbe2Title}</span>
      </div>
      <div class="text-sm text-white font-black tracking-wide">{ht.hudProbe2Val}</div>
      <div class="w-full h-1.5 bg-slate-800 mt-2.5 rounded-full overflow-hidden">
        <div class="h-full w-[92%] bg-gradient-to-r from-emerald-400 via-cyan-400 to-[#EA580C]"></div>
      </div>
      <div class="absolute -left-20 top-1/2 w-20 h-[2px] bg-[#EA580C]/40"></div>
    </div>

    <div class="relative z-20 w-full max-w-5xl mx-auto px-4 sm:px-6 text-center mt-4">
      
      <!-- 厂房认证 Badge -->
      <div class="inline-flex items-center justify-center gap-2.5 px-4 py-2 rounded-full border border-white/15 bg-white/5 backdrop-blur-md shadow-2xl mb-8">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#EA580C] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#EA580C]"></span>
        </span>
        <span class="font-mono text-[10px] sm:text-xs font-bold text-slate-200 uppercase tracking-[0.2em]">{ht.badge}</span>
      </div>

      <!-- 核心大标题：极具视觉冲击力的双色重工业排版 -->
      <h1 class="text-4xl sm:text-6xl lg:text-[76px] font-[1000] tracking-tighter uppercase text-white leading-[1.02] mx-auto drop-shadow-2xl" itemprop="name">
        {ht.h1Main} <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#EA580C] via-orange-500 to-amber-400 drop-shadow-[0_0_50px_rgba(234,88,12,0.8)]">{ht.h1Accent}</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl font-bold text-slate-300 tracking-tight max-w-2xl mx-auto font-mono">
        {ht.h1Sub}
      </p>

      <p class="mt-4 text-xs sm:text-sm text-slate-400 max-w-2xl mx-auto leading-relaxed" itemprop="description">
        {ht.lead}
      </p>

      <!-- 顶配搜索框：精密命令行风格 -->
      <div class="w-full max-w-2xl mx-auto mt-10 relative">
        <div class="relative flex items-center bg-slate-900/95 border-2 border-slate-700 hover:border-[#EA580C] focus-within:border-[#EA580C] focus-within:ring-4 focus-within:ring-[#EA580C]/30 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.7)] transition-all duration-300 backdrop-blur-xl">
          
