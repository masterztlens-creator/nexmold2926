  <!-- 👑 客户端交互脚本 (桌面端每页 8 个，完美 4 列 × 2 行布局) -->
  <script>
    function setupMaterialsPage() {
      const allGrades = (window as any).__NEXMOLD_RESINS__ || [];
      const prefix = (window as any).__NEXMOLD_PREFIX__ || '';
      
      const searchInput = document.getElementById('resin-search-input') as HTMLInputElement | null;
      const heroSearchInput = document.getElementById('hero-resin-search') as HTMLInputElement | null;
      const heroJumpBtn = document.getElementById('hero-search-jump-btn');
      const chipBtns = document.querySelectorAll('.hero-chip-btn');
      const categoryBtns = document.querySelectorAll('.filter-tab-btn');
      const industryBtns = document.querySelectorAll('.industry-tag-btn');
      const resetBtn = document.getElementById('reset-all-filters-btn');
      
      const grid = document.getElementById('materials-grid');
      const tableBody = document.getElementById('materials-table-body');
      const tableWrapper = document.getElementById('materials-table-wrapper');
      const noResults = document.getElementById('no-search-results');
      const countAll = document.getElementById('count-all');
      const paginationContainer = document.getElementById('pagination-container');
      
      let currentCategory = 'all';
      let currentIndustry = 'all';
      let currentQuery = '';
      let isImperial = false;
      let selectedCompareGrades: string[] = [];

      // 👑 终端自适应分页设置：手机端每页 4 个，平板端每页 6 个，桌面端每页 8 个（完美 4 列 × 2 行）
      const getPageSize = () => {
        if (window.innerWidth < 768) return 4;
        if (window.innerWidth < 1280) return 6;
        return 8; // 桌面端每页 8 个：4列 × 2行，大气且极具呼吸感
      };

      let currentPage = 1;
      let activeFilteredGrades = allGrades;

      const compareBar = document.getElementById('compare-sticky-bar');
      const compareCount = document.getElementById('compare-count');
      const clearCompareBtn = document.getElementById('clear-compare-btn');
      const modalClearBtn = document.getElementById('modal-clear-btn');
      const triggerCompareModal = document.getElementById('trigger-compare-modal');
      const compareModal = document.getElementById('compare-modal');
      const compareModalBackdrop = document.getElementById('compare-modal-backdrop');
      const closeCompareModal = document.getElementById('close-compare-modal');
      const compareTableContainer = document.getElementById('compare-table-container');
      const compareToRfqBtn = document.getElementById('compare-to-rfq-btn');

      const updateCompareBar = () => {
        if (!compareBar || !compareCount) return;
        if (selectedCompareGrades.length > 0) {
          compareBar.classList.remove('hidden');
          compareCount.textContent = `${selectedCompareGrades.length} selected`;
        } else {
          compareBar.classList.add('hidden');
          closeCompare();
        }
      };

      const bindCompareEvents = () => {
        document.querySelectorAll('.compare-checkbox').forEach((chk) => {
          chk.addEventListener('change', (e) => {
            const gradeName = (e.target as HTMLInputElement).getAttribute('data-grade') || '';
            if ((e.target as HTMLInputElement).checked) {
              if (selectedCompareGrades.length >= 3) {
                alert('You can compare a maximum of 3 commercial grades simultaneously.');
                (e.target as HTMLInputElement).checked = false;
                return;
              }
              if (!selectedCompareGrades.includes(gradeName)) selectedCompareGrades.push(gradeName);
            } else {
              selectedCompareGrades = selectedCompareGrades.filter(g => g !== gradeName);
            }
            updateCompareBar();
          });
        });
      };

      const handleClearAll = () => {
        selectedCompareGrades = [];
        document.querySelectorAll('.compare-checkbox').forEach((chk) => { (chk as HTMLInputElement).checked = false; });
        updateCompareBar();
        closeCompare();
      };

      clearCompareBtn?.addEventListener('click', handleClearAll);
      modalClearBtn?.addEventListener('click', handleClearAll);

      const openCompareModal = () => {
        if (!compareModal || !compareModalBackdrop || !compareTableContainer) return;
        const matchingResins = allGrades.filter((r: any) => selectedCompareGrades.includes(`${r.mfg} ${r.grade}`));
        if (matchingResins.length === 0) {
          alert('Please select at least one commercial grade to compare.');
          return;
        }

        let tableHtml = `
          <table class="w-full text-left border-collapse text-xs font-mono">
            <thead>
              <tr class="bg-slate-950 border-b border-slate-800 text-white">
                <th class="py-3.5 px-5 uppercase font-bold w-1/4">Technical Metric</th>
                ${matchingResins.map((r: any) => `
                  <th class="py-3.5 px-5 font-black">
                    <span class="text-[10px] text-slate-400 block">${r.mfg}</span>
                    <span class="text-sm text-orange-400">${r.grade}</span>
                  </th>
                `).join('')}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800 text-slate-200">
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Polymer Family</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-bold text-white">${r.familyCode} (${r.familyName})</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Category</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 uppercase font-semibold text-slate-300">${r.categoryLabel}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Continuous Temp</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-bold text-white text-sm">${r.temp}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Tensile Strength</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-bold text-white text-sm">${r.tensile}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Anisotropic Shrinkage</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-bold text-orange-400">Flow: ${r.shrinkageFlow}<br/>X-flow: ${r.shrinkageCross}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Tooling Steel Match</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-bold text-orange-300">${r.toolingSteel}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Compliance & Cert</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 text-slate-300">${r.cert}</td>`).join('')}
              </tr>
              <tr>
                <td class="py-3 px-5 font-bold text-slate-400 bg-slate-950/60">Key Advantage</td>
                ${matchingResins.map((r: any) => `<td class="py-3 px-5 font-sans text-xs text-emerald-400 font-bold bg-emerald-950/40">✓ ${r.feature}</td>`).join('')}
              </tr>
            </tbody>
          </table>
        `;
        compareTableContainer.innerHTML = tableHtml;
        compareModal.classList.remove('hidden');
        compareModalBackdrop.classList.remove('hidden');
        setTimeout(() => {
          compareModal.classList.remove('scale-95', 'opacity-0');
          compareModal.classList.add('scale-100', 'opacity-100');
        }, 10);
      };

      const closeCompare = () => {
        if (!compareModal || !compareModalBackdrop) return;
        compareModal.classList.remove('scale-100', 'opacity-100');
        compareModal.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          compareModal.classList.add('hidden');
          compareModalBackdrop.classList.add('hidden');
        }, 200);
      };

      triggerCompareModal?.addEventListener('click', openCompareModal);
      closeCompareModal?.addEventListener('click', closeCompare);
      compareModalBackdrop?.addEventListener('click', closeCompare);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCompare();
      });

      compareToRfqBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        closeCompare();
        const rfqInput = document.getElementById('rfq-resin-input') as HTMLInputElement | null;
        if (rfqInput) rfqInput.value = selectedCompareGrades.join(' vs. ');
        document.getElementById('rfq')?.scrollIntoView({ behavior: 'smooth' });
      });

      const applyUnitsToDOM = () => {
        document.querySelectorAll('.val-temp').forEach((el) => {
          const raw = el.closest('[data-temp-c]')?.getAttribute('data-temp-c') || '';
          if (!isImperial) {
            el.textContent = raw;
          } else {
            el.textContent = raw.replace(/(\d+)°C/g, (_, c) => `${Math.round(Number(c) * 1.8 + 32)}°F`);
          }
        });
        document.querySelectorAll('.val-tensile').forEach((el) => {
          const raw = el.closest('[data-tensile-mpa]')?.getAttribute('data-tensile-mpa') || '';
          if (!isImperial) {
            el.textContent = raw;
          } else {
            el.textContent = raw.replace(/(\d+)\s*-\s*(\d+)\s*MPa/g, (_, a, b) => `${Math.round(Number(a) * 0.145)}k-${Math.round(Number(b) * 0.145)}k psi`);
          }
        });
      };

      const createCardHtml = (r: any) => `
        <article class="resin-card group obsidian-card rounded-2xl overflow-hidden flex flex-col justify-between relative" data-temp-c="${r.temp}" data-tensile-mpa="${r.tensile}">
          <div class="absolute top-3 right-3 z-10 flex items-center gap-1.5 bg-slate-900/90 backdrop-blur-xs px-2.5 py-1 rounded-md border border-slate-700 shadow-3xs">
            <input type="checkbox" class="compare-checkbox w-3.5 h-3.5 accent-[#EA580C] cursor-pointer" data-slug="${r.slug}" data-grade="${r.mfg} ${r.grade}" ${selectedCompareGrades.includes(`${r.mfg} ${r.grade}`) ? 'checked' : ''} />
            <span class="text-[9px] font-mono text-slate-300 uppercase font-bold tracking-wider">Compare</span>
          </div>
          <div>
            <div class="p-5 pb-3.5 border-b border-slate-800 bg-gradient-to-r from-slate-900/90 via-slate-900/50 to-orange-950/30">
              <div class="flex items-center gap-2 mb-2">
                <span class="px-2 py-0.5 bg-[#EA580C] text-white text-[9px] font-black tracking-widest rounded-xs uppercase">${r.mfg}</span>
                <span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest font-bold">${r.categoryLabel}</span>
              </div>
              <h2 class="text-base sm:text-lg font-black text-white group-hover:text-orange-400 transition-colors leading-tight truncate pr-16" title="${r.grade}">${r.grade}</h2>
              <div class="text-[10px] font-mono text-emerald-400 font-bold mt-1.5 line-clamp-1 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-500/30">✓ ${r.feature}</div>
            </div>
            <div class="p-5">
              <div class="flex flex-col gap-0.5 mb-3.5 p-3 bg-slate-900/90 rounded-xl border border-slate-800 font-mono">
                <span class="text-[8.5px] text-slate-400 uppercase font-bold">Base Polymer Family</span>
                <span class="text-xs font-bold text-orange-300 truncate">${r.familyCode} (${r.familyName})</span>
              </div>
              <div class="space-y-2.5 text-[11px] font-mono">
                <div class="flex justify-between items-center text-slate-300"><span class="text-slate-400 font-medium">Continuous Temp:</span><span class="font-bold text-white val-temp">${r.temp}</span></div>
                <div class="flex justify-between items-center text-slate-300"><span class="text-slate-400 font-medium">Tensile Strength:</span><span class="font-bold text-white val-tensile">${r.tensile}</span></div>
                <div class="flex justify-between items-center text-slate-300 pt-2 border-t border-slate-800">
                  <span class="text-slate-400 font-medium">Shrink (Flow / X):</span>
                  <div class="flex items-center gap-1 font-bold text-[10px]">
                    <span class="px-1.5 py-0.5 rounded shrink-badge-flow" title="Parallel to Flow">${r.shrinkageFlow} (Flow)</span>
                    <span class="px-1.5 py-0.5 rounded shrink-badge-cross" title="Transverse to Flow">${r.shrinkageCross} (X)</span>
                  </div>
                </div>
                <div class="flex justify-between items-center text-slate-300 pt-1.5 border-t border-slate-800/80">
                  <span class="text-slate-400 font-medium text-[10px]">Tooling Steel:</span>
                  <span class="font-bold text-orange-300 truncate max-w-[145px]" title="${r.toolingSteel}">${r.toolingSteel}</span>
                </div>
                <div class="flex justify-between items-center text-slate-300 pt-1">
                  <span class="text-slate-400 font-medium">Standard / Cert:</span>
                  <span class="font-bold text-slate-200 truncate max-w-[130px]">${r.cert}</span>
                </div>
              </div>
            </div>
          </div>
          <div class="p-3.5 bg-slate-900/60 border-t border-slate-800 mt-auto flex items-center gap-2">
            <a href="${prefix}/materials/${r.slug}" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-[10px] font-mono font-bold uppercase rounded-xl transition-all shadow-3xs">Datasheet</a>
            <button class="quote-spec-btn flex-1 py-2 bg-[#EA580C] hover:bg-orange-600 text-white text-[10px] font-mono font-bold uppercase rounded-xl transition-all cursor-pointer shadow-md" data-resin="${r.mfg} ${r.grade}">Quote this Grade</button>
          </div>
        </article>
      `;

      const createTableRowHtml = (r: any) => `
        <tr class="hover:bg-slate-800/50 transition-colors" data-temp-c="${r.temp}" data-tensile-mpa="${r.tensile}">
          <td class="py-3.5 px-5 font-bold text-slate-300">${r.mfg}</td>
          <td class="py-3.5 px-5 font-black text-white text-sm">${r.grade}</td>
          <td class="py-3.5 px-5 font-medium text-emerald-400">${r.feature}</td>
          <td class="py-3.5 px-5"><span class="bg-slate-950 px-2 py-1 rounded text-[10px] font-bold border border-slate-800 text-orange-300">${r.familyCode}</span></td>
          <td class="py-3.5 px-5 text-orange-300 font-bold">${r.toolingSteel}</td>
          <td class="py-3.5 px-5 val-temp text-white">${r.temp}</td>
          <td class="py-3.5 px-5 val-tensile text-white">${r.tensile}</td>
          <td class="py-3.5 px-5 text-orange-400 font-bold">${r.shrinkageFlow} / ${r.shrinkageCross}</td>
          <td class="py-3.5 px-5 text-right">
            <button class="quote-spec-btn px-3 py-1.5 bg-[#EA580C] hover:bg-orange-600 text-white text-[9px] font-black uppercase rounded-lg transition-all cursor-pointer shadow-sm" data-resin="${r.mfg} ${r.grade}">Select</button>
          </td>
        </tr>
      `;

      const bindQuoteEvents = () => {
        document.querySelectorAll('.quote-spec-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const resin = (btn as HTMLElement).getAttribute('data-resin') || '';
            const rfqResinInput = document.getElementById('rfq-resin-input') as HTMLInputElement | null;
            if (rfqResinInput) rfqResinInput.value = resin;
            document.getElementById('rfq')?.scrollIntoView({ behavior: 'smooth' });
          });
        });
      };

      // 👑 终端自适应分页控件渲染器（带滚动回顶部功能）
      const renderPaginationControls = (totalItems: number) => {
        if (!paginationContainer) return;
        const pageSize = getPageSize();
        const totalPages = Math.ceil(totalItems / pageSize) || 1;

        if (totalPages <= 1) {
          paginationContainer.innerHTML = `<div class="text-xs text-slate-400 font-mono w-full text-center sm:text-left">Showing all <span class="font-bold text-white">${totalItems}</span> qualified commercial grades</div>`;
          return;
        }

        const startItem = (currentPage - 1) * pageSize + 1;
        const endItem = Math.min(currentPage * pageSize, totalItems);

        paginationContainer.innerHTML = `
          <div class="text-xs text-slate-400 font-mono text-center sm:text-left">
            Showing <span class="font-bold text-white">${startItem}</span> - <span class="font-bold text-white">${endItem}</span> of <span class="font-bold text-white">${totalItems}</span> grades
          </div>
          <div class="flex items-center justify-center gap-2 font-mono w-full sm:w-auto">
            <button id="prev-page-btn" class="px-4 py-2 bg-slate-900 border border-slate-700 hover:border-[#EA580C] text-slate-200 font-bold text-xs uppercase rounded-xl disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer shadow-sm" ${currentPage === 1 ? 'disabled' : ''}>
              &larr; Prev
            </button>
            <span class="px-3.5 py-2 bg-slate-900 border border-slate-800 text-white font-bold text-xs rounded-xl shadow-3xs whitespace-nowrap">
              Page ${currentPage} / ${totalPages}
            </span>
            <button id="next-page-btn" class="px-4 py-2 bg-slate-900 border border-slate-700 hover:border-[#EA580C] text-slate-200 font-bold text-xs uppercase rounded-xl disabled:opacity-30 disabled:cursor-not-allowed transition-all cursor-pointer shadow-sm" ${currentPage === totalPages ? 'disabled' : ''}>
              Next &rarr;
            </button>
          </div>
        `;

        document.getElementById('prev-page-btn')?.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderData(activeFilteredGrades);
            document.getElementById('materials-database')?.scrollIntoView({ behavior: 'smooth' });
          }
        });

        document.getElementById('next-page-btn')?.addEventListener('click', () => {
          if (currentPage < totalPages) {
            currentPage++;
            renderData(activeFilteredGrades);
            document.getElementById('materials-database')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      };

      const renderData = (items: any[]) => {
        if (!grid || !tableBody) return;
        activeFilteredGrades = items;
        const pageSize = getPageSize();

        const totalPages = Math.ceil(items.length / pageSize) || 1;
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * pageSize;
        const paginatedItems = items.slice(startIndex, startIndex + pageSize);

        // 👑 严格限制当页切片渲染
        grid.innerHTML = paginatedItems.map(createCardHtml).join('');
        tableBody.innerHTML = paginatedItems.map(createTableRowHtml).join('');
        
        if (countAll) countAll.textContent = String(items.length);
        if (noResults) noResults.style.display = items.length === 0 ? 'block' : 'none';
        
        renderPaginationControls(items.length);

        applyUnitsToDOM();
        bindQuoteEvents();
        bindCompareEvents();
      };

      const applyFilters = () => {
        currentPage = 1;
        const queryTokens = currentQuery.split(' ').filter(Boolean);
        const filtered = allGrades.filter((r: any) => {
          const matchCat = currentCategory === 'all' || r.category === currentCategory;
          const matchInd = currentIndustry === 'all' || (r.industries && r.industries.includes(currentIndustry));
          const searchCorpus = `${r.mfg} ${r.grade} ${r.familyCode} ${r.familyName} ${r.feature} ${r.applications?.join(' ')}`.toLowerCase();
          const matchQuery = queryTokens.length === 0 || queryTokens.every(token => searchCorpus.includes(token));
          return matchCat && matchInd && matchQuery;
        });

        renderData(filtered);
      };

      let debounceTimer: ReturnType<typeof setTimeout>;
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
            applyFilters();
          }, 150);
        });
      }

      const executeSearch = (query: string) => {
        if (searchInput) searchInput.value = query;
        if (heroSearchInput) heroSearchInput.value = query;
        currentQuery = query.toLowerCase().trim();
        applyFilters();
        document.getElementById('materials-database')?.scrollIntoView({ behavior: 'smooth' });
      };

      if (heroJumpBtn && heroSearchInput) {
        heroJumpBtn.addEventListener('click', () => executeSearch(heroSearchInput.value.trim()));
        heroSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') executeSearch(heroSearchInput.value.trim());
        });
      }

      chipBtns.forEach((chip) => {
        chip.addEventListener('click', () => {
          const val = chip.getAttribute('data-chip') || '';
          executeSearch(val);
        });
      });

      categoryBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          categoryBtns.forEach(b => {
            b.classList.remove('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
            b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-700');
          });
          btn.classList.add('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
          btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-700');
          currentCategory = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      industryBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          industryBtns.forEach(b => {
            b.classList.remove('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
            b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-700');
          });
          btn.classList.add('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
          btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-700');
          currentIndustry = btn.getAttribute('data-industry') || 'all';
          applyFilters();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          currentCategory = 'all';
          currentIndustry = 'all';
          currentQuery = '';
          currentPage = 1;
          if (searchInput) searchInput.value = '';
          if (heroSearchInput) heroSearchInput.value = '';
          
          industryBtns.forEach(b => {
            b.classList.remove('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
            b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-700');
          });
          const allIndBtn = document.querySelector('[data-industry="all"]');
          if (allIndBtn) {
            allIndBtn.classList.add('bg-[#EA580C]', 'text-white', 'border-[#EA580C]');
            allIndBtn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-700');
          }

          renderData(allGrades);
        });
      }

      const viewGridBtn = document.getElementById('view-grid-btn');
      const viewTableBtn = document.getElementById('view-table-btn');

      if (viewGridBtn && viewTableBtn && grid && tableWrapper) {
        viewGridBtn.addEventListener('click', () => {
          grid.classList.remove('hidden');
          tableWrapper.classList.add('hidden');
          viewGridBtn.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
          viewGridBtn.classList.remove('text-slate-400');
          viewTableBtn.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
          viewTableBtn.classList.add('text-slate-400');
        });

        viewTableBtn.addEventListener('click', () => {
          grid.classList.add('hidden');
          tableWrapper.classList.remove('hidden');
          viewTableBtn.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
          viewTableBtn.classList.remove('text-slate-400');
          viewGridBtn.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
          viewGridBtn.classList.add('text-slate-400');
        });
      }

      const unitMetricBtn = document.getElementById('unit-metric-btn');
      const unitImperialBtn = document.getElementById('unit-imperial-btn');

      if (unitMetricBtn && unitImperialBtn) {
        unitMetricBtn.addEventListener('click', () => {
          isImperial = false;
          unitMetricBtn.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
          unitMetricBtn.classList.remove('text-slate-400');
          unitImperialBtn.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
          unitImperialBtn.classList.add('text-slate-400');
          applyUnitsToDOM();
        });

        unitImperialBtn.addEventListener('click', () => {
          isImperial = true;
          unitImperialBtn.classList.add('bg-slate-800', 'text-white', 'shadow-sm');
          unitImperialBtn.classList.remove('text-slate-400');
          unitMetricBtn.classList.remove('bg-slate-800', 'text-white', 'shadow-sm');
          unitMetricBtn.classList.add('text-slate-400');
          applyUnitsToDOM();
        });
      }

      // FAQ 手风琴
      document.querySelectorAll('.faq-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const answer = btn.nextElementSibling as HTMLElement | null;
          const svg = btn.querySelector('svg');
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
          if (answer) answer.classList.toggle('hidden', isExpanded);
          if (svg) svg.classList.toggle('rotate-180', !isExpanded);
        });
      });

      // 监听屏幕尺寸变化自适应重绘分页
      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          renderData(activeFilteredGrades);
        }, 200);
      });

      // 初始化首屏渲染
      renderData(allGrades);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupMaterialsPage);
    } else {
      setupMaterialsPage();
    }
    document.addEventListener('astro:page-load', setupMaterialsPage);
  </script>

</body>
</html>