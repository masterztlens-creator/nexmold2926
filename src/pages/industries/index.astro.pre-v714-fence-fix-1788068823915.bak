          </button>
        </form>
      </div>
    </dialog>

    <script is:inline>
      document.addEventListener('mousemove', function(e) {
        const x = (e.clientX / window.innerWidth - 0.5) * 2;
        const y = (e.clientY / window.innerHeight - 0.5) * 2;
        document.documentElement.style.setProperty('--mx', x);
        document.documentElement.style.setProperty('--my', y);
      });

      document.addEventListener('click', function(e) {
        const sat = e.target.closest('.orbit-planet');
        if (!sat) return;

        const sunEl = document.getElementById('central-sun');
        if (!sunEl) return;

        const satData = {
          id: sat.getAttribute('data-id'),
          title: sat.getAttribute('data-title'),
          cat: sat.getAttribute('data-cat'),
          desc: sat.getAttribute('data-desc'),
          link: sat.getAttribute('data-link'),
          image: sat.getAttribute('data-image')
        };

        const sunData = {
          id: sunEl.getAttribute('data-id'),
          title: sunEl.getAttribute('data-title'),
          cat: sunEl.getAttribute('data-cat'),
          desc: sunEl.getAttribute('data-desc'),
          link: sunEl.getAttribute('data-link'),
          image: sunEl.getAttribute('data-image')
        };

        if (!satData.id || !sunData.id) return;

        const sunWrap = document.getElementById('sun-texture-wrap');
        const satWrap = sat.querySelector('.sat-texture-wrap');
        
        if (sunWrap) { sunWrap.classList.remove('card-flash-anim'); void sunWrap.offsetWidth; sunWrap.classList.add('card-flash-anim'); }
        if (satWrap) { satWrap.classList.remove('card-flash-anim'); void satWrap.offsetWidth; satWrap.classList.add('card-flash-anim'); }

        setTimeout(() => {
          sunEl.setAttribute('data-id', satData.id);
          sunEl.setAttribute('data-title', satData.title);
          sunEl.setAttribute('data-cat', satData.cat);
          sunEl.setAttribute('data-desc', satData.desc);
          sunEl.setAttribute('data-link', satData.link);
          sunEl.setAttribute('data-image', satData.image);

          sat.setAttribute('data-id', sunData.id);
          sat.setAttribute('data-title', sunData.title);
          sat.setAttribute('data-cat', sunData.cat);
          sat.setAttribute('data-desc', sunData.desc);
          sat.setAttribute('data-link', sunData.link);
          sat.setAttribute('data-image', sunData.image);

          document.getElementById('sun-img-bg').style.backgroundImage = `url('${satData.image}')`;
          document.getElementById('sun-cat-text').textContent = satData.cat;
          document.getElementById('sun-title-text').textContent = satData.title;

          sat.querySelector('.planet-texture').style.backgroundImage = `url('${satData.image}')`;
          sat.querySelector('.sat-cat-text').textContent = sunData.cat;
          sat.querySelector('.sat-title-text').textContent = sunData.title;

          document.getElementById('panel-title').textContent = satData.title;
          document.getElementById('panel-desc').textContent = satData.desc;
          document.getElementById('panel-link').setAttribute('href', satData.link);

          const detailsWrapper = document.getElementById('sun-details-wrapper');
          if (detailsWrapper) {
            detailsWrapper.classList.remove('card-flash-anim');
            void detailsWrapper.offsetWidth; 
            detailsWrapper.classList.add('card-flash-anim');
          }
        }, 200);
      });
      
      window.NEXMOLD_OPEN_LEAD_MODAL = function() {
        const modal = document.getElementById('lead-modal');
        if (modal && typeof modal.showModal === 'function') {
          modal.showModal();
        } else {
          alert('Opening RFQ portal...');
        }
      };
      
      document.addEventListener('DOMContentLoaded', () => {
         const closeBtn = document.getElementById('close-modal-btn');
         const modal = document.getElementById('lead-modal');
         if (closeBtn && modal) {
            closeBtn.addEventListener('click', () => {
               if (typeof modal.close === 'function') modal.close();
            });
         }
      });
    </script>
  </body>
</html>