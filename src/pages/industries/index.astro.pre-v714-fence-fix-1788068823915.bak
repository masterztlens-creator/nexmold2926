            <textarea rows="3" placeholder="e.g., ABS material, 5,000 pcs, T1 needed in 10 days" class="w-full px-3 py-2 text-xs border border-[#0F2B5B]/20 focus:border-[#EA580C] focus:outline-none rounded-xs"></textarea>
          </div>
          <button type="submit" class="w-full bg-[#EA580C] hover:bg-[#C2410C] text-white font-mono text-xs font-black uppercase py-3 tracking-widest transition-colors rounded-xs cursor-pointer">
