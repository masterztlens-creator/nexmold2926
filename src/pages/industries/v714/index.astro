---
import MainLayout from "../../../layouts/MainLayout.astro";
import fs from "node:fs";
import path from "node:path";
import {
  runRuntimePublicationGate,
} from "../../../regional/v714-runtime-publication-gate.ts";
import type {
  PublicationMetadata,
  PublicationReport,
  PublicationReportItem,
} from "../../../regional/v714-runtime-publication-gate.ts";

interface ArticleFrontmatter {
  title?: string;
  description?: string;
  category?: string;
  slug?: string;
  seoKeywords?: string | string[];
  [key: string]: unknown;
}

interface WhitePaperArticle {
  slug: string;
  title: string;
  description: string;
  category: string;
  keywords: string[];
  publicationStatus: string;
  pageContentHash: string;
}

const ROOT = process.cwd();
const FACTORY_DIR = path.join(
  ROOT,
  ".nexmold",
  "content-factory",
  "batch-01-v3",
);
const REPORT_FILE = path.join(FACTORY_DIR, "production-report.json");

function readJson(file: string): unknown {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return null;
  }
}

/**
 * ------------------------------------------------------------
 * Safe frontmatter parser
 * ------------------------------------------------------------
 */

function parseFrontmatter(
  markdown: string,
): ArticleFrontmatter {
  const match = markdown.match(
    /^---\s*([\s\S]*?)\s*---/,
  );

  if (!match) {
    return {};
  }

  const result: ArticleFrontmatter = {};

  for (const line of match[1].split(/\r?\n/)) {
    const separator = line.indexOf(":");

    if (separator <= 0) {
      continue;
    }

    const key = line
      .slice(0, separator)
      .trim();

    let value = line
      .slice(separator + 1)
      .trim();

    if (
      value.startsWith('"') &&
      value.endsWith('"')
    ) {
      value = value.slice(1, -1);
    }

    if (
      value.startsWith("'") &&
      value.endsWith("'")
    ) {
      value = value.slice(1, -1);
    }

    result[key] = value;
  }

  return result;
}

/**
 * ------------------------------------------------------------
 * Keyword extraction
 * ------------------------------------------------------------
 */

function extractKeywords(
  frontmatter: ArticleFrontmatter,
): string[] {
  const raw =
    frontmatter.seoKeywords;

  if (Array.isArray(raw)) {
    return raw
      .map((item) => String(item).trim())
      .filter(Boolean);
  }

  if (typeof raw === "string") {
    return raw
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean);
  }

  return [];
}

/**
 * ------------------------------------------------------------
 * Article discovery
 * ------------------------------------------------------------
 *
 * IMPORTANT:
 *
 * This page is only an aggregation layer.
 *
 * It does not generate content.
 * It does not mutate content.
 * It does not publish content.
 *
 * Article pages remain:
 *
 * /industries/v714/[slug]/
 * ------------------------------------------------------------
 */

let articles: WhitePaperArticle[] = [];

if (fs.existsSync(FACTORY_DIR) && fs.existsSync(REPORT_FILE)) {
  const report = readJson(REPORT_FILE) as PublicationReport | null;

  const reportBySlug = new Map(
    Array.isArray(report?.results)
      ? report.results.map((item) => [String(item.slug ?? item.targetSlug ?? ""), item])
      : [],
  );

  const files = fs
    .readdirSync(FACTORY_DIR)
    .filter(
      (file) =>
        file.endsWith(".md") &&
        file !== "production-report.md",
    )
    .sort();

  articles = files
    .map((file) => {
      const fullPath = path.join(FACTORY_DIR, file);
      const markdown = fs.readFileSync(fullPath, "utf8");
      const frontmatter = parseFrontmatter(markdown);
      const slug = String(frontmatter.slug || file.replace(/\.md$/, "")).trim();

      if (!slug) {
        return null;
      }

      const metadataPath = path.join(FACTORY_DIR, `${slug}.json`);
      const metadata = readJson(metadataPath) as PublicationMetadata | null;
      const reportItem = reportBySlug.get(slug) as PublicationReportItem | null;
      const gate = runRuntimePublicationGate(
        metadata,
        reportItem,
        slug,
      );

      if (!gate.ok) {
        return null;
      }

      const title = String(
        frontmatter.title ||
          slug
            .replace(/-/g, " ")
            .replace(/\b\w/g, (char) => char.toUpperCase()),
      ).trim();

      const description = String(frontmatter.description || "").trim();
      const category = String(
        frontmatter.category || "Injection Molding Engineering",
      ).trim();
      const keywords = extractKeywords(frontmatter);

      return {
        slug,
        title,
        description,
        category,
        keywords,
        publicationStatus: "AUTHORIZED",
        pageContentHash: String(metadata?.artifact?.pageContentHash ?? ""),
      };
    })
    .filter(
      (article): article is WhitePaperArticle => Boolean(article),
    );
}

/**
 * ------------------------------------------------------------
 * Category normalization
 * ------------------------------------------------------------
 */

function classifyArticle(
  article: WhitePaperArticle,
): string {
  const text = (
    article.title +
    " " +
    article.slug +
    " " +
    article.category
  ).toLowerCase();

  if (
    text.includes("wall thickness") ||
    text.includes("rib") ||
    text.includes("boss") ||
    text.includes("corner radius") ||
    text.includes("undercut") ||
    text.includes("parting line") ||
    text.includes("gate location")
  ) {
    return "Part Design & DFM";
  }

  if (
    text.includes("sink mark") ||
    text.includes("warpage") ||
    text.includes("weld line") ||
    text.includes("cavity balance") ||
    text.includes("cycle time")
  ) {
    return "Process Engineering";
  }

  if (
    text.includes("s136") ||
    text.includes("nak80") ||
    text.includes("mold steel") ||
    text.includes("conformal cooling")
  ) {
    return "Tooling & Mold Engineering";
  }

  if (
    text.includes("abs") ||
    text.includes("pc") ||
    text.includes("material")
  ) {
    return "Materials & Application Engineering";
  }

  return "Injection Molding Engineering";
}

/**
 * ------------------------------------------------------------
 * White paper taxonomy
 * ------------------------------------------------------------
 */

const taxonomy = [
  {
    key: "Part Design & DFM",
    title:
      "Part Design & DFM",
    description:
      "Design decisions that determine manufacturability, tooling complexity, dimensional stability and injection molding risk.",
  },
  {
    key: "Tooling & Mold Engineering",
    title:
      "Tooling & Mold Engineering",
    description:
      "Mold steel, cooling, parting strategy and tooling architecture for production injection molds.",
  },
  {
    key: "Process Engineering",
    title:
      "Process Engineering",
    description:
      "Injection molding defects, process windows, cycle time, filling behavior and production stability.",
  },
  {
    key:
      "Materials & Application Engineering",
    title:
      "Materials & Application Engineering",
    description:
      "Material-specific design considerations for engineering thermoplastics and demanding molded applications.",
  },
];

/**
 * ------------------------------------------------------------
 * Group articles
 * ------------------------------------------------------------
 */

const groups = taxonomy.map(
  (section) => ({
    ...section,
    articles: articles.filter(
      (article) =>
        classifyArticle(article) ===
        section.key,
    ),
  }),
);

/**
 * Articles not captured by the primary taxonomy.
 */
const classifiedSlugs = new Set(
  groups.flatMap((group) =>
    group.articles.map(
      (article) => article.slug,
    ),
  ),
);

const otherArticles =
  articles.filter(
    (article) =>
      !classifiedSlugs.has(
        article.slug,
      ),
  );

/**
 * ------------------------------------------------------------
 * Production metadata
 * ------------------------------------------------------------
 */

const producedCount = articles.length;

/**
 * ------------------------------------------------------------
 * SEO metadata
 * ------------------------------------------------------------
 */

const pageTitle =
  "Injection Molding Industry White Papers | NEXMOLD";

const pageDescription =
  "Original engineering white papers covering plastic injection molding, DFM, mold design, tooling, materials, process engineering, molding defects and production optimization.";

const canonicalUrl =
  "https://www.nexmold.com/industries/v714/";

const collectionStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "inLanguage": "en-US",
  "isPartOf": {
    "@type": "WebSite",
    "name": "NEXMOLD",
    "url": "https://www.nexmold.com/",
  },
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <script
    is:inline
    type="application/ld+json"
    id="v714-collection-schema"
    set:html={JSON.stringify(collectionStructuredData)}
  />

  <main class="whitepaper-page">

    <!-- ======================================================
         HERO
         ====================================================== -->

    <section class="whitepaper-hero">
      <div class="whitepaper-container">

        <div class="whitepaper-eyebrow">
          NEXMOLD INDUSTRY WHITE PAPERS
        </div>

        <h1>
          Injection Molding
          <span>Engineering White Papers</span>
        </h1>

        <p class="whitepaper-lead">
          An engineering reference library for
          plastic injection molding design,
          tooling, materials, process engineering,
          defect prevention and production
          optimization.
        </p>

        <div class="whitepaper-hero-grid">

          <div class="whitepaper-hero-intro">
            <p>
              NEXMOLD white papers are structured
              around the engineering decisions that
              determine whether an injection molded
              part is manufacturable, dimensionally
              stable, cost-effective and suitable for
              production.
            </p>

            <p>
              The objective is not to publish generic
              manufacturing content. Each subject is
              organized around engineering variables,
              failure mechanisms, design constraints,
              tooling implications and practical
              manufacturing decisions.
            </p>
          </div>

          <div class="whitepaper-facts">

            <div class="whitepaper-fact">
              <strong>
                {articles.length}
              </strong>
              <span>
                White Paper Topics
              </span>
            </div>

            <div class="whitepaper-fact">
              <strong>
                4
              </strong>
              <span>
                Engineering Domains
              </span>
            </div>

            <div class="whitepaper-fact">
              <strong>
                DFM
              </strong>
              <span>
                Design-to-Production Focus
              </span>
            </div>

            <div class="whitepaper-fact">
              <strong>
                US
              </strong>
              <span>
                Primary Regional Perspective
              </span>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- ======================================================
         EDITORIAL POSITION
         ====================================================== -->

    <section class="whitepaper-position">
      <div class="whitepaper-container">

        <div class="section-kicker">
          ENGINEERING REFERENCE
        </div>

        <div class="position-grid">

          <div>
            <h2>
              From part geometry
              to production reality
            </h2>
          </div>

          <div>
            <p>
              Injection molding performance is not
              determined by a single parameter.
              Wall thickness, rib geometry, draft,
              radii, gate position, material behavior,
              mold construction, cooling and process
              conditions interact as one manufacturing
              system.
            </p>

            <p>
              These white papers examine those
              relationships so engineers, product
              designers, sourcing teams and
              manufacturing professionals can make
              better decisions before tooling and
              production begin.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ======================================================
         KNOWLEDGE ARCHITECTURE
         ====================================================== -->

    <section class="whitepaper-domains">
      <div class="whitepaper-container">

        <div class="section-heading">
          <div>
            <div class="section-kicker">
              WHITE PAPER LIBRARY
            </div>

            <h2>
              Injection Molding
              Engineering Domains
            </h2>
          </div>

          <p>
            Explore the technical subjects by
            engineering domain.
          </p>
        </div>


        <div class="domain-grid">

          {
            groups.map(
              (group, index) => (
                <section
                  class="domain-card"
                  id={`domain-${index + 1}`}
                >

                  <div class="domain-number">
                    {String(index + 1).padStart(
                      2,
                      "0",
                    )}
                  </div>

                  <h3>
                    {group.title}
                  </h3>

                  <p>
                    {group.description}
                  </p>

                  <div class="domain-count">
                    {group.articles.length}
                    {" "}
                    {group.articles.length === 1
                      ? "White Paper"
                      : "White Papers"}
                  </div>

                </section>
              ),
            )
          }

        </div>

      </div>
    </section>


    <!-- ======================================================
         ARTICLES
         ====================================================== -->

    <section class="whitepaper-library">
      <div class="whitepaper-container">

        <div class="library-header">

          <div>
            <div class="section-kicker">
              TECHNICAL LIBRARY
            </div>

            <h2>
              Injection Molding
              White Papers
            </h2>
          </div>

          <p>
            Engineering references covering
            design, tooling, materials and
            process optimization.
          </p>

        </div>


        {
          groups.map(
            (group) =>
              group.articles.length > 0 && (
                <section
                  class="library-section"
                >

                  <div class="library-section-header">

                    <h3>
                      {group.title}
                    </h3>

                    <span>
                      {group.articles.length}
                      {" "}
                      topics
                    </span>

                  </div>


                  <div class="article-grid">

                    {
                      group.articles.map(
                        (article) => (
                          <article
                            class="article-card"
                          >

                            <div class="article-card-top">

                              <span class="article-type">
                                WHITE PAPER
                              </span>

                              <span class="article-domain">
                                {group.title}
                              </span>

                            </div>

                            <h4>
                              <a
                                href={`/industries/v714/${article.slug}/`}
                              >
                                {article.title}
                              </a>
                            </h4>

                            {
                              article.description && (
                                <p>
                                  {
                                    article.description
                                  }
                                </p>
                              )
                            }

                            {
                              article.keywords.length >
                                0 && (
                                <div class="article-keywords">
                                  {
                                    article.keywords
                                      .slice(
                                        0,
                                        4,
                                      )
                                      .map(
                                        (
                                          keyword,
                                        ) => (
                                          <span>
                                            {keyword}
                                          </span>
                                        ),
                                      )
                                  }
                                </div>
                              )
                            }

                            <a
                              class="article-read"
                              href={`/industries/v714/${article.slug}/`}
                            >
                              Read White Paper
                              <span aria-hidden="true">
                                →
                              </span>
                            </a>

                          </article>
                        ),
                      )
                    }

                  </div>

                </section>
              ),
          )
        }


        {
          otherArticles.length > 0 && (
            <section class="library-section">

              <div class="library-section-header">

                <h3>
                  Additional Engineering Topics
                </h3>

                <span>
                  {otherArticles.length}
                  {" "}
                  topics
                </span>

              </div>

              <div class="article-grid">

                {
                  otherArticles.map(
                    (article) => (
                      <article
                        class="article-card"
                      >

                        <div class="article-card-top">
                          <span class="article-type">
                            WHITE PAPER
                          </span>
                        </div>

                        <h4>
                          <a
                            href={`/industries/v714/${article.slug}/`}
                          >
                            {article.title}
                          </a>
                        </h4>

                        {
                          article.description && (
                            <p>
                              {
                                article.description
                              }
                            </p>
                          )
                        }

                        <a
                          class="article-read"
                          href={`/industries/v714/${article.slug}/`}
                        >
                          Read White Paper
                          <span aria-hidden="true">
                            →
                          </span>
                        </a>

                      </article>
                    ),
                  )
                }

              </div>

            </section>
          )
        }

      </div>
    </section>


    <!-- ======================================================
         WHY WHITE PAPERS
         ====================================================== -->

    <section class="whitepaper-methodology">
      <div class="whitepaper-container">

        <div class="section-kicker">
          HOW TO USE THIS LIBRARY
        </div>

        <div class="methodology-grid">

          <div class="methodology-intro">

            <h2>
              Engineering knowledge
              should answer decisions,
              not just questions.
            </h2>

            <p>
              A useful injection molding reference
              connects the design decision to its
              manufacturing consequence.
            </p>

          </div>


          <div class="methodology-list">

            <div class="methodology-item">
              <span>01</span>

              <div>
                <h3>
                  Design Constraint
                </h3>

                <p>
                  Identify the geometry,
                  material or process variable
                  that controls manufacturability.
                </p>
              </div>
            </div>


            <div class="methodology-item">
              <span>02</span>

              <div>
                <h3>
                  Manufacturing Mechanism
                </h3>

                <p>
                  Explain how the variable affects
                  filling, packing, cooling,
                  ejection, tooling or dimensional
                  stability.
                </p>
              </div>
            </div>


            <div class="methodology-item">
              <span>03</span>

              <div>
                <h3>
                  Production Consequence
                </h3>

                <p>
                  Connect the engineering decision
                  to tooling cost, cycle time,
                  quality risk and production
                  repeatability.
                </p>
              </div>
            </div>


            <div class="methodology-item">
              <span>04</span>

              <div>
                <h3>
                  Practical Decision
                </h3>

                <p>
                  Give engineers a usable framework
                  for selecting the appropriate
                  design or manufacturing approach.
                </p>
              </div>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- ======================================================
         TOPICAL AUTHORITY
         ====================================================== -->

    <section class="whitepaper-topical">
      <div class="whitepaper-container">

        <div class="topical-grid">

          <div>
            <div class="section-kicker">
              INJECTION MOLDING KNOWLEDGE SYSTEM
            </div>

            <h2>
              A technical reference layer
              for the injection molding
              industry.
            </h2>
          </div>

          <div>
            <p>
              The library is designed to connect
              related engineering concepts rather
              than treat every keyword as an isolated
              page.
            </p>

            <p>
              Part design connects to tooling.
              Tooling connects to process behavior.
              Process behavior connects to defects,
              material selection, cycle time and
              production quality.
            </p>

            <p>
              This structure allows the knowledge
              base to expand around engineering
              entities, relationships and real
              manufacturing decisions instead of
              producing disconnected keyword pages.
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- ======================================================
         CTA
         ====================================================== -->

    <section class="whitepaper-cta">
      <div class="whitepaper-container">

        <div class="cta-inner">

          <div>
            <div class="section-kicker">
              NEXMOLD ENGINEERING
            </div>

            <h2>
              Need to evaluate an
              injection molding project?
            </h2>

            <p>
              Apply the engineering principles in
              these white papers to your actual part,
              mold and production requirements.
            </p>
          </div>

          <a
            href="/capabilities/"
            class="cta-button"
          >
            Explore Manufacturing
            Capabilities
            <span aria-hidden="true">
              →
            </span>
          </a>

        </div>

      </div>
    </section>

  </main>
</MainLayout>


<style>
  /* =========================================================
     Base
     ========================================================= */

  .whitepaper-page {
    background: #ffffff;
    color: #111827;
  }

  .whitepaper-container {
    width: min(
      1180px,
      calc(100% - 48px)
    );
    margin: 0 auto;
  }

  .section-kicker {
    margin-bottom: 14px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #ff5722;
  }


  /* =========================================================
     Hero
     ========================================================= */

  .whitepaper-hero {
    padding: 110px 0 90px;
    border-bottom: 1px solid #e5e7eb;
  }

  .whitepaper-eyebrow {
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #ff5722;
  }

  .whitepaper-hero h1 {
    max-width: 1000px;
    margin: 0;
    font-size: clamp(
      48px,
      7vw,
      82px
    );
