<script>
  function initPageLogic() {
    const slider = document.getElementById('vernier-core');
    const coord = document.getElementById('coord-display');
    if (!slider || !coord) return;

    let targetY = 0;
    let currentY = 0;
    const lerpAmount = 0.1;

    const update = () => {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = maxScroll <= 0 ? 0 : Math.max(0, Math.min(scrollY / maxScroll, 1));
      
      if (scrollY < 100) {
        slider.style.opacity = "0";
      } else {
        slider.style.opacity = "1";
      }

      targetY = scrollPercent * 80; 
      currentY += (targetY - currentY) * lerpAmount;
      slider.style.transform = `translateY(${currentY}vh)`; 
      
      coord.textContent = (scrollPercent * 50).toFixed(3);
      
      requestAnimationFrame(update);
    };

    requestAnimationFrame(update);
  }

  document.addEventListener('DOMContentLoaded', initPageLogic);
  document.addEventListener('astro:after-swap', initPageLogic);
</script>

<style is:global>
  @keyframes laser-meteor {
    0% { transform: translateY(-40vh); opacity: 0; }
    10% { opacity: 1; }
    100% { transform: translateY(140vh); opacity: 0; }
  }
  .animate-laser-meteor { animation: laser-meteor 3s cubic-bezier(0.8, 0, 0.2, 1) infinite; }

  aside { background: transparent !important; }
  html { scroll-behavior: smooth; background-color: #FFFFFF; } 
</style>
