          <button type="submit" class="w-full bg-[#EA580C] hover:bg-[#C2410C] text-white font-mono text-xs font-black uppercase py-3 tracking-widest transition-colors rounded-xs cursor-pointer">
            Submit For Instant DFM & Quote
          </button>
        </form>
      </div>
    </dialog>

    <!-- 10. 交互脚本 -->
    <script>
      declare global {
        interface Window {
          NEXMOLD_OPEN_LEAD_MODAL?: (source?: string) => void;
        }
      }

      function initGalaxyConstellation() {
        const nodes = document.querySelectorAll('[data-galaxy-node]');
        const panels = document.querySelectorAll('[data-galaxy-panel]');

        nodes.forEach((node) => {
          node.addEventListener('click', () => {
            const step = node.getAttribute('data-galaxy-node');
            
            nodes.forEach((n) => {
              n.classList.remove('w-20', 'h-20', 'bg-[#EA580C]', 'border-white', 'text-white', 'shadow-[0_0_25px_rgba(234,88,12,0.9)]', 'scale-110', 'z-30', 'ring-2', 'ring-white');
              n.classList.add('w-16', 'h-16', 'bg-[#0F2B5B]/90', 'border-white/20', 'text-slate-200', 'z-20');
            });

            node.classList.remove('w-16', 'h-16', 'bg-[#0F2B5B]/90', 'border-white/20', 'text-slate-200', 'z-20');
            node.classList.add('w-20', 'h-20', 'bg-[#EA580C]', 'border-white', 'text-white', 'shadow-[0_0_25px_rgba(234,88,12,0.9)]', 'scale-110', 'z-30', 'ring-2', 'ring-white');

            panels.forEach((panel) => {
              if (panel.getAttribute('data-galaxy-panel') === step) {
                panel.classList.remove('hidden', 'opacity-0');
                panel.classList.add('block', 'opacity-100');
              } else {
                panel.classList.remove('block', 'opacity-100');
                panel.classList.add('hidden', 'opacity-0');
              }
            });
          });
        });
      }

      function initGlobalModal() {
        const modal = document.getElementById('lead-modal') as HTMLDialogElement | null;
        const closeBtn = document.getElementById('close-modal-btn');

        window.NEXMOLD_OPEN_LEAD_MODAL = function(source?: string) {
          if (modal && typeof modal.showModal === 'function') {
            modal.showModal();
          } else {
            alert('Opening RFQ portal...');
          }
        };

        if (closeBtn && modal) {
          closeBtn.onclick = function() {
            if (typeof modal.close === 'function') modal.close();
          };
          modal.onclick = function(e) {
            if (e.target === modal && typeof modal.close === 'function') {
              modal.close();
            }
          };
        }
      }

      initGalaxyConstellation();
      initGlobalModal();
      document.addEventListener('astro:after-swap', () => {
        initGalaxyConstellation();
        initGlobalModal();
      });
    </script>

  </body>
</html>