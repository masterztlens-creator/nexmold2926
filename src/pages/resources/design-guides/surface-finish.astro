---
/**
 * src/pages/resources/design-guides/surface-finish.astro
 * 👑 NEXMOLD 注塑表面处理与 SPI / VDI 纹理对照设计指南 (04 RESOURCES 核心节点)
 * 1. 架构定位：指导工程设计人员选择 SPI 抛光等级 (A1-D3) 与 VDI 24/34/42 模具蚀刻纹理
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：Quick Answer, SPI Finish Table, TechArticle Schema
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Injection Molding Surface Finish & SPI/VDI Texture Guide | NEXMOLD";
const description = "Comprehensive engineering guide for plastic injection molding surface finishes, SPI diamond mirror polishing (A1-A3), and VDI mold etching texture standards.";

// GEO JSON-LD Schema
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Plastic Injection Molding Surface Finish and SPI/VDI Texture Design Guidelines",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "NEXMOLD Precision Manufacturing"
  }
};
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Surface Finish Guide</span>
      </nav>

      <!-- 👑 GEO Quick Answer 核心框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          DESIGN_GUIDELINES // SPI_VDI_SURFACE_FINISH
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Injection Molding Surface Finish &<br/>
          <span class="text-[#EA580C]">SPI / VDI Texture Standard Guide</span>
        </h1>
        <!-- Featured Snippet Summary -->
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Plastic injection molding surface finishes are classified under <strong>SPI (Society of the Plastics Industry)</strong> standards ranging from high-gloss diamond mirror polish (SPI-A1) to matte stone finishes (SPI-D3), alongside European <strong>VDI 3400</strong> and <strong>Mold-Tech (MT)</strong> etching standards. Selecting proper finishes requires matching steel grades (such as ASSAB S136 for mirror optics) and adding adequate draft angles to prevent texture drag.
        </p>
      </section>

      <!-- SPI 抛光等级对照表 -->
      <section class="bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg mb-16">
        <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          SPI Surface Finish Classification & Tooling Requirements
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="bg-[#0F2B5B] text-white">
                <th class="p-3 border border-[#0F2B5B]">SPI Grade</th>
                <th class="p-3 border border-[#0F2B5B]">Finish Type</th>
                <th class="p-3 border border-[#0F2B5B]">Roughness (Ra µm)</th>
                <th class="p-3 border border-[#0F2B5B] text-[#EA580C]">Required Mold Preparation</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#0F2B5B]/10 text-[#0F2B5B]">
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold text-[#EA580C]">SPI-A1</td>
                <td class="p-3">Grade #3 Diamond Buff (Mirror)</td>
                <td class="p-3">0.012 µm (0.05 µin)</td>
                <td class="p-3">ASSAB S136 Hardened Steel + Diamond Paste Polish</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">SPI-A2</td>
                <td class="p-3">Grade #6 Diamond Buff</td>
                <td class="p-3">0.025 µm (1.0 µin)</td>
                <td class="p-3">Hardened Steel + Fine Diamond Buffing</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">SPI-B1</td>
                <td class="p-3">600 Grit Paper Polish (Semi-Gloss)</td>
                <td class="p-3">0.050 µm (2.0 µin)</td>
                <td class="p-3">Fine Emery Paper Polishing</td>
              </tr>
              <tr>
                <td class="p-3 font-bold">SPI-C1</td>
                <td class="p-3">600 Grit Stone Polish (Matte)</td>
                <td class="p-3">0.125 µm (5.0 µin)</td>
                <td class="p-3">Standard Stone Rubbing</td>
              </tr>
              <tr class="bg-[#FAFAFA]">
                <td class="p-3 font-bold">SPI-D3</td>
                <td class="p-3">Dry Blast Glass Bead</td>
                <td class="p-3">1.000 µm (40 µin)</td>
                <td class="p-3">Abrasive Blasting on Mold Surface</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 核心设计原则卡片 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans text-xs text-[#0F2B5B] mb-16">
        <div class="p-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl shadow-sm">
          <span class="text-[#EA580C] font-mono font-black text-sm block mb-2">RULE 01</span>
          <h3 class="font-bold text-sm text-[#0F2B5B] uppercase mb-2">Mirror Polish Steel Selection</h3>
          <p class="leading-relaxed text-[#0F2B5B]/80">Achieving SPI-A1/A2 mirror finishes requires high-purity Electro-Slag Remelted (ESR) stainless steel like ASSAB S136. Softer steels (like standard P20) contain microscopic inclusions that cause pinhole pitting during diamond buffing.</p>
        </div>

        <div class="p-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl shadow-sm">
          <span class="text-[#EA580C] font-mono font-black text-sm block mb-2">RULE 02</span>
          <h3 class="font-bold text-sm text-[#0F2B5B] uppercase mb-2">Texture Draft Angle Compensation</h3>
          <p class="leading-relaxed text-[#0F2B5B]/80">Textured mold surfaces create high frictional drag during part ejection. For every 0.025mm (0.001 in) of texture depth (such as VDI 3400 or Mold-Tech finishes), engineers must add an extra 1.0° to 1.5° of draft angle per side.</p>
        </div>

        <div class="p-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl shadow-sm">
          <span class="text-[#EA580C] font-mono font-black text-sm block mb-2">RULE 03</span>
          <h3 class="font-bold text-sm text-[#0F2B5B] uppercase mb-2">Resin Shrinkage & Gloss Visibility</h3>
          <p class="leading-relaxed text-[#0F2B5B]/80">High-shrinkage crystalline resins (like POM and PA66) can dull high-gloss mirror finishes over time. Amorphous polymers (like Optical PC and PMMA) replicate mirror cavity textures with absolute clarity.</p>
        </div>
      </div>

      <!-- CTA -->
      <section class="bg-[#0F2B5B] text-white rounded-2xl p-8 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-1">SURFACE_FINISH_CONSULTATION</span>
          <h3 class="text-2xl font-[1000] uppercase italic">Need Guidance on SPI Textures or Mirror Polish Tooling?</h3>
          <p class="text-xs text-white/80 font-sans mt-2">Upload your 3D CAD drawing to discuss cosmetic surface requirements with our Dongguan engineers.</p>
        </div>
        <button id="surface-rfq-trigger" type="button" class="shrink-0 bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 px-8 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
          Upload 3D CAD for DFM Quote →
        </button>
      </section>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
  function setupSurfaceEvents() {
    const btn = document.getElementById('surface-rfq-trigger');
    if (btn) {
      btn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }
  }
  document.addEventListener('astro:page-load', setupSurfaceEvents);
</script>