---
/**
 * src/pages/resources/calculators/instant-dfm-checker.astro
 * 👑 NEXMOLD 在线即时 DFM 诊断与制造可行性分析引擎 (GEO & 转化终极武器)
 * 1. 架构定位：模拟前端 3D DFM 自动诊断（壁厚、拔模斜度、树脂匹配、注塑风险评估）
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Instant DFM Checker & Plastic Injection Molding Feasibility Tool | NEXMOLD";
const description = "Run an instant automated DFM (Design for Manufacturability) analysis on your 3D CAD parameters. Evaluate wall thickness, draft angles, and resin suitability in real time.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "Instant DFM Checker and Injection Molding Feasibility Analysis Engine",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "NEXMOLD Precision Manufacturing"
  }
};
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <a href="/resources/calculators/shrinkage-calculator" class="hover:text-[#EA580C] transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Instant DFM Checker</span>
      </nav>

      <!-- 👑 GEO Quick Answer 抢占框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          INTERACTIVE_ENGINE // AUTOMATED_DFM_DIAGNOSTICS
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Instant Automated DFM Checker &<br/>
          <span class="text-[#EA580C]">Manufacturing Feasibility Tool</span>
        </h1>
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Design for Manufacturability (DFM) analysis flags structural geometry risks before cutting mold steel. This interactive diagnostic tool evaluates nominal wall thickness uniformity, minimum draft angle clearance, and resin shrinkage compatibility to guarantee a <strong>99.2%+ yield rate</strong> on your production lot.
        </p>
      </section>

      <!-- 交互式 DFM 诊断核心网格 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- 左侧：输入诊断参数 -->
        <div class="lg:col-span-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            1. Configure DFM Audit Parameters
          </h2>

          <!-- 1. 平均壁厚选择 -->
          <div>
            <label for="dfm-wall" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Nominal Wall Thickness (mm)
            </label>
            <input type="number" id="dfm-wall" min="0.5" max="10" step="0.1" value="2.2" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 2. 最大拔模角度 -->
          <div>
            <label for="dfm-draft" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Minimum Feature Draft Angle (Degrees)
            </label>
            <input type="number" id="dfm-draft" min="0" max="10" step="0.5" value="1.5" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 3. 树脂材料 -->
          <div>
            <label for="dfm-resin" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Selected Resin Material
            </label>
            <select id="dfm-resin" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="abs" selected>ABS / PC-ABS (Low Risk, Stable Flow)</option>
              <option value="pc">Optical Polycarbonate PC (High Sensitivity to Stress)</option>
              <option value="pom">POM Acetal / Delrin (High Shrinkage & Void Risk)</option>
              <option value="nylon">PA66 + 30% Glass Fiber (Anisotropic Warpage Risk)</option>
              <option value="peek">Medical PEEK (High Thermal Stress)</option>
            </select>
          </div>

          <!-- 4. 是否包含复杂倒扣 (Undercuts) -->
          <div>
            <label for="dfm-undercuts" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Contains Side Actions / Undercuts?
            </label>
            <select id="dfm-undercuts" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="no" selected>No Undercuts (Straight Pull Mold)</option>
              <option value="slider" selected>Requires Side Slides / Lifters</option>
              <option value="complex">Complex Internal Actions Required</option>
            </select>
          </div>

          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/70 leading-relaxed">
            <strong>Automated DFM Algorithm:</strong> Evaluates structural risk indices based on DIN 16742 tolerances and Moldflow thermodynamic stress metrics.
          </div>
        </div>

        <!-- 右侧：诊断结果看板 -->
        <div class="lg:col-span-6 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
              <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest">AUTOMATED_DIAGNOSTIC_REPORT</span>
              <span class="text-xs font-mono font-bold bg-white/10 px-3 py-1 rounded" id="dfm-status-badge">PASS (READY FOR TOOLING)</span>
            </div>

            <div class="space-y-6">
              <!-- 整体制造可行性评分 -->
              <div>
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Manufacturability Score</span>
                <div class="text-4xl sm:text-5xl font-[1000] font-mono text-[#EA580C]" id="result-score">
                  96 / 100
                </div>
              </div>

              <!-- 壁厚风险提示 -->
              <div class="pt-4 border-t border-white/10">
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Wall Thickness Uniformity</span>
                <div class="text-lg font-mono font-bold text-white" id="result-wall-feedback">
                  Optimal (1.5mm - 3.0mm Standard Range)
                </div>
              </div>

              <!-- 拔模与顶出风险 -->
              <div class="pt-4 border-t border-white/10">
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Ejection & Draft Clearance</span>
                <div class="text-lg font-mono font-bold text-white" id="result-draft-feedback">
                  Sufficient Clearance (No Drag Risk)
                </div>
              </div>

              <!-- 模具建议 -->
              <div class="pt-4 border-t border-white/10 font-mono text-xs grid grid-cols-2 gap-4">
                <div>
                  <span class="text-white/60 block mb-1">Recommended Steel</span>
                  <span class="font-bold text-[#EA580C]" id="result-steel-rec">ASSAB S136 Hardened</span>
                </div>
                <div>
                  <span class="text-white/60 block mb-1">Est. T1 Lead Time</span>
                  <span class="font-bold text-white" id="result-lead-rec">10 - 14 Calendar Days</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 转化 CTA -->
          <div class="mt-8 pt-6 border-t border-white/20">
            <p class="text-xs font-sans text-white/80 leading-relaxed mb-4">
              Get an official binding DFM report signed by our senior Dongguan toolmakers.
            </p>
            <button id="dfm-rfq-trigger" type="button" class="w-full bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
              Upload 3D CAD for Full DFM Report →
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

<script>
  function setupDfmChecker() {
    const wallInput = document.getElementById('dfm-wall') as HTMLInputElement | null;
    const draftInput = document.getElementById('dfm-draft') as HTMLInputElement | null;
    const resinSelect = document.getElementById('dfm-resin') as HTMLSelectElement | null;
    const undercutsSelect = document.getElementById('dfm-undercuts') as HTMLSelectElement | null;

    const resScore = document.getElementById('result-score');
    const resWall = document.getElementById('result-wall-feedback');
    const resDraft = document.getElementById('result-draft-feedback');
    const resSteel = document.getElementById('result-steel-rec');
    const resLead = document.getElementById('result-lead-rec');
    const badge = document.getElementById('dfm-status-badge');
    const modalBtn = document.getElementById('dfm-rfq-trigger');

    if (!wallInput || !draftInput || !resinSelect || !undercutsSelect) return;

    function runDiagnostics() {
      const wall = parseFloat(wallInput!.value) || 2.0;
      const draft = parseFloat(draftInput!.value) || 1.5;
      const resin = resinSelect!.value;
      const undercuts = undercutsSelect!.value;

      let score = 95;
      let wallMsg = "Optimal (Standard Range)";
      let draftMsg = "Sufficient Clearance";
      let steelRec = "ASSAB S136 Hardened Steel";
      let leadRec = "10 - 14 Days";
      let statusText = "PASS (READY FOR TOOLING)";
      let badgeClass = "bg-white/10 text-white";

      // 壁厚逻辑诊断
      if (wall < 1.0) {
        score -= 15;
        wallMsg = "Warning: Thin wall risk (Fill Resistance)";
      } else if (wall > 4.5) {
        score -= 20;
        wallMsg = "High Risk: Thick wall causes sink marks & voids";
      }

      // 拔模斜度逻辑诊断
      if (draft < 1.0) {
        score -= 15;
        draftMsg = "Warning: Insufficient draft (Ejection drag risk)";
      } else {
        draftMsg = "Safe Clearance (Clean Ejection)";
      }

      // 倒扣结构诊断
      if (undercuts === 'slider') {
        score -= 5;
        steelRec = "S136 with Side Slides / Lifters";
        leadRec = "14 - 18 Days";
      } else if (undercuts === 'complex') {
        score -= 12;
        steelRec = "Custom Multi-Action Core Pulls";
        leadRec = "21 - 28 Days";
      }

      // 树脂专属诊断
      if (resin === 'peek') {
        steelRec = "ASSAB S136 ESR Mirror Steel (HRC 50+)" ;
        leadRec = "14 - 21 Days (High-Temp Oil Molds)";
      } else if (resin === 'pom') {
        wallMsg += " (POM Shrinkage Compensation Applied)";
      }

      if (score < 75) {
        statusText = "REVIEW REQUIRED (DFM ADJUSTMENT)";
        badgeClass = "bg-[#EA580C] text-white";
      } else {
        statusText = "PASS (READY FOR TOOLING)";
        badgeClass = "bg-white/20 text-white";
      }

      if (resScore) resScore.textContent = `${Math.max(40, score)} / 100`;
      if (resWall) resWall.textContent = wallMsg;
      if (resDraft) resDraft.textContent = draftMsg;
      if (resSteel) resSteel.textContent = steelRec;
      if (resLead) resLead.textContent = leadRec;
      if (badge) {
        badge.textContent = statusText;
        badge.className = `text-xs font-mono font-bold px-3 py-1 rounded ${badgeClass}`;
      }
    }

    wallInput.addEventListener('input', runDiagnostics);
    draftInput.addEventListener('input', runDiagnostics);
    resinSelect.addEventListener('change', runDiagnostics);
    undercutsSelect.addEventListener('change', runDiagnostics);

    if (modalBtn) {
      modalBtn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }

    runDiagnostics();
  }

  document.addEventListener('astro:page-load', setupDfmChecker);
</script>