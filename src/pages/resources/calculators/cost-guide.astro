---
/**
 * src/pages/resources/calculators/cost-guide.astro
 * 👑 NEXMOLD 模具与注塑成本参数化计算器 (GEO 顶级买家流量收割机)
 * 1. 交互功能：根据穴数 (Cavities)、钢材 (S136/H13/718H)、热流道与预计批次，计算开模成本与单件注塑费用
 * 2. 视觉规范：100% 钛白高奢风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. 转化闭环：计算结果带入 LeadModal 发起 24H 官方工程 DFM 评估
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Injection Mold Tooling & Unit Cost Calculator | NEXMOLD";
const description = "Parametric estimation framework evaluating cavity count, steel grade (ASSAB S136 vs H13), hot runner systems, and T1 tooling lead times for injection molding.";

const calculatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Injection Mold Tooling & Part Cost Estimator",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "description": description
};
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Mold Cost Estimator</span>
      </nav>

      <!-- 标头 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          ENGINEERING_COST_ENGINE // PARAMETRIC_TOOLING_MODEL
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Injection Mold Tooling &<br/>
          <span class="text-[#EA580C]">Production Cost Calculator</span>
        </h1>
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          Estimate custom steel tooling budgets and per-part unit economics based on mold cavity multiplication, core steel grades (S136 vs H13), surface finishes, and Haitian press tonnage.
        </p>
      </section>

      <!-- 计算控制台 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
        
        <!-- 输入区 (7栏) -->
        <div class="lg:col-span-7 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg space-y-6">
          <div class="border-b border-[#0F2B5B]/15 pb-4">
            <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-1">PARAMETRIC INPUTS</span>
            <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B]">Tooling & Production Variables</h3>
          </div>

          <!-- 1. 模具钢材选择 -->
          <div>
            <label class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Cavity Steel & Mold Life Target
            </label>
            <select id="cost-steel-select" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/15 rounded-lg px-4 py-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] focus:outline-none transition-colors">
              <option value="718h">718H Pre-hardened Steel (Prototype / Low-Vol, 100k shots)</option>
              <option value="h13" selected>H13 Hardened Steel (Production, 500k shots)</option>
              <option value="s136">ASSAB S136 Mirror Stainless Steel (High-Gloss / Optical, 1M+ shots)</option>
            </select>
          </div>

          <!-- 2. 穴数与流道系统 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
                Cavity Count
              </label>
              <select id="cost-cavity-select" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/15 rounded-lg px-4 py-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] focus:outline-none transition-colors">
                <option value="1">1 Cavity (Prototyping)</option>
                <option value="2">2 Cavities (Balanced Production)</option>
                <option value="4" selected>4 Cavities (High Yield)</option>
                <option value="8">8 Cavities (Mass Production)</option>
              </select>
            </div>

            <div>
              <label class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
                Runner System
              </label>
              <select id="cost-runner-select" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/15 rounded-lg px-4 py-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] focus:outline-none transition-colors">
                <option value="cold">Cold Runner System</option>
                <option value="hot" selected>Hot Runner System (Zero Waste)</option>
              </select>
            </div>
          </div>

          <!-- 3. 尺寸与预估批次 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
                Part Envelope Volume
              </label>
              <select id="cost-size-select" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/15 rounded-lg px-4 py-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] focus:outline-none transition-colors">
                <option value="small">Small Component (&lt; 100mm)</option>
                <option value="medium" selected>Medium Component (100mm - 300mm)</option>
                <option value="large">Large Housing (&gt; 300mm)</option>
              </select>
            </div>

            <div>
              <label class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
                Estimated Annual Quantity
              </label>
              <input type="number" id="cost-qty-input" value="10000" step="1000" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/15 rounded-lg px-4 py-3 font-mono text-sm font-black text-[#0F2B5B] focus:border-[#EA580C] focus:outline-none transition-colors" />
            </div>
          </div>

          <button id="cost-calc-btn" class="w-full bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer border border-white/20">
            Calculate Tooling & Piece Estimate →
          </button>
        </div>

        <!-- 输出区 (5栏) -->
        <div class="lg:col-span-5 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1.5 bg-[#EA580C]"></div>

          <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest block mb-1">ESTIMATED_BUDGET</span>
          <h3 class="text-lg font-[1000] font-sans uppercase italic text-[#0F2B5B] mb-6">Budgetary Cost Range</h3>

          <div class="space-y-4 font-mono">
            <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl flex items-center justify-between">
              <span class="text-xs text-[#0F2B5B]/60 font-bold">Estimated Mold Tooling Cost</span>
              <span id="out-tooling-cost" class="text-lg font-black text-[#EA580C]">$3,500 - $4,800</span>
            </div>

            <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl flex items-center justify-between">
              <span class="text-xs text-[#0F2B5B]/60 font-bold">Estimated T1 Lead Time</span>
              <span id="out-t1-time" class="text-xs font-black text-[#0F2B5B]">10 - 15 Days</span>
            </div>

            <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl flex items-center justify-between">
              <span class="text-xs text-[#0F2B5B]/60 font-bold">Estimated Unit Price / Part</span>
              <span id="out-unit-cost" class="text-sm font-black text-[#0F2B5B]">$0.85 - $1.20</span>
            </div>

            <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl flex items-center justify-between">
              <span class="text-xs text-[#0F2B5B]/60 font-bold">Target Haitian Press Fleet</span>
              <span id="out-press-fleet" class="text-xs font-bold text-[#0F2B5B]">160T - 280T Servo</span>
            </div>
          </div>

          <button id="cost-rfq-btn" class="w-full mt-6 bg-[#0F2B5B] hover:bg-[#EA580C] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
            Lock Cost & Request Formal DFM →
          </button>
        </div>

      </div>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script>
  function bindCostCalculator() {
    const steelEl = document.getElementById('cost-steel-select') as HTMLSelectElement;
    const cavityEl = document.getElementById('cost-cavity-select') as HTMLSelectElement;
    const runnerEl = document.getElementById('cost-runner-select') as HTMLSelectElement;
    const sizeEl = document.getElementById('cost-size-select') as HTMLSelectElement;
    const qtyEl = document.getElementById('cost-qty-input') as HTMLInputElement;

    const calcBtn = document.getElementById('cost-calc-btn');
    const rfqBtn = document.getElementById('cost-rfq-btn');

    const outTooling = document.getElementById('out-tooling-cost');
    const outT1 = document.getElementById('out-t1-time');
    const outUnit = document.getElementById('out-unit-cost');
    const outPress = document.getElementById('out-press-fleet');

    function calculateCost() {
      if (!steelEl || !cavityEl || !runnerEl || !sizeEl || !qtyEl) return;

      const steel = steelEl.value;
      const cavity = parseInt(cavityEl.value);
      const runner = runnerEl.value;
      const size = sizeEl.value;
      const qty = parseInt(qtyEl.value) || 10000;

      let baseCost = 2200;
      if (size === 'medium') baseCost = 3500;
      if (size === 'large') baseCost = 6800;

      if (steel === 'h13') baseCost *= 1.35;
      if (steel === 's136') baseCost *= 1.75;

      baseCost += (cavity - 1) * 800;
      if (runner === 'hot') baseCost += 1200;

      const lowTooling = Math.round(baseCost * 0.9);
      const highTooling = Math.round(baseCost * 1.15);

      let t1Days = "7 - 10 Days";
      if (steel === 'h13') t1Days = "12 - 18 Days";
      if (steel === 's136') t1Days = "15 - 22 Days";

      let baseUnit = 0.45;
      if (size === 'medium') baseUnit = 0.95;
      if (size === 'large') baseUnit = 2.80;

      if (qty > 50000) baseUnit *= 0.75;

      if (outTooling) outTooling.innerText = `$${lowTooling.toLocaleString()} - $${highTooling.toLocaleString()}`;
      if (outT1) outT1.innerText = t1Days;
      if (outUnit) outUnit.innerText = `$${(baseUnit * 0.9).toFixed(2)} - $${(baseUnit * 1.2).toFixed(2)}`;
      if (outPress) outPress.innerText = size === 'large' ? "450T - 1200T Servo" : "160T - 280T Servo";
    }

    if (calcBtn) calcBtn.onclick = calculateCost;
    if (steelEl) steelEl.onchange = calculateCost;
    if (cavityEl) cavityEl.onchange = calculateCost;
    if (runnerEl) runnerEl.onchange = calculateCost;

    if (rfqBtn) {
      rfqBtn.onclick = () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      };
    }

    calculateCost();
  }

  document.addEventListener('DOMContentLoaded', bindCostCalculator);
  document.addEventListener('astro:after-swap', bindCostCalculator);
</script>