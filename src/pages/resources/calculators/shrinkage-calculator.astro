---
/**
 * src/pages/resources/calculators/shrinkage-calculator.astro
 * 👑 NEXMOLD 树脂收缩率与模具尺寸在线计算器 (GEO 交互工具)
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Volumetric Resin Shrinkage & Mold Dimension Calculator | NEXMOLD";
const description = "Calculate plastic injection molding shrinkage rates, volumetric thermal compensation, and steel cavity tolerances for PEEK, PC, POM, PA66, and ABS resins.";
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Shrinkage Calculator</span>
      </nav>

      <!-- 头部介绍 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          ENGINEERING_TOOLS // THERMAL_COMPENSATION
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Resin Shrinkage &<br/>
          <span class="text-[#EA580C]">Mold Dimension Calculator</span>
        </h1>
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          Calculate precise steel mold cavity dimensions based on resin volumetric shrinkage rates. Prevent post-molding warpage, gate sink marks, and dimensional drift.
        </p>
      </section>

      <!-- 计算器核心网格 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- 左侧输入表单 -->
        <div class="lg:col-span-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Input Engineering Parameters
          </h2>

          <!-- 选择树脂材料 -->
          <div>
            <label for="resin-select" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Select Resin Material
            </label>
            <select id="resin-select" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="0.005" selected>ABS (Standard: 0.5%)</option>
              <option value="0.006">PC - Polycarbonate (Standard: 0.6%)</option>
              <option value="0.015">PA66 + 30% GF (Standard: 1.5%)</option>
              <option value="0.020">POM / Acetal (Standard: 2.0%)</option>
              <option value="0.012">PEEK (Standard: 1.2%)</option>
              <option value="0.007">Ultem PEI (Standard: 0.7%)</option>
              <option value="custom">Custom Shrinkage Rate...</option>
            </select>
          </div>

          <!-- 自定义收缩率数值 -->
          <div id="custom-rate-container" class="hidden">
            <label for="custom-shrink-input" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Custom Shrinkage Rate (%)
            </label>
            <input type="number" id="custom-shrink-input" step="0.01" min="0" max="10" value="0.5" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 期望成品尺寸 -->
          <div>
            <label for="part-dimension-input" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Target Part Dimension (mm)
            </label>
            <input type="number" id="part-dimension-input" step="0.01" min="0" value="100.00" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 公式说明 -->
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/70 leading-relaxed">
            <strong>Formula:</strong> Mold Cavity Dimension = Target Part Size &#10005; (1 + Shrinkage Rate)<br/>
            S_volumetric = S_linear &#10005; 3 (Applies to isotropic semi-crystalline resins)
          </div>
        </div>

        <!-- 右侧计算结果控制台 -->
        <div class="lg:col-span-6 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
              <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest">CALCULATION_OUTPUT</span>
              <span class="text-xs font-mono font-bold bg-white/10 px-3 py-1 rounded">ISO 2768-M READY</span>
            </div>

            <div class="space-y-6">
              <div>
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Required Steel Cavity Size</span>
                <div class="text-4xl sm:text-5xl font-[1000] font-mono text-[#EA580C]" id="result-cavity-size">
                  100.500 mm
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/10 font-mono text-xs">
                <div>
                  <span class="text-white/60 block mb-1">Volumetric Delta</span>
                  <span class="font-bold text-white" id="result-delta">+0.500 mm</span>
                </div>
                <div>
                  <span class="text-white/60 block mb-1">Applied Rate</span>
                  <span class="font-bold text-[#EA580C]" id="result-applied-rate">0.50 %</span>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/20">
            <p class="text-xs font-sans text-white/80 leading-relaxed mb-4">
              Need Moldflow simulation or assistance adjusting gate dimensions for tight tolerance components?
            </p>
            <button id="shrink-rfq-trigger" type="button" class="w-full bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
              Request 24H DFM & Moldflow Analysis →
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script>
  function setupCalculator() {
    const resinSelect = document.getElementById('resin-select') as HTMLSelectElement | null;
    const customContainer = document.getElementById('custom-rate-container');
    const customInput = document.getElementById('custom-shrink-input') as HTMLInputElement | null;
    const partInput = document.getElementById('part-dimension-input') as HTMLInputElement | null;

    const resCavity = document.getElementById('result-cavity-size');
    const resDelta = document.getElementById('result-delta');
    const resRate = document.getElementById('result-applied-rate');
    const modalBtn = document.getElementById('shrink-rfq-trigger');

    if (!resinSelect || !partInput || !resCavity || !resDelta || !resRate) return;

    function calculate() {
      let rate = 0;
      if (resinSelect!.value === 'custom') {
        customContainer?.classList.remove('hidden');
        const customVal = parseFloat(customInput?.value || '0');
        rate = (isNaN(customVal) ? 0 : customVal) / 100;
      } else {
        customContainer?.classList.add('hidden');
        rate = parseFloat(resinSelect!.value);
      }

      const partSize = parseFloat(partInput!.value);
      const validPartSize = isNaN(partSize) ? 0 : partSize;

      const cavitySize = validPartSize * (1 + rate);
      const delta = cavitySize - validPartSize;

      resCavity!.textContent = `${cavitySize.toFixed(3)} mm`;
      resDelta!.textContent = `+${delta.toFixed(3)} mm`;
      resRate!.textContent = `${(rate * 100).toFixed(2)} %`;
    }

    resinSelect.addEventListener('change', calculate);
    customInput?.addEventListener('input', calculate);
    partInput.addEventListener('input', calculate);

    if (modalBtn) {
      modalBtn.addEventListener('click', () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      });
    }

    // 初始化计算
    calculate();
  }

  // 支持常规加载与 Astro View Transitions 导航刷新
  document.addEventListener('astro:page-load', setupCalculator);
</script>