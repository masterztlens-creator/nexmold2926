---
/**
 * src/pages/resources/calculators/draft-angle-calculator.astro
 * 👑 NEXMOLD 注塑拔模斜度 (Draft Angle) & 侧壁脱模拉伤计算器
 * 1. 架构定位：帮助工程设计人员根据深度 (Depth)、纹理 (SPI/VDI Texture) 计算最小拔模角度 (Draft Angle in Degrees)
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：内嵌 Quick Answer、结构化几何公式与 DFM 提醒
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Injection Molding Draft Angle & Clearance Calculator | NEXMOLD";
const description = "Calculate recommended draft angles based on cavity depth, resin material, and SPI/VDI surface texture specifications to prevent part ejection drag marks.";
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <a href="/resources/calculators/shrinkage-calculator" class="hover:text-[#EA580C] transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Draft Angle Calculator</span>
      </nav>

      <!-- 👑 GEO Quick Answer 核心框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          ENGINEERING_TOOLS // EJECTION_DRAFT_GEOMETRY
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Injection Molding Draft Angle &<br/>
          <span class="text-[#EA580C]">Surface Texture Clearance Calculator</span>
        </h1>
        <!-- Featured Snippet Summary -->
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Standard injection molding draft angle guidelines require a minimum of <strong>1.0° to 1.5° per side</strong> for smooth part ejection without drag marks. Deep cavities (&gt;50mm) require an additional 1° for every 25mm of depth. For textured surfaces (SPI/VDI standards), add <strong>1.5° of draft for every 0.025mm (0.001 in) of texture depth</strong>.
        </p>
      </section>

      <!-- 计算器核心网格 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- 左侧：输入工程参数 -->
        <div class="lg:col-span-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Input Geometry & Texture Variables
          </h2>

          <!-- 1. 拔模深度 -->
          <div>
            <label for="draw-depth" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Feature Draw Depth (mm)
            </label>
            <input type="number" id="draw-depth" min="1" max="500" value="40" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 2. 表面纹理等级 (Surface Texture) -->
          <div>
            <label for="texture-spec" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Surface Polish / Texture Specification
            </label>
            <select id="texture-spec" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="0" selected>SPI-A1 / A2 Diamond Mirror Finish (Smooth Polish - 1.0° Base)</option>
              <option value="1">SPI-B1 / B2 Paper Polish (Smooth Semi-Gloss - 1.5° Base)</option>
              <option value="2.5">SPI-C1 / C2 Grit Blast (Light Texture - 2.5° Base)</option>
              <option value="4">VDI 24 / MT-11010 Heavy Leather Texture (4.0° Base)</option>
            </select>
          </div>

          <!-- 3. 树脂收缩类型 -->
          <div>
            <label for="resin-shrink-type" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Resin Shrinkage Category
            </label>
            <select id="resin-shrink-type" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="0" selected>ABS / PC / PC+ABS (Low Shrinkage ~0.5% - Low Rib Binding)</option>
              <option value="0.5">PA66+30%GF / PEEK (Glass Filled ~1.2% - Moderate Rib Binding)</option>
              <option value="1.0">POM / PP (High Shrinkage &gt;1.8% - High Core Hugging Risk)</option>
            </select>
          </div>

          <!-- 几何原理说明 -->
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/70 leading-relaxed">
            <strong>Trigonometric Offset Formula:</strong> Offset Per Side (mm) = Depth &#10005; tan(Recommended Draft Angle)
          </div>
        </div>

        <!-- 右侧：计算结果面板 -->
        <div class="lg:col-span-6 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
              <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest">DRAFT_CALCULATION_OUTPUT</span>
              <span class="text-xs font-mono font-bold bg-white/10 px-3 py-1 rounded">EJECTION READY</span>
            </div>

            <div class="space-y-6">
              <!-- 推荐拔模角度 -->
              <div>
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Recommended Draft Angle / Side</span>
                <div class="text-4xl sm:text-5xl font-[1000] font-mono text-[#EA580C]" id="result-draft-angle">
                  1.5° Per Side
                </div>
              </div>

              <!-- 推荐底侧单边偏移量 -->
              <div class="pt-4 border-t border-white/10">
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Total Wall Offset / Side</span>
                <div class="text-2xl font-[1000] font-mono text-white" id="result-wall-offset">
                  0.038 in (0.97 mm)
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/10 font-mono text-xs">
                <div>
                  <span class="text-white/60 block mb-1">Ejection Drag Risk</span>
                  <span class="font-bold text-white" id="result-drag-risk">LOW RISK</span>
                </div>
                <div>
                  <span class="text-white/60 block mb-1">Texture Allowance</span>
                  <span class="font-bold text-[#EA580C]" id="result-texture-note">Mirror Polish Compliant</span>
                </div>
              </div>
            </div>
          </div>

          <!-- DFM 引流 -->
          <div class="mt-8 pt-6 border-t border-white/20">
            <p class="text-xs font-sans text-white/80 leading-relaxed mb-4">
              Need a full 3D color-coded Moldflow Draft Angle analysis on your .STEP assembly?
            </p>
            <button id="draft-rfq-trigger" type="button" class="w-full bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
              Request 3D Draft DFM Analysis →
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script>
  function setupDraftCalculator() {
    const depthInput = document.getElementById('draw-depth') as HTMLInputElement | null;
    const textureSelect = document.getElementById('texture-spec') as HTMLSelectElement | null;
    const resinSelect = document.getElementById('resin-shrink-type') as HTMLSelectElement | null;

    const resAngle = document.getElementById('result-draft-angle');
    const resOffset = document.getElementById('result-wall-offset');
    const resRisk = document.getElementById('result-drag-risk');
    const resNote = document.getElementById('result-texture-note');
    const modalBtn = document.getElementById('draft-rfq-trigger');

    if (!depthInput || !textureSelect || !resinSelect) return;

    function calculateDraft() {
      const depth = parseFloat(depthInput!.value) || 10;
      const baseTextureAngle = parseFloat(textureSelect!.value) || 0;
      const resinFactor = parseFloat(resinSelect!.value) || 0;

      // 深度加成：每超过 30mm 增加 0.5 度
      const depthFactor = Math.max(0, Math.floor((depth - 25) / 25)) * 0.5;

      const totalAngle = Math.max(1.0, 1.0 + baseTextureAngle + depthFactor + resinFactor);
      const angleRad = (totalAngle * Math.PI) / 180;
      const offsetMm = depth * Math.tan(angleRad);
      const offsetIn = offsetMm / 25.4;

      let riskStr = "LOW RISK";
      if (totalAngle < 1.5 && depth > 50) riskStr = "HIGH EJECTION RISK";
      else if (baseTextureAngle > 2.0) riskStr = "TEXTURE DRAG RISK";

      if (resAngle) resAngle.textContent = `${totalAngle.toFixed(1)}° Per Side`;
      if (resOffset) resOffset.textContent = `${offsetMm.toFixed(2)} mm (${offsetIn.toFixed(3)} in)`;
      if (resRisk) resRisk.textContent = riskStr;
      if (resNote) resNote.textContent = baseTextureAngle > 0 ? "Texture Clearance Added" : "Smooth Surface Compliant";
    }

    depthInput.addEventListener('input', calculateDraft);
    textureSelect.addEventListener('change', calculateDraft);
    resinSelect.addEventListener('change', calculateDraft);

    if (modalBtn) {
      modalBtn.addEventListener('click', () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      });
    }

    calculateDraft();
  }

  document.addEventListener('astro:page-load', setupDraftCalculator);
</script>