---
/**
 * src/pages/resources/calculators/clamping-force-calculator.astro
 * 👑 NEXMOLD 注塑机锁模力 (Clamping Force) 与投影面积在线计算器
 * 1. 架构定位：帮助工程买家根据零件投影面积 (Projected Area) 与树脂 cavity 压力计算所需的注塑机吨位 (Tonnage)
 * 2. 视觉规范：100% 钛白极简风 (#FAFAFA / #FFFFFF) + 德系深蓝 (#0F2B5B) + 亮橙 (#EA580C)
 * 3. GEO / SEO：内嵌 Quick Answer、结构化计算公式与动态 Haitian 90T-1200T 机台推荐
 */

import MainLayout from '../../../layouts/MainLayout.astro';
import Header from '../../../components/Header.astro';
import EcosystemFooter from '../../../components/EcosystemFooter.astro';
import LeadModal from '../../../components/LeadModal.astro';

const title = "Injection Molding Clamping Force & Tonnage Calculator | NEXMOLD";
const description = "Calculate required injection molding clamp force (tonnage) based on projected surface area, cavity pressure, and resin viscosity for PEEK, PC, POM, and ABS.";
---

<MainLayout title={title} description={description} lang="en" location="North America">
  <Header lang="en" />

  <main class="bg-[#FAFAFA] text-[#0F2B5B] font-sans py-[clamp(3rem,6vw,6rem)] select-none">
    <div class="max-w-[1650px] mx-auto px-4 sm:px-8">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-[#0F2B5B]/50 uppercase tracking-widest mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#EA580C] transition-colors">Home</a>
        <span>/</span>
        <a href="/resources" class="hover:text-[#EA580C] transition-colors">Resources</a>
        <span>/</span>
        <a href="/resources/calculators/shrinkage-calculator" class="hover:text-[#EA580C] transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-[#EA580C] font-black">Clamp Force Calculator</span>
      </nav>

      <!-- 👑 GEO Quick Answer 抢占框 -->
      <section class="border-l-4 border-[#EA580C] pl-6 max-w-4xl mb-12">
        <span class="text-[#EA580C] font-mono text-[10px] font-black uppercase tracking-[0.4em]">
          ENGINEERING_TOOLS // HYDRAULIC_&_SERVO_TONNAGE
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-[1000] font-sans uppercase tracking-tighter leading-[0.95] italic mt-2 mb-4 text-[#0F2B5B]">
          Injection Molding Clamp Force &<br/>
          <span class="text-[#EA580C]">Press Tonnage Calculator</span>
        </h1>
        <!-- Featured Snippet Summary -->
        <p class="text-[#0F2B5B]/80 text-sm sm:text-base font-bold font-sans leading-relaxed max-w-3xl">
          <strong>Quick Answer:</strong> Clamping force (measured in US Tons or Metric Tonnes) is the hydraulic force required to keep the mold cavity closed against high resin injection pressure. The fundamental equation is: <strong>Clamping Force = Total Projected Area &#10005; Specific Cavity Pressure &#10005; Safety Factor (1.1–1.2)</strong>. Selecting correct press tonnage prevents flash, parting line degradation, and short shots.
        </p>
      </section>

      <!-- 计算器核心网格 -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- 左侧：输入工程参数 -->
        <div class="lg:col-span-6 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-8 shadow-lg space-y-6">
          <h2 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4">
            Input Part & Geometry Parameters
          </h2>

          <!-- 1. 零件与流道总投影面积 -->
          <div>
            <label for="projected-area" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Total Projected Area (cm² or in²)
            </label>
            <div class="grid grid-cols-3 gap-2">
              <input type="number" id="projected-area" min="1" value="150" class="col-span-2 bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
              <select id="area-unit" class="bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none">
                <option value="cm2" selected>cm²</option>
                <option value="in2">in²</option>
              </select>
            </div>
          </div>

          <!-- 2. 模穴数量 (Cavity Count) -->
          <div>
            <label for="cavities" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Number of Cavities
            </label>
            <input type="number" id="cavities" min="1" max="64" value="2" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors" />
          </div>

          <!-- 3. 树脂材料与 Cavity 压力系数 -->
          <div>
            <label for="resin-viscosity" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Resin Material & Viscosity Class
            </label>
            <select id="resin-viscosity" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="300">ABS / PS / PE (Low Viscosity - ~300 bar cavity pressure)</option>
              <option value="450" selected>PC / POM / PA66 (Medium Viscosity - ~450 bar cavity pressure)</option>
              <option value="600">PA66 + 30% GF (High Viscosity - ~600 bar cavity pressure)</option>
              <option value="800">PEEK / Ultem PEI (Ultra High Temp - ~800 bar cavity pressure)</option>
            </select>
          </div>

          <!-- 4. 壁厚校正因子 (Wall Thickness Factor) -->
          <div>
            <label for="wall-factor" class="block font-mono text-xs font-black uppercase text-[#0F2B5B] mb-2">
              Nominal Wall Thickness Factor
            </label>
            <select id="wall-factor" class="w-full bg-[#FAFAFA] border-2 border-[#0F2B5B]/20 rounded-lg p-3 font-mono text-xs font-bold text-[#0F2B5B] focus:border-[#EA580C] outline-none transition-colors">
              <option value="1.3">Thin Wall (&lt; 1.0 mm) — High Pressure Required</option>
              <option value="1.0" selected>Standard Wall (1.5 mm – 3.0 mm) — Standard Flow</option>
              <option value="0.85">Thick Wall (&gt; 3.5 mm) — Reduced Cavity Pressure</option>
            </select>
          </div>

          <!-- 算法公式公开 -->
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl font-mono text-[11px] text-[#0F2B5B]/70 leading-relaxed">
            <strong>Formula:</strong> Clamp Force (Tons) = [Area &#10005; Cavity Pressure (bar) &#10005; Wall Factor &#10005; Cavities &#10005; 1.15 Safety] / 981
          </div>
        </div>

        <!-- 右侧：估算结果与海天机队匹配面板 -->
        <div class="lg:col-span-6 bg-[#0F2B5B] text-white rounded-2xl p-6 sm:p-8 shadow-2xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-white/20 pb-4 mb-6">
              <span class="text-[10px] font-mono font-black text-[#EA580C] uppercase tracking-widest">TONNAGE_CALCULATION_OUTPUT</span>
              <span class="text-xs font-mono font-bold bg-white/10 px-3 py-1 rounded">SPI CLASS 101 READY</span>
            </div>

            <div class="space-y-6">
              <!-- 计算出的关模力吨位 -->
              <div>
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Required Clamping Force</span>
                <div class="text-4xl sm:text-5xl font-[1000] font-mono text-[#EA580C]" id="result-clamping-tons">
                  185 US Tons
                </div>
                <div class="text-xs font-mono text-white/60 mt-1" id="result-clamping-metric">
                  (168 Metric Tonnes / 1,650 kN)
                </div>
              </div>

              <!-- 推荐的海天 Haitan 机台 -->
              <div class="pt-4 border-t border-white/10">
                <span class="text-xs font-mono text-white/60 block uppercase mb-1">Recommended Haitian Press Fleet</span>
                <div class="text-2xl font-[1000] font-mono text-white" id="result-recommended-press">
                  Haitian MA2000 Servo (200 Ton)
                </div>
              </div>

              <!-- 参数细分 -->
              <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/10 font-mono text-xs">
                <div>
                  <span class="text-white/60 block mb-1">Total Mold Area</span>
                  <span class="font-bold text-white" id="result-total-area">300 cm²</span>
                </div>
                <div>
                  <span class="text-white/60 block mb-1">Safety Margin</span>
                  <span class="font-bold text-[#EA580C]">+15% Safety Buffer Included</span>
                </div>
              </div>
            </div>
          </div>

          <!-- DFM 引流与行动召唤 -->
          <div class="mt-8 pt-6 border-t border-white/20">
            <p class="text-xs font-sans text-white/80 leading-relaxed mb-4">
              Need Moldflow flow-front and parting line parting force simulation for complex geometries?
            </p>
            <button id="clamp-rfq-trigger" type="button" class="w-full bg-[#EA580C] hover:bg-[#d94e05] text-white font-mono font-black text-xs py-4 rounded-lg uppercase tracking-widest transition-all duration-300 shadow-md cursor-pointer">
              Request 24H Moldflow Analysis & Quote →
            </button>
          </div>
        </div>

      </div>

      <!-- 👑 SEO 补充知识大盘 (Knowledge Matrix) -->
      <section class="mt-16 bg-white border-2 border-[#0F2B5B]/15 rounded-2xl p-6 sm:p-10 shadow-lg">
        <h3 class="text-xl font-[1000] font-sans uppercase italic text-[#0F2B5B] border-b-2 border-[#0F2B5B]/15 pb-4 mb-6">
          Understanding Injection Molding Clamp Tonnage Guidelines
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-sans text-xs text-[#0F2B5B]/80">
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2 text-[#EA580C]">1. Why Under-Sizing Clamp Force Causes Flash</h4>
            <p class="leading-relaxed">If cavity pressure exceeds the machine’s locking force, the mold platen flexes slightly along the parting line. This allows molten resin to escape, creating unwanted flash and dimensional growth.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2 text-[#EA580C]">2. Dangers of Over-Sizing Machine Tonnage</h4>
            <p class="leading-relaxed">Running a small mold on a 1000-ton press burns unnecessary electrical energy, crushes mold vents, and significantly increases hourly machine rate costs on your piece price.</p>
          </div>
          <div class="p-4 bg-[#FAFAFA] border border-[#0F2B5B]/10 rounded-xl">
            <h4 class="font-mono font-bold text-sm text-[#0F2B5B] mb-2 text-[#EA580C]">3. PEEK & High-Temp Resin Tonnage Penalty</h4>
            <p class="leading-relaxed">High-viscosity resins like PEEK and Ultem require elevated injection speeds and double the cavity holding pressure of standard ABS, requiring 4 to 8 tons per square inch of projected area.</p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <LeadModal lang="en" />
  <EcosystemFooter lang="en" />
</MainLayout>

<script>
  function setupClampCalculator() {
    const areaInput = document.getElementById('projected-area') as HTMLInputElement | null;
    const unitSelect = document.getElementById('area-unit') as HTMLSelectElement | null;
    const cavitiesInput = document.getElementById('cavities') as HTMLInputElement | null;
    const viscositySelect = document.getElementById('resin-viscosity') as HTMLSelectElement | null;
    const wallFactorSelect = document.getElementById('wall-factor') as HTMLSelectElement | null;

    const resUS = document.getElementById('result-clamping-tons');
    const resMetric = document.getElementById('result-clamping-metric');
    const resPress = document.getElementById('result-recommended-press');
    const resTotalArea = document.getElementById('result-total-area');
    const modalBtn = document.getElementById('clamp-rfq-trigger');

    if (!areaInput || !unitSelect || !cavitiesInput || !viscositySelect || !wallFactorSelect) return;

    function calculateTonnage() {
      let rawArea = parseFloat(areaInput!.value) || 100;
      const unit = unitSelect!.value;
      const cavities = parseInt(cavitiesInput!.value) || 1;
      const basePressure = parseFloat(viscositySelect!.value) || 450;
      const wallFactor = parseFloat(wallFactorSelect!.value) || 1.0;

      // 统一换算为 cm²
      let areaCm2 = rawArea;
      if (unit === 'in2') {
        areaCm2 = rawArea * 6.4516;
      }

      const totalAreaCm2 = areaCm2 * cavities;

      // 关模力计算公式：kN = Area(cm²) * Pressure(bar) * WallFactor * Safety(1.15) / 100
      const forceKn = (totalAreaCm2 * (basePressure / 10) * wallFactor * 1.15);
      const metricTonnes = Math.round(forceKn / 9.81);
      const usTons = Math.round(metricTonnes * 1.10231);

      // 推荐机台匹配 (海天 Haitian 伺服机型)
      let recommendedFleet = "Haitian MA900 Servo (90 Ton)";
      if (usTons > 90) recommendedFleet = "Haitian MA1200 Servo (120 Ton)";
      if (usTons > 120) recommendedFleet = "Haitian MA1600 Servo (160 Ton)";
      if (usTons > 160) recommendedFleet = "Haitian MA2000 Servo (200 Ton)";
      if (usTons > 200) recommendedFleet = "Haitian MA2800 Servo (280 Ton)";
      if (usTons > 280) recommendedFleet = "Haitian MA3800 Servo (380 Ton)";
      if (usTons > 380) recommendedFleet = "Haitian MA5300 Servo (530 Ton)";
      if (usTons > 530) recommendedFleet = "Haitian MA8000 Heavy Fleet (800 Ton)";
      if (usTons > 800) recommendedFleet = "Haitian MA12000 Heavy Fleet (1200 Ton)";

      if (resUS) resUS.textContent = `${usTons.toLocaleString()} US Tons`;
      if (resMetric) resMetric.textContent = `(${metricTonnes.toLocaleString()} Metric Tonnes / ${Math.round(forceKn).toLocaleString()} kN)`;
      if (resPress) resPress.textContent = recommendedFleet;
      if (resTotalArea) resTotalArea.textContent = `${Math.round(totalAreaCm2)} cm² (${(totalAreaCm2 / 6.4516).toFixed(1)} in²)`;
    }

    areaInput.addEventListener('input', calculateTonnage);
    unitSelect.addEventListener('change', calculateTonnage);
    cavitiesInput.addEventListener('input', calculateTonnage);
    viscositySelect.addEventListener('change', calculateTonnage);
    wallFactorSelect.addEventListener('change', calculateTonnage);

    if (modalBtn) {
      modalBtn.addEventListener('click', () => {
        if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
          (window as any).NEXMOLD_OPEN_LEAD_MODAL();
        } else {
          document.dispatchEvent(new CustomEvent('open-lead-modal'));
        }
      });
    }

    calculateTonnage();
  }

  document.addEventListener('astro:page-load', setupClampCalculator);
</script>