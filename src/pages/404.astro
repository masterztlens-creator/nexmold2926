---
import '../styles/global.css';

// src/pages/404.astro
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Page Not Found - NEXMOLD</title>
  </head>
  <body class="bg-white text-slate-900 font-sans min-h-screen flex flex-col justify-between">
    
    <!-- Top Announcement Bar -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 text-center">
      <span>Fleet Capacity: 90T - 1200T Haitian Injection Fleet</span>
      <span class="mx-3 text-slate-600">|</span>
      <span>Fast Lead Times & High Yield Assurance</span>
    </div>

    <!-- Main 404 Content -->
    <main class="max-w-4xl mx-auto px-6 py-24 text-center my-auto">
      <p class="text-base font-semibold text-blue-600 tracking-wide uppercase">404 Error</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
        Page not found
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-xl mx-auto">
        Sorry, we couldn’t find the page you’re looking for. Let’s get your manufacturing project back on track.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a 
          href="/" 
          class="px-6 py-3 bg-blue-600 text-white font-medium text-sm rounded-md shadow-sm hover:bg-blue-700 transition-colors"
        >
          Back to Homepage
        </a>
        <a 
          href="/quote/" 
          class="px-6 py-3 bg-slate-100 text-slate-800 font-medium text-sm rounded-md border border-slate-200 hover:bg-slate-200 transition-colors"
        >
          Request a Quote
        </a>
      </div>

      <!-- Quick Links -->
      <div class="mt-12 border-t border-slate-100 pt-8 max-w-md mx-auto">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Popular Destinations</p>
        <div class="flex justify-center space-x-6 text-sm font-medium text-blue-600">
          <a href="/services/" class="hover:underline">Services Overview</a>
          <a href="/services/injection-molding/" class="hover:underline">Injection Molding</a>
          <a href="/contact/" class="hover:underline">Contact Sales</a>
        </div>
      </div>
    </main>

    <!-- Simple Footer -->
    <footer class="border-t border-slate-100 py-6 text-center text-xs text-slate-400">
      &copy; {new Date().getFullYear()} NEXMOLD. All rights reserved.
    </footer>
  </body>
</html>