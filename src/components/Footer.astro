---
/**
 * Footer.astro - 100% NEXMOLD 品牌极简高奢白底版
 * 1. 消除事故：彻底替换掉个人 Gmail 邮箱，更正为官方 contact@nexmold.com 域名邮箱
 * 2. 品牌三色：100% 统一为 NEXMOLD 钛白/纯白 + 深蓝 (#0F2B5B) + 亮橙 (#EA580C)，彻底去除杂色 #F97316
 * 3. 视觉流体：钛白极简背景结合工业 HUD 实时世界时钟，优雅收尾
 * 4. 性能保障：保留了双时钟逻辑及内存泄漏清理机制
 */

interface Props {
  lang?: 'en' | 'de' | 'fr';
}

const { lang = 'en' } = Astro.props;

const i18n = {
  en: {
    cta_1: "Ready to",
    cta_2: "Scale?",
    desc: "NEXMOLD: Delivering uncompromising operational efficiency in injection molding. Bridging high-yield manufacturing capabilities with global industrial partners.",
    nav_1: "Navigation",
    nav_2: "Expertise",
    nav_3: "Global Operations",
    aria_nav: "Footer navigation links",
    aria_exp: "Core technical expertise links",
    aria_logo: "NEXMOLD Precision Systems - Global Headquarters",
    links: {
      nav: ["Capabilities", "Industries", "Tooling Hub", "Quality Control"],
      exp: ["Injection Plastic", "Overmolding", "Rapid Prototyping", "DFM Analysis"]
    }
  },
  de: {
    cta_1: "Bereit zum",
    cta_2: "Skalieren?",
    desc: "NEXMOLD: Kompromisslose betriebliche Effizienz im Spritzguss. Verbindung von Hochleistungs-Fertigungskapazitäten mit globalen Industriepartnern.",
    nav_1: "Navigation",
    nav_2: "Expertise",
    nav_3: "Globaler Betrieb",
    aria_nav: "Navigation im Footer",
    aria_exp: "Technische Fachgebiete",
    aria_logo: "NEXMOLD Präzisionssysteme - Hauptsitz",
    links: {
      nav: ["Kapazitäten", "Branchen", "Werkzeug-Hub", "Qualitätskontrolle"],
      exp: ["Spritzguss", "Overmolding", "Prototyping", "DFM-Analyse"]
    }
  },
  fr: {
    cta_1: "Prêt pour",
    cta_2: "l'Échelle ?",
    desc: "NEXMOLD : Une efficacité opérationnelle sans compromis en moulage par injection. Connecter des capacités de production à haut rendement aux partenaires mondiaux.",
    nav_1: "Navigation",
    nav_2: "Expertise",
    nav_3: "Opérations Globales",
    aria_nav: "Navigation en pied de page",
    aria_exp: "Expertise technique principale",
    aria_logo: "NEXMOLD Precision Systems - Siège mondial",
    links: {
      nav: ["Capacités", "Secteurs", "Centre Outillage", "Contrôle Qualité"],
      exp: ["Injection Plastique", "Surmoulage", "Prototypage Rapide", "Analyse DFM"]
    }
  }
};

const t = i18n[lang] || i18n.en;
---

<footer class="relative bg-[#FAFAFA] pt-[clamp(4rem,8vw,6rem)] pb-12 border-t-2 border-[#0F2B5B]/15 overflow-hidden select-none" aria-label="NEXMOLD Footer Information">
  
  <!-- 轻微工业网格底纹 -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]" 
       style="background-image: linear-gradient(#0F2B5B 1px, transparent 1px), linear-gradient(90deg, #0F2B5B 1px, transparent 1px);
       background-size: 40px 40px;"
       aria-hidden="true">
  </div>

  <div class="max-w-[1650px] mx-auto px-4 sm:px-[clamp(1.5rem,4vw,3.5rem)] relative z-10">
    
    <!-- 大字号 Action Banner (全站强粗斜体，亮橙高亮) -->
    <div class="mb-12 sm:mb-16 pb-10 border-b border-[#0F2B5B]/15">
      <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] font-[1000] font-sans text-[#0F2B5B] uppercase tracking-tighter italic leading-none">
        {t.cta_1} <span class="text-[#EA580C]">{t.cta_2}</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-12 gap-12 lg:gap-16 mb-16">
      
      <!-- 品牌 Logo 与 介绍 -->
      <div class="xl:col-span-4 flex flex-col items-start">
        <a href={lang === 'en' ? '/' : `/${lang}/`} class="group flex items-center gap-4 mb-6" aria-label={t.aria_logo}>
          <div class="relative w-12 h-12 flex items-center justify-center border border-[#0F2B5B]/20 rounded-md bg-white shadow-sm group-hover:border-[#EA580C] transition-colors">
            <div class="w-6 h-[2.5px] bg-[#EA580C] -rotate-45 shadow-sm group-hover:rotate-45 transition-transform duration-500"></div>
          </div>

          <div class="flex flex-col">
            <span class="text-2xl font-[1000] tracking-[ -0.05em] text-[#0F2B5B] leading-none italic uppercase font-sans">
              NEX<span class="text-[#EA580C]">MOLD</span>
            </span>
            <div class="flex items-center gap-2 mt-1.5">
              <div class="h-[1px] w-5 bg-[#EA580C]"></div>
              <span class="text-[9px] font-mono text-[#0F2B5B]/50 uppercase tracking-[0.4em] whitespace-nowrap">
                Precision_Systems
              </span>
            </div>
          </div>
        </a>

        <p class="text-[#0F2B5B]/70 text-sm font-bold font-sans leading-relaxed mb-8 pr-4 xl:pr-12">
          {t.desc}
        </p>

        <div class="flex space-x-3">
          <a href="#" class="w-9 h-9 border border-[#0F2B5B]/20 rounded-sm flex items-center justify-center text-[#0F2B5B]/60 hover:text-[#EA580C] hover:border-[#EA580C] bg-white transition-all shadow-xs" aria-label="Follow NEXMOLD on LinkedIn">
            <span class="text-xs font-mono font-black tracking-tighter">LN</span>
          </a>
          <a href="#" class="w-9 h-9 border border-[#0F2B5B]/20 rounded-sm flex items-center justify-center text-[#0F2B5B]/60 hover:text-[#EA580C] hover:border-[#EA580C] bg-white transition-all shadow-xs" aria-label="Watch NEXMOLD on YouTube">
            <span class="text-xs font-mono font-black tracking-tighter">YT</span>
          </a>
        </div>
      </div>

      <!-- 导航 1 -->
      <nav class="xl:col-span-2" aria-label={t.aria_nav}>
        <h4 class="text-xs font-mono font-black text-[#0F2B5B] uppercase tracking-widest mb-6 border-b border-[#0F2B5B]/10 pb-2">{t.nav_1}</h4>
        <ul class="space-y-3">
          {t.links.nav.map(link => (
            <li><a href="#" class="text-xs font-sans font-bold text-[#0F2B5B]/70 hover:text-[#EA580C] transition-colors uppercase tracking-tight block py-0.5">{link}</a></li>
          ))}
        </ul>
      </nav>

      <!-- 导航 2 -->
      <nav class="xl:col-span-2" aria-label={t.aria_exp}>
        <h4 class="text-xs font-mono font-black text-[#0F2B5B] uppercase tracking-widest mb-6 border-b border-[#0F2B5B]/10 pb-2">{t.nav_2}</h4>
        <ul class="space-y-3">
          {t.links.exp.map(link => (
            <li><a href="#" class="text-xs font-sans font-bold text-[#0F2B5B]/70 hover:text-[#EA580C] transition-colors uppercase tracking-tight block py-0.5">{link}</a></li>
          ))}
        </ul>
      </nav>

      <!-- 全球时钟与联系方式 -->
      <div class="md:col-span-2 xl:col-span-4 xl:border-l border-[#0F2B5B]/10 pl-0 xl:pl-12 mt-4 xl:mt-0">
        <h4 class="text-xs font-mono font-black text-[#EA580C] uppercase tracking-widest mb-6 border-b border-[#0F2B5B]/10 pb-2">{t.nav_3}</h4>
        
        <div class="space-y-4 max-w-sm">
          <div class="flex justify-between items-center pb-3 border-b border-[#0F2B5B]/10">
            <span class="text-xs text-[#0F2B5B]/70 font-mono font-bold">HQ / MFG (CN)</span>
            <span class="text-xs text-[#0F2B5B] font-mono font-black bg-white px-2 py-0.5 border border-[#0F2B5B]/10 rounded-xs" id="footer-time-cn">00:00:00 CST</span>
          </div>
          <div class="flex justify-between items-center pb-3 border-b border-[#0F2B5B]/10">
            <span class="text-xs text-[#0F2B5B]/70 font-mono font-bold">CLIENT HUB (EST)</span>
            <span class="text-xs text-[#0F2B5B] font-mono font-black bg-white px-2 py-0.5 border border-[#0F2B5B]/10 rounded-xs" id="footer-time-us">00:00:00 EST</span>
          </div>
          <div class="pt-2">
            <p class="text-[10px] text-[#EA580C] uppercase tracking-[0.2em] mb-1 font-mono font-black">Engineering_Support // 24h</p>
            <!-- 彻底修正：使用官方域名邮箱 -->
            <a href="mailto:contact@nexmold.com" class="text-lg sm:text-xl text-[#0F2B5B] hover:text-[#EA580C] transition-colors font-mono font-black" aria-label="Email our engineering team">
              contact@nexmold.com
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- 底部版权与认证 -->
    <div class="pt-8 border-t border-[#0F2B5B]/15 flex flex-col md:flex-row items-center justify-between gap-6">
      <p class="text-[10px] text-[#0F2B5B]/60 font-mono font-bold uppercase tracking-widest text-center md:text-left">
        &copy; {new Date().getFullYear()} NEXMOLD PRECISION SYSTEMS. ALL RIGHTS RESERVED.
      </p>
      
      <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-[10px] font-mono font-black text-[#0F2B5B]/70 uppercase tracking-widest">
        <span class="hover:text-[#EA580C] transition-colors" title="Quality Management System Certified">ISO 9001:2015</span>
        <span class="hidden md:block w-1.5 h-1.5 rounded-full bg-[#EA580C]" aria-hidden="true"></span>
        <span class="hover:text-[#EA580C] transition-colors" title="Automotive Supply Chain Compliance">IATF 16949 COMPLIANT</span>
        <span class="hidden md:block w-1.5 h-1.5 rounded-full bg-[#EA580C]" aria-hidden="true"></span>
        <span class="hover:text-[#EA580C] transition-colors" title="Data Security Encrypted">SSL SECURED</span>
      </div>
    </div>

  </div>
</footer>

<script>
  function initClocks() {
    const elCn = document.getElementById('footer-time-cn');
    const elUs = document.getElementById('footer-time-us');
    function update() {
      const now = new Date();
      // 中国时间
      const cnTime = now.toLocaleTimeString('en-US', { 
        timeZone: 'Asia/Shanghai', 
        hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' 
      });
      if(elCn) elCn.textContent = cnTime + ' CST';

      // 美国东部时间
      const usTime = now.toLocaleTimeString('en-US', { 
        timeZone: 'America/New_York', 
        hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' 
      });
      if(elUs) elUs.textContent = usTime + ' EST';
    }

    const clockInterval = setInterval(update, 1000);
    update();
    // 清除定时器
    document.addEventListener('astro:before-swap', () => clearInterval(clockInterval), { once: true });
  }

  initClocks();
  document.addEventListener('astro:after-swap', initClocks);
</script>

<style>
  p { text-wrap: pretty; }
</style>