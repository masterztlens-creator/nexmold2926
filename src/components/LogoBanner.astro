---
/**
 * LogoBanner.astro - 18 家大厂/标杆无限平滑无缝流动墙
 * 1. 扩充至 18 个国际重工/家电/汽车/医疗标杆品牌与领域
 * 2. 纯 CSS 60fps 平滑循环，鼠标悬停即停
 * 3. 纯粹三色规范：纯白 (#FFFFFF) + 工业深蓝 (#0F2B5B) + 重工橙 (#EA580C)
 */

interface Props {
  lang?: 'en' | 'de' | 'fr';
}

const { lang = 'en' } = Astro.props;

const i18n: Record<string, any> = {
  en: { label: "Innovative Companies & Global OEMs We Support" },
  de: { label: "Unternehmen & Globale OEMs, Die Wir Unterstützen" },
  fr: { label: "Équipementiers Mondiaux et Entreprises Accompagnées" }
};

const t = i18n[lang] || i18n.en;

// 18 个行业标杆品牌与领域（覆盖家电、汽车、工具、医疗、智能硬件）
const logoList = [
  { name: "BLUE ORIGIN", svg: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" },
  { name: "JOHN DEERE", svg: "M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94A5.01 5.01 0 0011 17.9v2.1H8v2h8v-2h-3v-2.1c1.86-.42 3.32-1.83 3.61-3.66C19.08 13.63 21 11.55 21 9V7c0-1.1-.9-2-2-2z" },
  { name: "BOSCH GROUP", svg: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" },
  { name: "MILWAUKEE TOOL", svg: "M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z" },
  { name: "MEDTRONIC", svg: "M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" },
  { name: "WHIRLPOOL CORP", svg: "M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" },
  { name: "CONTINENTAL TIER-1", svg: "M12 2L2 22h20L12 2zm0 4.5l6.5 13.5h-13L12 6.5z" },
  { name: "DEWALT INDUSTRIAL", svg: "M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" },
  { name: "SONOS ELECTRONICS", svg: "M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" },
  { name: "DYSON APPLIANCES", svg: "M12 4a8 8 0 100 16 8 8 0 000-16zm0 14a6 6 0 110-12 6 6 0 010 12z" },
  { name: "MAGNA INTERNATIONAL", svg: "M3 13h18v-2H3v2zm0 4h18v-2H3v2zm0-8h18V7H3v2z" },
  { name: "HONEYWELL OEM", svg: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" },
  { name: "MAKITA POWER", svg: "M13 3h-2v10h2V3zm4 4h-2v6h2V7zm-8 2H7v4h2V9z" },
  { name: "VALEO AUTOMOTIVE", svg: "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" },
  { name: "RING SMART HOME", svg: "M12 2A10 10 0 002 12a10 10 0 0010 10 10 10 0 0010-10A10 10 0 0012 2zm0 18a8 8 0 110-16 8 8 0 010 16z" },
  { name: "APTIV EV SYSTEMS", svg: "M11 15h2v2h-2zm0-8h2v6h-2zm1-5C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" },
  { name: "POLARIS", svg: "M12 2L4.5 20.29l.71.71L12 18l6.79 3 .71-.71z" },
  { name: "MARELLI TIER-1", svg: "M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 8c-1.65 0-3-1.35-3-3s1.35-3 3-3 3 1.35 3 3-1.35 3-3 3z" }
];
---

<section class="w-full bg-white border-y border-[#0F2B5B]/10 py-5 relative z-20 overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-[clamp(1.5rem,5vw,4rem)] flex flex-col xl:flex-row items-center gap-4 xl:gap-8">
    
    <!-- 左侧固定标题 -->
    <div class="shrink-0 flex items-center gap-3 z-10 bg-white pr-4">
      <span class="font-mono text-xs font-bold text-[#0F2B5B]/60 tracking-tight whitespace-nowrap uppercase">
        {t.label}
      </span>
      <span class="hidden xl:block w-[1px] h-4 bg-[#0F2B5B]/20"></span>
    </div>

    <!-- 右侧 18 大品牌无缝流动容器 -->
    <div class="w-full overflow-hidden relative flex-1 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
      
      <div class="flex items-center w-max animate-marquee hover:[animation-play-state:paused] opacity-70 hover:opacity-100 transition-opacity duration-300">
        
        <!-- 第一组 18 家大厂 -->
        <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0">
          {logoList.map(item => (
            <div class="flex items-center gap-2.5 group cursor-default">
              <svg class="w-4 h-4 fill-[#0F2B5B] group-hover:fill-[#EA580C] transition-colors shrink-0" viewBox="0 0 24 24">
                <path d={item.svg}/>
              </svg>
              <span class="font-sans text-xs sm:text-sm font-black tracking-wider text-[#0F2B5B] group-hover:text-[#EA580C] transition-colors uppercase whitespace-nowrap">
                {item.name}
              </span>
            </div>
          ))}
        </div>

        <!-- 第二组 18 家大厂 (完全无缝循环) -->
        <div class="flex items-center gap-10 sm:gap-14 pr-10 sm:pr-14 shrink-0" aria-hidden="true">
          {logoList.map(item => (
            <div class="flex items-center gap-2.5 group cursor-default">
              <svg class="w-4 h-4 fill-[#0F2B5B] group-hover:fill-[#EA580C] transition-colors shrink-0" viewBox="0 0 24 24">
                <path d={item.svg}/>
              </svg>
              <span class="font-sans text-xs sm:text-sm font-black tracking-wider text-[#0F2B5B] group-hover:text-[#EA580C] transition-colors uppercase whitespace-nowrap">
                {item.name}
              </span>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    /* 18 个品牌的充沛长河，40s 保持完美丝滑滚动 */
    animation: marquee 40s linear infinite;
  }
</style>