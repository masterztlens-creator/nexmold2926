---

<section class="relative bg-[#0B1221] py-[clamp(4rem,10vw,12rem)] border-b border-white/5 overflow-hidden" id="materials-matrix" aria-labelledby="matrix-title" data-location={location}>
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#F97316 0.5px, transparent 0.5px); background-size: 30px 30px;" aria-hidden="true"></div>

  <div class="max-w-[1400px] mx-auto px-[clamp(1.5rem,5vw,8rem)] relative z-10">
    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-12 mb-[clamp(4rem,6vw,6rem)]" data-aos="fade-up">
      <div>
        <p class="text-[#F97316] font-mono text-[10px] uppercase tracking-[0.5em] mb-6">// {t.tag} ({location})</p>
        <h2 id="matrix-title" class="font-[1000] text-white uppercase tracking-tighter italic leading-[0.9] text-[clamp(3rem,7vw,8.5rem)]">
          <span class="inline-word mr-[clamp(0.5rem,2vw,1.5rem)]">{t.title_1}</span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-white/10">{t.title_2}</span>
        </h2>
      </div>
      
      <div class="flex p-1 bg-white/5 border border-white/10 rounded-sm w-full lg:w-auto overflow-x-auto" role="tablist">
        {t.tabs.map((tab, idx) => (
          <button role="tab" aria-selected={idx === 0 ? "true" : "false"} aria-controls={`panel-${idx}`} aria-label={t.aria_tabs[idx]} class:list={["flex-1 lg:flex-none px-6 lg:px-10 py-3 text-[10px] font-black uppercase tracking-widest transition-all duration-500 whitespace-nowrap cursor-pointer", idx === 0 ? "bg-[#F97316] text-[#0B1221]" : "text-white/40 hover:text-white"]} data-matrix-trigger={idx}>
            {tab}
          </button>
        ))}
      </div>
    </div>

    <div class="relative min-h-[450px]">
      <!-- 面板 0：38 种最全特种树脂大盘（专属利基按需轰炸）[cite: 1] -->
      <div id="panel-0" role="tabpanel" class="matrix-panel active transition-all duration-700" data-matrix-panel="0">
        <div class="flex items-center space-x-4 mb-12 opacity-60 italic text-[#94A3B8]">
           <span class="w-8 h-px bg-[#F97316]"></span>
           <p class="text-[clamp(0.75rem,1.5vw,0.875rem)] font-light">{t.material_desc}</p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          {materialsList.map((mat: any) => (
            <div class="group p-[clamp(1.5rem,3vw,2.5rem)] border border-white/5 bg-white/[0.01] hover:bg-white/[0.02] hover:border-[#F97316]/40 transition-all duration-500 relative flex flex-col justify-between">
              <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#F97316]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div>
                <span class="text-[8px] text-[#F97316] font-mono uppercase block mb-6 tracking-widest opacity-60">RESIN::{mat.slug.toUpperCase()}</span>
                <h4 class="text-[clamp(1.25rem,2vw,1.5rem)] font-black text-white mb-4 group-hover:text-[#F97316] transition-colors leading-none italic">
                  {mat.name.includes('(') ? mat.name.split(' ')[0] : mat.name}
                </h4>
                <p class="text-white/40 text-[10px] font-mono uppercase tracking-wide mb-8">Melt: {mat.meltTemp} | Mold: {mat.moldTemp}</p>
              </div>

              <div class="pt-6 border-t border-white/5 mt-auto space-y-2.5">
                <span class="text-[8px] font-mono text-white/30 tracking-wider block uppercase">{t.segment_label}</span>
                {mat.targetedIndustries?.map((ind: any) => (
                  <a href={`/${mat.slug}/${ind.industrySlug}/${ind.componentSlug}`} class="flex items-center justify-between bg-[#0B1221] border border-white/5 px-4 py-3 rounded text-[11px] font-mono text-white/70 hover:text-white hover:border-[#F97316]/40 hover:bg-[#F97316]/5 transition-all group/link">
                    <span class="font-medium truncate pr-2">{ind.componentName}</span>
                    <span class="text-[#F97316] transform group-hover/link:translate-x-1 transition-transform">&rarr;</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 👑 面板 1：硬核表面工艺大盘（彻底消灭敷衍，填充重工业规格！）[cite: 1] -->
      <div id="panel-1" role="tabpanel" class="matrix-panel absolute top-0 left-0 w-full opacity-0 pointer-events-none transition-all duration-700" data-matrix-panel="1">
        <div class="flex items-center space-x-4 mb-12 opacity-60 italic text-[#94A3B8]">
           <span class="w-8 h-px bg-[#F97316]"></span>
           <p class="text-[clamp(0.75rem,1.5vw,0.875rem)] font-light">{t.finish_desc}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          {standardFinishes.map((item) => (
            <div class="group p-[clamp(1.5rem,3vw,2.5rem)] border border-white/5 bg-white/[0.01] hover:bg-white/[0.03] hover:border-[#F97316]/40 transition-all duration-500 relative flex flex-col justify-between">
              <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#F97316]/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div>
                <span class="text-[8px] text-[#F97316] font-mono uppercase block mb-6 tracking-widest opacity-60">{item.cat}</span>
                <h4 class="text-[clamp(1.25rem,2vw,1.5rem)] font-black text-white mb-2 group-hover:text-[#F97316] transition-colors leading-none italic">{item.name}</h4>
                <p class="text-white/40 text-[10px] font-mono uppercase tracking-wide mb-6">{item.spec}</p>
                <p class="text-white/60 text-xs leading-relaxed font-light mb-8">{item.desc}</p>
              </div>
              <div class="pt-6 border-t border-white/5 mt-auto">
                <span class="text-[8px] font-mono text-white/30 tracking-wider block uppercase mb-1">Recommended Cavity Steel:</span>
                <p class="text-[10px] text-[#F97316] font-mono uppercase tracking-widest font-bold italic">{item.steel}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupMatrix() {
    const triggers = document.querySelectorAll('[data-matrix-trigger]');
    const panels = document.querySelectorAll('[data-matrix-panel]');
    if(!triggers.length || !panels.length) return;

    triggers.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-matrix-trigger');
        triggers.forEach(b => {
          b.classList.remove('bg-[#F97316]', 'text-[#0B1221]');
          b.classList.add('text-white/40');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('bg-[#F97316]', 'text-[#0B1221]');
        btn.classList.remove('text-white/40');
        btn.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          (p as HTMLElement).classList.add('opacity-0', 'pointer-events-none', 'absolute');
        });
        const activePanel = document.querySelector(`[data-matrix-panel="${id}"]`) as HTMLElement;
        if (activePanel) activePanel.classList.remove('opacity-0', 'pointer-events-none', 'absolute');
      });
    });
  }
  setupMatrix();
  document.addEventListener('astro:page-load', setupMatrix);
  document.addEventListener('astro:after-swap', setupMatrix);
</script>

<style>
  .inline-word { display: inline-block; white-space: nowrap; }
  h2 { overflow-wrap: normal; word-break: normal; }
</style>