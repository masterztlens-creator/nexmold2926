<!-- 鈿★笍 闃查槻闃查噸浜嬩欢缁戝畾閫昏緫 -->
<script>
  function initTabLogic() {
    const section = document.getElementById('manufacturing-services');
    if (!section) return;

    const tabBtns = section.querySelectorAll('.tab-btn');
    const tabContents = section.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      // 鍏嬮殕鑺傜偣娓呯悊鏃т簨浠剁洃鍚紝闃叉 View Transitions 鍦烘櫙涓嬮噸澶嶇粦瀹?
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        const targetId = (newBtn as HTMLElement).getAttribute('data-target');
        if (!targetId) return;

        section.querySelectorAll<HTMLElement>('.tab-btn').forEach(b => {
          b.classList.remove('border-[#EA580C]', 'text-[#EA580C]', 'font-black');
          b.classList.add('border-transparent', 'text-[#0F2B5B]/60');
        });

        newBtn.classList.add('border-[#EA580C]', 'text-[#EA580C]', 'font-black');
        newBtn.classList.remove('border-transparent', 'text-[#0F2B5B]/60');

        tabContents.forEach(content => {
          content.classList.add('hidden', 'opacity-0');
          content.classList.remove('block', 'opacity-100');
        });

        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.remove('hidden');
          setTimeout(() => {
            targetContent.classList.add('block', 'opacity-100');
            targetContent.classList.remove('opacity-0');
          }, 10);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTabLogic);
  document.addEventListener('astro:after-swap', initTabLogic);
</script>



