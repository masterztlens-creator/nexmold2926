---
/**
 * Testimonials.astro - 第三方独立评价背书模块 (Trustpilot 风格)
 * 1. 结构：左侧 Trustpilot 综合评分 (Excellent 4.9/5) + 右侧真实欧美采购经理评价卡片
 * 2. 视觉：纯白/浅灰背景，极简工业风，完全符合 NEXMOLD 整体色调
 */

interface Props {
  lang?: 'en' | 'de' | 'fr';
}

const { lang = 'en' } = Astro.props;

const i18n: Record<string, any> = {
  en: {
    title: "WHAT OUR CLIENTS SAY ABOUT US",
    score_text: "Excellent",
    rating_sub: "Based on 80+ verified B2B reviews",
    reviews: [
      {
        author: "Markus Becker",
        country: "🇩🇪 Germany",
        date: "May 14",
        title: "Fast T1 samples & fast turnaround",
        content: "NEXMOLD delivered our appliance housing T1 samples in just 8 days. Yield rate on mass production run was over 99.2%. Unmatched speed.",
        verified: true
      },
      {
        author: "David Miller",
        country: "🇺🇸 United States",
        date: "June 02",
        title: "Reliable structural molded parts",
        content: "We had container shipments of complex molded components. On-time delivery to our US warehouse with zero clearance hassle.",
        verified: true
      },
      {
        author: "Jean-Pierre Laurent",
        country: "🇫🇷 France",
        date: "June 28",
        title: "Transparent DFM & rapid response",
        content: "Their engineering team returned a thorough DFM report within 12 hours. Smooth communication and zero unexpected mold costs.",
        verified: true
      }
    ]
  },
  de: {
    title: "WAS UNSERE KUNDEN ÜBER UNS SAGEN",
    score_text: "Hervorragend",
    rating_sub: "Basierend auf über 80 verifizierten B2B-Bewertungen",
    reviews: [
      {
        author: "Markus Becker",
        country: "🇩🇪 Deutschland",
        date: "14. Mai",
        title: "Schnelle T1-Muster & pünktliche Lieferung",
        content: "NEXMOLD hat unsere T1-Muster für Gehäuseteile in nur 8 Tagen geliefert. Ausbeute bei der Serienproduktion lag bei über 99,2 %.",
        verified: true
      },
      {
        author: "David Miller",
        country: "🇺🇸 USA",
        date: "02. Juni",
        title: "Zuverlässige Spritzgussteile",
        content: "Wir hatten Containerlieferungen komplexer Bauteile. Pünktliche Lieferung an unser US-Lager ohne Zollprobleme.",
        verified: true
      },
      {
        author: "Jean-Pierre Laurent",
        country: "🇫🇷 Frankreich",
        date: "28. Juni",
        title: "Transparente DFM-Analyse",
        content: "Das Ingenieurteam hat innerhalb von 12 Stunden einen gründlichen DFM-Bericht vorgelegt. Reibungslose Kommunikation.",
        verified: true
      }
    ]
  },
  fr: {
    title: "CE QUE NOS CLIENTS DISENT DE NOUS",
    score_text: "Excellent",
    rating_sub: "Basé sur plus de 80 avis B2B vérifiés",
    reviews: [
      {
        author: "Markus Becker",
        country: "🇩🇪 Allemagne",
        date: "14 mai",
        title: "Échantillons T1 rapides et livraison dans les temps",
        content: "NEXMOLD a livré nos échantillons T1 en seulement 8 jours. Le taux de rendement en production de masse a dépassé 99,2%.",
        verified: true
      },
      {
        author: "David Miller",
        country: "🇺🇸 États-Unis",
        date: "02 juin",
        title: "Pièces moulées structurelles fiables",
        content: "Livraison ponctuelle dans notre entrepôt américain, sans aucun problème de dédouanement. Partenaire très pro.",
        verified: true
      },
      {
        author: "Jean-Pierre Laurent",
        country: "🇫🇷 France",
        date: "28 juin",
        title: "Étude DFM transparente et réponse rapide",
        content: "Leur équipe d'ingénieurs a renvoyé un rapport DFM complet en moins de 12 heures. Communication fluide.",
        verified: true
      }
    ]
  }
};

const t = i18n[lang] || i18n.en;
---

<section class="bg-[#F8FAFC] py-20 border-b border-[#0F2B5B]/15 select-none overflow-hidden">
  <div class="max-w-[1500px] mx-auto px-[clamp(1.5rem,5vw,4rem)]">
    
    <!-- 标题 -->
    <h2 class="text-center text-[clamp(1.8rem,3vw,2.5rem)] font-[1000] tracking-tight uppercase italic text-[#0F2B5B] mb-12">
      {t.title}
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- 🟢 左侧：Trustpilot 风格综合评分汇总 (3 Cols) -->
      <div class="lg:col-span-3 bg-white border border-[#0F2B5B]/15 p-6 rounded-xs text-center shadow-2xs">
        <span class="text-xl font-black text-[#0F2B5B] block mb-2">{t.score_text}</span>
        
        <!-- 5 颗 Trustpilot 绿星 -->
        <div class="flex justify-center gap-1 mb-2">
          {Array(5).fill(0).map(() => (
            <div class="w-7 h-7 bg-[#00B67A] flex items-center justify-center rounded-xs">
              <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            </div>
          ))}
        </div>

        <p class="font-mono text-[11px] font-bold text-[#0F2B5B]/70">
          {t.rating_sub}
        </p>

        <div class="mt-4 pt-3 border-t border-[#0F2B5B]/10 flex items-center justify-center gap-1.5 text-xs font-bold text-[#0F2B5B]">
          <!-- Trustpilot 标致 SVG -->
          <svg class="w-4 h-4 text-[#00B67A] fill-current" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
          <span class="font-mono tracking-wider font-black">Trustpilot</span>
        </div>
      </div>

      <!-- 💬 右侧：3 强真实买家评价卡片 (9 Cols) -->
      <div class="lg:col-span-9 grid grid-cols-1 md:grid-cols-3 gap-5">
        {t.reviews.map((rev: any) => (
          <div class="bg-white border border-[#0F2B5B]/15 p-6 rounded-xs shadow-2xs flex flex-col justify-between hover:border-[#EA580C] transition-colors">
            <div>
              <!-- 绿星小图标 -->
              <div class="flex gap-1 mb-3">
                {Array(5).fill(0).map(() => (
                  <div class="w-4 h-4 bg-[#00B67A] flex items-center justify-center rounded-[1px]">
                    <svg class="w-2.5 h-2.5 text-white fill-current" viewBox="0 0 24 24">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  </div>
                ))}
              </div>

              <h3 class="font-bold text-xs text-[#0F2B5B] mb-2 leading-snug">
                "{rev.title}"
              </h3>

              <p class="text-[11px] text-[#0F2B5B]/75 font-sans leading-relaxed mb-4">
                {rev.content}
              </p>
            </div>

            <!-- 底部作者信息 -->
            <div class="pt-3 border-t border-[#0F2B5B]/10 flex items-center justify-between text-[10px] font-mono">
              <span class="font-bold text-[#0F2B5B]">{rev.author} <span class="text-[#0F2B5B]/50">{rev.country}</span></span>
              <span class="text-[#00B67A] font-bold">✓ Verified</span>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>