---
/**
 * Header.astro - NEXMOLD 全球工业级旗舰导航组件 (分类路径全对齐版)
 */

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

interface TranslationItem {
  services: string;
  industries: string;
  materials: string;
  knowledgeHub: string;
  company: string;
  cta: string;
  sampleKit: string;
  shortName: string;
  pathPrefix: string;
  logoTitle: string;
  searchPlaceholder: string;
  expertConsult: string;
  viewAllResins: string;
  virginGuarantee: string;
}

const translations: Record<string, TranslationItem> = {
  en: {
    services: 'Services',
    industries: 'Industries',
    materials: 'Materials',
    knowledgeHub: 'Knowledge Hub',
    company: 'Company',
    cta: 'Get Quote',
    sampleKit: 'Sample Kit',
    shortName: 'EN',
    pathPrefix: '',
    logoTitle: 'NEXMOLD - Precision Injection Molding & Tooling Factory',
    searchPlaceholder: 'Search 180+ resins (e.g. PEEK, PA66-GF30, ABS)...',
    expertConsult: 'Unsure which resin to choose? Chat with our Polymer Engineer',
    viewAllResins: 'Explore 180+ Polymer Hub Matrix',
    virginGuarantee: '100% Virgin Resins with Lot Traceability & CoC'
  },
  de: {
    services: 'Dienstleistungen',
    industries: 'Branchen',
    materials: 'Materialien',
    knowledgeHub: 'Wissenszentrum',
    company: 'Unternehmen',
    cta: 'Angebot anfordern',
    sampleKit: 'Musterbox',
    shortName: 'DE',
    pathPrefix: '/de',
    logoTitle: 'NEXMOLD - Präzisions-Spritzguss & Formenbau',
    searchPlaceholder: '180+ Kunststoffe durchsuchen (z.B. PEEK, PA66)...',
    expertConsult: 'Unsicher bei der Materialwahl? Sprechen Sie mit unserem Ingenieur',
    viewAllResins: '180+ Polymer-Datenbank öffnen',
    virginGuarantee: '100% Neuware mit Chargenrückverfolgung & Werkszeugnis'
  },
  fr: {
    services: 'Services',
    industries: 'Secteurs',
    materials: 'Matériaux',
    knowledgeHub: 'Centre Technique',
    company: 'Société',
    cta: 'Devis Rapide',
    sampleKit: 'Échantillons',
    shortName: 'FR',
    pathPrefix: '/fr',
    logoTitle: 'NEXMOLD - Moulage par Injection & Outillage de Précision',
    searchPlaceholder: 'Rechercher parmi 180+ résines (ex. PEEK, PA66)...',
    expertConsult: 'Besoin d’aide pour choisir ? Consultez notre ingénieur polymère',
    viewAllResins: 'Accéder à la base de 180+ polymères',
    virginGuarantee: 'Résines 100% vierges garanties avec traçabilité & CoC'
  }
};

const t = translations[lang] || translations.en;

const navLinks = [
  { name: t.services, href: `${t.pathPrefix}/services`, key: 'services' },
  { name: t.industries, href: `${t.pathPrefix}/industries`, key: 'industries' },
  { name: t.materials, href: `${t.pathPrefix}/materials`, key: 'materials' },
  { name: t.knowledgeHub, href: `${t.pathPrefix}/knowledge-hub`, key: 'knowledgeHub' },
  { name: t.company, href: `${t.pathPrefix}/company`, key: 'company' },
];

const locales = Object.keys(translations);

const schemaNavData = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": "NEXMOLD Global Navigation",
  "url": "https://nxmold.com",
  "hasPart": [
    { "@type": "WebPage", "name": "Plastic Injection Molding Services", "url": `https://nxmold.com${t.pathPrefix}/services/injection-molding` },
    { "@type": "WebPage", "name": "Precision Tooling & Rapid Molds", "url": `https://nxmold.com${t.pathPrefix}/services/tooling` },
    { "@type": "WebPage", "name": "180+ Polymer Material Hub", "url": `https://nxmold.com${t.pathPrefix}/materials` },
    { "@type": "WebPage", "name": "Engineering Knowledge Hub & DFM Calculators", "url": `https://nxmold.com${t.pathPrefix}/knowledge-hub` }
  ]
};
---

<!-- Schema.org 结构化数据 -->
<script type="application/ld+json" set:html={JSON.stringify(schemaNavData)} />

<!-- 吸顶 Header -->
<header 
  id="main-header" 
  class="sticky top-0 z-[100] w-full bg-white transition-all duration-300 border-b border-[#0F2B5B]/15 shadow-xs select-none"
  itemscope 
  itemtype="https://schema.org/SiteNavigationElement"
>
  <div class="max-w-[1560px] mx-auto px-4 sm:px-6 lg:px-10 py-3 flex items-center justify-between static">
    
    <!-- Logo 区域 -->
    <a 
      href={t.pathPrefix || "/"} 
      class="group flex items-center gap-3.5 relative z-[110] focus-visible:outline-2 focus-visible:outline-[#EA580C] focus-visible:outline-offset-2 rounded-xs" 
      title={t.logoTitle} 
      aria-label="NEXMOLD Homepage" 
      itemprop="url"
    >
      <div class="relative w-9 h-9 lg:w-10 lg:h-10 flex items-center justify-center overflow-visible">
        <div class="absolute inset-0 border border-[#0F2B5B]/30 group-hover:border-[#EA580C] transition-colors duration-500 rounded-xs"></div>
        <div class="absolute left-1.5 top-1.5 w-[2px] h-4 bg-[#0F2B5B] group-hover:-translate-y-0.5 transition-transform duration-500"></div>
        <div class="absolute right-1.5 bottom-1.5 w-[2px] h-4 bg-[#0F2B5B] group-hover:translate-y-0.5 transition-transform duration-500"></div>
        <div class="w-4 h-[2px] bg-[#EA580C] -rotate-45 group-hover:rotate-45 transition-transform duration-700"></div>
      </div>
      
      <div class="flex flex-col">
        <span class="text-xl lg:text-2xl font-[1000] tracking-[-0.05em] text-[#0F2B5B] leading-none italic uppercase" itemprop="name">
          NEX<span class="text-[#EA580C]">MOLD</span>
        </span>
        <span class="text-[8px] font-mono tracking-[0.22em] text-slate-500 font-bold uppercase mt-0.5">Precision Tooling</span>
      </div>
    </a>

    <!-- 桌面端主导航 -->
    <nav class="hidden xl:flex items-center gap-8 xl:gap-10 static" aria-label="Main Navigation">
      {navLinks.map((link) => (
        <div class="group/nav h-full flex items-center py-2.5 static">
          <a 
            href={link.href} 
            class="relative group/link py-1 focus-visible:outline-2 focus-visible:outline-[#EA580C] rounded-xs" 
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls={`megamenu-${link.key}`}
            itemprop="url"
          >
            <div class="flex items-center">
              <span class="text-[11.5px] font-bold uppercase tracking-[0.14em] text-[#0F2B5B] group-hover/link:text-[#EA580C] transition-colors duration-200 flex items-center gap-1.5" itemprop="name">
                {link.name}
                <svg class="w-3 h-3 transition-transform duration-200 group-hover/nav:rotate-180 text-[#0F2B5B]/40 group-hover/link:text-[#EA580C]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </div>
            <div class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#EA580C] group-hover/link:w-full transition-all duration-300"></div>
          </a>

          <!-- 1. SERVICES MEGA MENU -->
          {link.key === 'services' && (
            <div 
              id="megamenu-services" 
              class="mega-menu-panel absolute top-full left-0 right-0 w-full bg-white border-y border-slate-200 border-b-4 border-b-[#EA580C] shadow-2xl opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-200 py-6 z-[105]"
              role="region"
              aria-label="Services Submenu"
            >
              <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 grid grid-cols-5 gap-7 text-left">
                <div class="flex flex-col">
                  <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center">
                    <a href={`${t.pathPrefix}/services/dfm-engineering`} class="text-xs font-bold text-[#0F2B5B] hover:text-[#EA580C] uppercase tracking-wider transition-colors flex items-center gap-1">
                      <span>Engineering & DFM</span>
                      <span class="text-[9px] text-[#0F2B5B]/40">→</span>
                    </a>
                  </div>
                  <ul class="space-y-2 h-[220px] flex flex-col justify-between" role="list">
                    <li>
                      <a href={`${t.pathPrefix}/services/dfm-moldflow`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Free 24h Engineering DFM</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Wall thickness, draft & gate analysis</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/moldflow-simulation`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Moldflow Simulation (CAE)</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Weld line, air trap & thermal warp check</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/cad-optimization`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">CAD Part Optimization</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Sink mark elimination & rib design</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/scientific-molding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Scientific Molding DOE</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Decoupled molding & process stability</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/cost-reduction`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Tooling Cost Optimization</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Cavity layout & cycle time reduction</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="flex flex-col">
                  <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center">
                    <a href={`${t.pathPrefix}/services/tooling`} class="text-xs font-bold text-[#0F2B5B] hover:text-[#EA580C] uppercase tracking-wider transition-colors flex items-center gap-1">
                      <span>Tooling & Rapid Molds</span>
                      <span class="text-[9px] text-[#0F2B5B]/40">→</span>
                    </a>
                  </div>
                  <ul class="space-y-2 h-[220px] flex flex-col justify-between" role="list">
                    <li>
                      <a href={`${t.pathPrefix}/services/rapid-tooling`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Rapid Prototype Tooling</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Aluminum & P20 molds <span class="text-slate-300">•</span> T1 in 5-10 days</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/production-tooling`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Production Tooling (Class 101)</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Hardened S136 / H13 <span class="text-slate-300">•</span> 1M+ shots</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/multi-cavity-molds`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Multi-Cavity Precision Molds</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">High cavitation with hot runner valve gates</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/export-molds`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Export Mold Building</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">DME / HASCO standard molds for US & EU</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/mold-maintenance`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Lifetime Tooling Guarantee</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">100% Free mold maintenance during production</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="flex flex-col">
                  <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center">
                    <a href={`${t.pathPrefix}/services/injection-molding`} class="text-xs font-bold text-[#0F2B5B] hover:text-[#EA580C] uppercase tracking-wider transition-colors flex items-center gap-1">
                      <span>Injection Molding</span>
                      <span class="text-[9px] text-[#0F2B5B]/40">→</span>
                    </a>
                  </div>
                  <ul class="space-y-2 h-[220px] flex flex-col justify-between" role="list">
                    <li>
                      <a href={`${t.pathPrefix}/services/low-volume-molding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Low-Volume / Bridge Molding</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">100 to 10,000+ parts <span class="text-slate-300">•</span> Fast turnaround</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/high-volume-molding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">High-Volume Production</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">90T-1200T fleet with 24/7 robotic cells</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/custom-injection-molding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Custom Plastic Molding</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Appliance housings, structural & rigid parts</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/insert-molding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Insert & Threaded Molding</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Brass bushings, stamped leads & encapsulation</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/overmolding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Two-Shot (2K) & Overmolding</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">TPE/TPU soft touch grips & sealing perimeters</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="flex flex-col">
                  <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center">
                    <a href={`${t.pathPrefix}/services/post-processing`} class="text-xs font-bold text-[#0F2B5B] hover:text-[#EA580C] uppercase tracking-wider transition-colors flex items-center gap-1">
                      <span>Post-Processing & QC</span>
                      <span class="text-[9px] text-[#0F2B5B]/40">→</span>
                    </a>
                  </div>
                  <ul class="space-y-2 h-[220px] flex flex-col justify-between" role="list">
                    <li>
                      <a href={`${t.pathPrefix}/services/ultrasonic-welding`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Ultrasonic Plastic Welding</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Hermetic sealing for pressure tanks & shells</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/heat-staking`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Brass Threaded Heat Staking</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Thermal insert installation for M2-M8 nuts</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/pad-printing`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Surface Branding & Printing</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Pad printing, silkscreen & laser marking</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/cmm-inspection`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Zeiss CMM Inspection & FAI</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Full dimensional reports to DIN 16742</span>
                      </a>
                    </li>
                    <li>
                      <a href={`${t.pathPrefix}/services/contract-assembly`} class="group/item block p-1 -mx-1 rounded-xs hover:bg-slate-50 transition-colors">
                        <span class="text-xs font-bold text-[#0F2B5B] group-hover/item:text-[#EA580C] transition-colors block truncate">Box-Build & Final Assembly</span>
                        <span class="text-[11px] text-[#475569] block leading-tight mt-0.5 truncate">Turnkey mechanical packing & Amazon FBA</span>
                      </a>
                    </li>
                  </ul>
                </div>

                <div class="flex flex-col">
                  <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center">
                    <h3 class="text-xs font-bold text-[#0F2B5B] uppercase tracking-wider">Dongguan Plant</h3>
                  </div>

                  <div class="bg-[#F8FAFC] border border-[#0F2B5B]/15 rounded-xs overflow-hidden h-[220px] flex flex-col justify-between shadow-2xs">
                    <div class="h-16 bg-[#0F2B5B] relative overflow-hidden flex items-center justify-center shrink-0">
                      <div class="absolute inset-0 bg-cover bg-center opacity-85" style="background-image: url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=80');"></div>
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                      <span class="relative z-10 text-[9px] font-mono text-white bg-[#EA580C] px-2 py-0.5 rounded-xs uppercase tracking-widest font-bold">HAITIAN 90T-1200T</span>
                    </div>
                    
                    <div class="p-2.5 flex flex-col justify-between flex-1">
                      <div class="space-y-1 text-[10px] font-mono text-slate-600">
                        <div class="flex items-center justify-between border-b border-slate-200/60 pb-0.5">
                          <span>Fleet Scale:</span>
                          <span class="font-bold text-[#0F2B5B]">30+ Presses (90T-1200T)</span>
                        </div>
                        <div class="flex items-center justify-between border-b border-slate-200/60 pb-0.5">
                          <span>T1 Lead Time:</span>
                          <span class="font-bold text-[#EA580C]">5 - 10 Days</span>
                        </div>
                        <div class="flex items-center justify-between">
                          <span>Plant Standard:</span>
                          <span class="font-bold text-[#0F2B5B]">ISO 9001:2015</span>
                        </div>
                      </div>
                      
                      <a 
                        href="#rfq" 
                        class="mega-cta-trigger block text-center py-1.5 bg-[#EA580C] hover:bg-[#C2410C] active:scale-[0.98] text-white font-bold text-[10px] uppercase tracking-wider transition-all rounded-xs shadow-2xs focus-visible:outline-2 focus-visible:outline-[#0F2B5B]"
                      >
                        Get 24h DFM & Quote →
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- 2. INDUSTRIES MEGA MENU -->
          {link.key === 'industries' && (
            <div 
              id="megamenu-industries" 
              class="mega-menu-panel absolute top-full left-0 right-0 w-full bg-white border-y border-slate-200 border-b-4 border-b-[#EA580C] shadow-2xl opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-200 py-6 z-[105]"
              role="region"
              aria-label="Industries Submenu"
            >
              <div class="max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-10 grid grid-cols-4 gap-7 text-left items-start">
                <div class="flex flex-col space-y-5">
                  <div>
                    <div class="border-b border-[#0F2B5B]/15 pb-1.5 mb-2.5 h-[28px] flex items-center justify-between">
                      <a href={`${t.pathPrefix}/industries/home-appliances`} class="text-xs font-bold text-[#0F2B5B] hover:text-[#EA580C] uppercase tracking-wider transition-colors flex items-center gap-1">
                        <span>Home Appliances</span>
                        <span class="text-[9px] text-[#0F2B5B]/40">→</span>
                      </a>
