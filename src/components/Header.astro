              <a href={`${t.pathPrefix}/materials/petg-pctg-tritan`} class="hover:text-white">• Tritan Copolyester</a>
            </div>
          </div>
          <a href={`${t.pathPrefix}/materials`} class="inline-block mt-2 text-[#EA580C] font-bold underline text-[11px]">
            {t.viewAllResins} →
          </a>
        </div>
      </div>

      <!-- 其他主导航项 -->
      <a href={`${t.pathPrefix}/services`} class="text-lg font-bold tracking-tight uppercase py-3.5 flex items-center justify-between hover:text-[#EA580C] transition-colors">
        {t.services}
        <span class="text-xs text-white/40">→</span>
      </a>
      <a href={`${t.pathPrefix}/industries`} class="text-lg font-bold tracking-tight uppercase py-3.5 flex items-center justify-between hover:text-[#EA580C] transition-colors">
        {t.industries}
        <span class="text-xs text-white/40">→</span>
      </a>
      <a href={`${t.pathPrefix}/knowledge-hub`} class="text-lg font-bold tracking-tight uppercase py-3.5 flex items-center justify-between hover:text-[#EA580C] transition-colors">
        {t.knowledgeHub}
        <span class="text-xs text-white/40">→</span>
      </a>
      <a href={`${t.pathPrefix}/company`} class="text-lg font-bold tracking-tight uppercase py-3.5 flex items-center justify-between hover:text-[#EA580C] transition-colors">
        {t.company}
        <span class="text-xs text-white/40">→</span>
      </a>
    </nav>

    <!-- 多语言切换 (移动端) -->
    <div class="mt-6 shrink-0">
      <p class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#EA580C] mb-2 font-bold">Region & Language</p>
      <div class="grid grid-cols-3 gap-2 bg-white/5 p-1 border border-white/10 max-w-xs rounded-xs">
        {locales.map((l) => (
          <a 
            href={translations[l].pathPrefix || "/"} 
            class={`py-1.5 text-center text-[10px] font-mono tracking-wider transition-all rounded-xs ${l === lang ? 'bg-[#EA580C] text-white font-bold' : 'text-white/70 hover:text-white'}`}
          >
            {translations[l].shortName}
          </a>
        ))}
      </div>
    </div>

    <!-- 底部转化入口 -->
    <div class="mt-auto pt-6 shrink-0">
      <a 
        id="header-cta-mobile" 
        href="#rfq" 
        class="w-full bg-[#EA580C] hover:bg-[#C2410C] py-3 text-center flex items-center justify-center active:scale-[0.98] transition-all rounded-xs shadow-md"
      >
        <span class="text-xs font-bold uppercase tracking-[0.16em] text-white">{t.cta}</span>
      </a>
    </div>
  </div>
</header>

<script>
  function initMegaHeader() {
    const openBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-close-btn');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const ctaDesktop = document.getElementById('header-cta-desktop');
    const ctaMobile = document.getElementById('header-cta-mobile');
    const megaCtas = document.querySelectorAll('.mega-cta-trigger');
    const accordionBtns = document.querySelectorAll('.mobile-accordion-btn');
    const searchInput = document.getElementById('mobile-resin-search') as HTMLInputElement | null;

    // 1. 移动端抽屉开关
    const closeMenu = () => {
      if (mobileOverlay) {
        mobileOverlay.classList.remove('opacity-100', 'pointer-events-auto');
        mobileOverlay.classList.add('opacity-0', 'pointer-events-none');
        mobileOverlay.setAttribute('aria-hidden', 'true');
      }
      if (openBtn) {
        openBtn.setAttribute('aria-expanded', 'false');
      }
      document.body.style.overflow = '';
    };

    const openMenu = () => {
      if (mobileOverlay) {
        mobileOverlay.classList.remove('opacity-0', 'pointer-events-none');
        mobileOverlay.classList.add('opacity-100', 'pointer-events-auto');
        mobileOverlay.setAttribute('aria-hidden', 'false');
      }
      if (openBtn) {
        openBtn.setAttribute('aria-expanded', 'true');
      }
      document.body.style.overflow = 'hidden';
      if ('vibrate' in navigator) {
        navigator.vibrate(10);
      }
    };

    if (openBtn) openBtn.onclick = openMenu;
    if (closeBtn) closeBtn.onclick = closeMenu;

    // 2. 移动端手风琴折叠
    accordionBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling as HTMLElement;
        const icon = btn.querySelector('.accordion-icon');
        if (content) {
          const isHidden = content.classList.contains('hidden');
          content.classList.toggle('hidden', !isHidden);
          if (icon) {
            icon.textContent = isHidden ? '−' : '+';
          }
        }
      });
    });

    // 3. 移动端搜索树脂实时过滤
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const links = mobileOverlay?.querySelectorAll('.accordion-content a');
        links?.forEach((link) => {
          const text = link.textContent?.toLowerCase() || '';
          (link as HTMLElement).style.display = text.includes(query) || !query ? 'block' : 'none';
        });
      });
    }

    // 4. 转化漏斗预填与模态框唤醒
    const handleCtaClick = (e: Event) => {
      e.preventDefault();
      const target = e.currentTarget as HTMLElement;
      const resinCode = target.getAttribute('data-resin') || '';
      
      closeMenu();

      if (typeof (window as any).NEXMOLD_OPEN_LEAD_MODAL === 'function') {
        (window as any).NEXMOLD_OPEN_LEAD_MODAL({ resin: resinCode });
      } else {
        const rfqSection = document.getElementById('rfq');
        if (rfqSection) {
          rfqSection.scrollIntoView({ behavior: 'smooth' });
          if (resinCode) {
            const resinInput = document.querySelector('input[name="resin"], select[name="resin"]') as HTMLInputElement | null;
            if (resinInput) resinInput.value = resinCode;
          }
        }
      }
    };

    if (ctaDesktop) ctaDesktop.onclick = handleCtaClick;
    if (ctaMobile) ctaMobile.onclick = handleCtaClick;
    megaCtas.forEach((cta) => {
      (cta as HTMLElement).onclick = handleCtaClick;
    });

    // 为所有具有 data-resin 属性的链接绑定预填行为
    document.querySelectorAll('[data-resin]').forEach((el) => {
      el.addEventListener('click', () => {
        const resin = el.getAttribute('data-resin');
        if (resin && typeof (window as any).NEXMOLD_SET_SELECTED_RESIN === 'function') {
          (window as any).NEXMOLD_SET_SELECTED_RESIN(resin);
        }
      });
    });

    // 5. 键盘 Escape 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });

    // 6. 滚动监听：向下滚动超过 80px 自动平滑隐藏下拉浮层防误触
    let lastScrollY = window.scrollY;
    window.addEventListener('scroll', () => {
      if (Math.abs(window.scrollY - lastScrollY) > 80) {
        document.querySelectorAll('.mega-menu-panel').forEach((panel) => {
          (panel as HTMLElement).style.pointerEvents = 'none';
          setTimeout(() => {
            (panel as HTMLElement).style.pointerEvents = '';
          }, 200);
        });
        lastScrollY = window.scrollY;
      }
    }, { passive: true });
  }

  initMegaHeader();
  document.addEventListener('astro:page-load', initMegaHeader);
</script>

<style>
  header nav a { 
    white-space: nowrap;
    hyphens: auto;
  }
  
  /* 强制实体白底与层叠阻尼 */
  .mega-menu-panel {
    background-color: #ffffff !important;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), 
                visibility 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, visibility;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-menu-panel,
    #mobile-overlay {
      transition: none !important;
    }
  }
</style>