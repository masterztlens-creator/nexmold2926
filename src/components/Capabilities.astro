      },
      {
        tonnage: "1000T – 1200T",
        title: "HEAVY APPLIANCE & CHASSIS",
        tag: "MAX TONNAGE",
        image: "/images/fleet/fleet-1200t.webp",
        alt: "1200T maximum clamping force heavy plastic injection molding machine for large structural chassis",
        specs: [
