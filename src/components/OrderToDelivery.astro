---
/**
 * CapabilitiesNav.astro - 首页第三屏：Order-to-Delivery Workflow (轻量高转化精简版)
 * 1. 结构：7 大核心卡片 (01 Prototype -> 07 Packaging)
 * 2. 资源：路径已精准对齐本地 public/images/production-flow/ 下的实际文件名
 * 3. 视觉：咬合式中轴指示箭头 + NEXMOLD 品牌三色 (#0F2B5B / #EA580C / #FFFFFF)
 * 4. 引导：带“查看 10 步履约细化流程”的 /process 内页跳转入口
 */

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

const i18n: Record<string, any> = {
  en: {
    badge: "TURNKEY MANUFACTURING PROCESS",
    title: "Order-to-Delivery Workflow",
    main_subtitle: "IATF 16949 Certified Custom Plastic Injection Molding Services",
    sub_desc: "From 24-hour DFM engineering analysis to 1000T high-precision mass production, we provide multi-material 2K overmolding, CMM-inspected sub-assemblies, and export crating under one roof.",
    cta_primary: "UPLOAD 3D CAD FOR FREE DFM & INSTANT QUOTE",
    contact_note: "Accepted Formats: STEP, IGES, X_T, DWG · Guaranteed Non-Disclosure Agreement (NDA)",
    swipe_hint: "← Swipe to explore 7-step process →",
    view_full_process: "EXPLORE FULL 10-STEP TIMELINE & DELIVERABLE SPECS →"
  },
  de: {
    badge: "SCHLÜSSELFERTIGER FERTIGUNGSPROZESS",
    title: "Auftrags- bis Lieferablauf",
    main_subtitle: "IATF 16949 Zertifizierte Kundenspezifische Spritzguss-Dienstleistungen",
    sub_desc: "Von der 24-Stunden-DFM-Analyse bis zur 1000T-Serienfertigung bieten wir Mehrkomponenten-Spritzguss, CMM-geprüfte Baugruppen und Exportverpackung.",
    cta_primary: "3D-CAD HOCHLADEN UND KOSTENLOSE DFM-ANALYSE ERHALTEN",
    contact_note: "Dateiformate: STEP, IGES, X_T · Garantiertes Geheimhaltungsabkommen (NDA)",
    swipe_hint: "← Wischen zum Erkunden →",
    view_full_process: "VOLLSTÄNDIGEN 10-SCHRITTE-PROZESS ANSEHEN →"
  },
  fr: {
    badge: "PROCESSUS DE FABRICATION CLÉ EN MAIN",
    title: "Flux de la Commande à la Livraison",
    main_subtitle: "Services de Moulage par Injection Plastique Sur Mesure Certifiés IATF 16949",
    sub_desc: "De l'analyse DFM en 24h à la production en série 1000T, nous fournissons le surmoulage 2K, l'assemblage inspecté par MMT et l'emballage d'exportation.",
    cta_primary: "TÉLÉCHARGER LE CAO 3D POUR DFM ET DEVIS GRATUIT",
    contact_note: "Formats acceptés : STEP, IGES, X_T · Accord de Confidentialité (NDA) Garanti",
    swipe_hint: "← Balayez pour explorer →",
    view_full_process: "VOIR LE PROCESSUS DÉTAILLÉ EN 10 ÉTAPES →"
  }
};

const t = i18n[lang] || i18n.en;

// 图像路径根据截图文件名精准对齐
const productionSteps = [
  {
    id: "prototype",
    code: "01",
    name: "Prototype",
    desc: "Rapid DFM & SLA/SLS Verification",
    seoLabel: "3D Printed Prototype Verification & DFM Review Service",
    image: "/images/production-flow/prototype.webp",
    hasNext: true
  },
  {
    id: "tooling",
    code: "02",
    name: "Tooling",
    desc: "P20 / S136 Steel Injection Molds",
    seoLabel: "Precision Steel Mold Tooling Fabrication for Injection Molding",
    image: "/images/production-flow/tooling.webp",
    hasNext: true
  },
  {
    id: "injection-molding",
    code: "03",
    name: "Injection Molding",
    desc: "30T – 1000T High-Volume Molding",
    seoLabel: "30T to 1000T High Volume Precision Plastic Injection Molding",
    image: "/images/production-flow/injection.webp",
    hasNext: true
  },
  {
    id: "insert-overmolding",
    code: "04",
    name: "Insert / Overmolding",
    desc: "2K Overmolding & Metal Inserts",
    seoLabel: "2K Multi Material Overmolding and Threaded Brass Insert Molding",
    image: "/images/production-flow/overmolding.webp",
    hasNext: true
  },
  {
    id: "secondary-operations",
    code: "05",
    name: "Secondary Operations",
    desc: "SPI Finish, Silk Screen & Printing",
    seoLabel: "SPI Surface Finishing Texture Pad Printing and Painting Services",
    image: "/images/production-flow/secondary.webp",
    hasNext: true
  },
  {
    id: "assembly",
    code: "06",
    name: "Assembly",
    desc: "Sub-Assembly & 100% CMM Audit",
    seoLabel: "Full Box Build Assembly and CMM Dimensional Inspection Audit",
    image: "/images/production-flow/assembly.webp",
    hasNext: true
  },
  {
    id: "packaging",
    code: "07",
    name: "Packaging",
    desc: "ESD Cleanroom & Custom Crating",
    seoLabel: "ESD Anti Static Cleanroom Packaging and Export Wooden Crating",
    image: "/images/production-flow/packaging.webp",
    hasNext: false
  }
];
---

<!-- 🏭 全局容器背景：纯白背景 (#FFFFFF) -->
<section class="bg-white py-14 sm:py-24 relative select-none border-b border-[#0F2B5B]/10 overflow-hidden" id="capabilities">
  
  <div class="max-w-[1650px] mx-auto px-4 sm:px-[clamp(1.5rem,4vw,3.5rem)] relative z-10">
    
    <!-- 💥 1. 居中标题区 -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 bg-[#0F2B5B]/5 border border-[#0F2B5B]/15 px-3.5 py-1 rounded-sm backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-[#EA580C] animate-ping"></span>
        <span class="font-mono text-[10px] font-black uppercase text-[#0F2B5B] tracking-widest">
          {t.badge}
        </span>
      </div>

      <h2 class="text-3xl sm:text-6xl font-[1000] text-[#0F2B5B] tracking-tight font-sans italic uppercase">
        {t.title}
      </h2>

      <p class="text-xs sm:text-base font-black text-[#0F2B5B] font-sans tracking-tight uppercase">
        {t.main_subtitle}
      </p>

      <p class="text-xs sm:text-sm text-[#0F2B5B]/75 font-sans font-medium max-w-2xl mx-auto leading-relaxed hidden sm:block">
        {t.sub_desc}
      </p>
    </div>

    <!-- 💥 2. 移动端手势提示 -->
    <div class="block lg:hidden text-center mb-4">
      <span class="font-mono text-[10px] font-extrabold text-[#EA580C] uppercase tracking-wider bg-[#EA580C]/10 px-3 py-1 rounded-full border border-[#EA580C]/20 inline-block shadow-2xs">
        {t.swipe_hint}
      </span>
    </div>

    <!-- 💥 3. 7 大核心视觉卡片 -->
    <div class="flex lg:grid lg:grid-cols-7 gap-3 lg:gap-2 xl:gap-4 overflow-x-auto lg:overflow-x-visible snap-x snap-mandatory no-scrollbar pb-6 lg:pb-0 max-w-[1600px] mx-auto -mx-4 px-4 lg:mx-auto lg:px-0 transform-gpu touch-pan-x mb-8 sm:mb-12">
      {productionSteps.map((step) => (
        <a
          href="#rfq"
          aria-label={step.seoLabel}
          data-process-step={step.id}
          class="group flex flex-col items-center cursor-pointer relative shrink-0 w-[80vw] sm:w-[42vw] md:w-[28vw] lg:w-auto snap-center"
        >
          <!-- 卡片主体 (#0F2B5B) -->
          <div class="w-full bg-[#0F2B5B] group-hover:bg-[#133570] rounded-[24px] p-2.5 flex flex-col justify-between shadow-xl hover:shadow-2xl border border-[#0F2B5B]/10 group-hover:border-[#EA580C] transition-all duration-300 min-h-[280px] sm:min-h-[300px] relative overflow-hidden">
            
            <!-- 顶部 Tag -->
            <div class="flex items-center justify-between px-1 mb-2">
              <span class="font-mono text-[10px] font-black text-[#EA580C] bg-[#EA580C]/10 border border-[#EA580C]/30 px-2 py-0.5 rounded-sm tracking-wider">
                STEP {step.code}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#EA580C] group-hover:animate-ping"></span>
            </div>

            <!-- 图片视口 -->
            <div class="w-full h-36 sm:h-38 rounded-[18px] bg-[#E2E8F0] overflow-hidden p-1.5 relative flex items-center justify-center">
              <img
                src={step.image}
                alt={step.seoLabel}
                class="w-full h-full object-cover rounded-[14px] group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                onerror="this.style.display='none';"
              />
            </div>

            <!-- 卡片标题 -->
            <div class="py-3 text-center px-1">
              <h3 class="font-sans font-black text-base lg:text-xs xl:text-sm uppercase text-white tracking-tight leading-tight group-hover:text-[#EA580C] transition-colors">
                {step.name}
              </h3>
            </div>

            <!-- Hover 亮橙边框 -->
            <div class="absolute inset-0 rounded-[24px] border-2 border-transparent group-hover:border-[#EA580C] transition-colors pointer-events-none"></div>
          </div>

          <!-- 桌面端咬合连接指示箭头 -->
          {step.hasNext && (
            <div class="hidden xl:flex absolute top-[40%] -right-3.5 -translate-y-1/2 z-30 pointer-events-none items-center justify-center">
              <div class="bg-[#EA580C] text-white p-1 rounded-full shadow-lg border-2 border-white group-hover:scale-125 group-hover:translate-x-1 transition-all duration-300">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/>
                </svg>
              </div>
            </div>
          )}

          <!-- 卡片下方描述文案 -->
          <div class="mt-3 text-center px-1">
            <p class="font-sans text-xs sm:text-sm font-bold text-[#0F2B5B] leading-tight">
              {step.desc}
            </p>
          </div>
        </a>
      ))}
      <div class="shrink-0 w-2 lg:hidden pointer-events-none"></div>
    </div>

    <!-- 💥 4. 内页跳转入口 -->
    <div class="text-center mb-10">
      <a 
        href="/process" 
        class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-black text-[#0F2B5B] hover:text-[#EA580C] bg-[#0F2B5B]/5 hover:bg-[#EA580C]/10 border border-[#0F2B5B]/15 hover:border-[#EA580C]/30 px-5 py-2.5 rounded-full transition-all duration-300 group"
      >
        <span>{t.view_full_process}</span>
      </a>
    </div>

    <!-- 💥 5. 商业转换 CTA 区域 -->
    <div class="mt-8 text-center space-y-3 px-2">
      <a
        href="#rfq"
        aria-label="Upload 3D CAD Files STEP IGES for Free DFM Analysis and Precision Injection Molding Quote"
        class="inline-flex items-center justify-center gap-2 sm:gap-3 bg-[#EA580C] hover:bg-[#d94e05] text-white font-sans font-black text-[10px] xs:text-xs sm:text-base px-5 sm:px-10 py-3.5 sm:py-4 rounded-full shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105 uppercase tracking-normal sm:tracking-wider border-2 border-white/20 max-w-full whitespace-nowrap overflow-hidden text-ellipsis"
      >
        <span class="w-2 h-2 rounded-full bg-white animate-ping shrink-0"></span>
        <span class="truncate">{t.cta_primary}</span>
        <span class="font-mono font-bold text-sm sm:text-lg shrink-0">→</span>
      </a>

      <p class="font-sans text-[10px] sm:text-sm text-[#0F2B5B]/80 font-bold tracking-tight">
        🔒 {t.contact_note}
      </p>
    </div>

  </div>
</section>

<!-- 隐藏移动端滚动条 CSS -->
<style is:global>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

