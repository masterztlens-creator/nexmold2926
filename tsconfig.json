{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "/src/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.astro",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/v8/**",
    "src/evidence/**",
    "src/projection/**",
    "src/publication/**",
    "src/regional/**",
    "src/release/**"
  ]
}